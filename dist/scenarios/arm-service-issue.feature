# language: ru
# encoding: utf-8
# АРМ Выпуск услуг: отражение выпуска услуг в регл. учете (создаёт
# Документ.ПроизводствоБезЗаказа - «Распоряжение» для АРМ Выработка).
# Шаблон без документа: плейсхолдеры {{user}}, {{date}} не используются;
# период - {{period.start}}/{{period.end}} (месяц рабочей даты сеанса).
# ЦЕПОЧКА (s008 ЗАДАЧА 4): заправки (arm-fuel-receipt, батч СоколовМИ)
# -> расход топлива (arm-fuel-expense) -> ВЫПУСК УСУГ (этот шаблон)
# -> производство продукции растениеводства (arm-plant-production)
# -> выработка (arm-payroll, ПОСЛЕДНИЙ). Порядок задаёт ранжирование
# АРМ-шаблонов в СгенерироватьФичи (ПорядокЦепочкиАРМов).
# ВАЖНО (s2-T8, правка #4): без настройки РС
# АпкПараметрыОтраженияЗатратРастениеводства для вида работы
# «Загрузка удобрений» отражение МОЛЧА не выполняется
# (ОшибкиНастройкиПодразделения -> Возврат). Настройка копируется
# идемпотентным серверным блоком из вида работы-донора «Загрузка
# посадочного материала (зерновые)» (restore её стирает).
# Структура шагов скопирована с зелёного probe tmp/t8/probe-arm-vyusl.feature.
Функционал: АРМ выпуск услуг отражение

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий

Сценарий: Отражение выпуска услуг
	Когда я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере
	"""bsl
		ВидРаботыДонор = Справочники.ВидыРаботСотрудников.НайтиПоНаименованию("Загрузка посадочного материала (зерновые)", Истина);
		ВидРаботыЦель  = Справочники.ВидыРаботСотрудников.НайтиПоНаименованию("Загрузка удобрений", Истина);
		Если Не ВидРаботыЦель.Пустая() И Не ВидРаботыДонор.Пустая() Тогда
			ЗапросНаличие = Новый Запрос;
			ЗапросНаличие.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК ЕстьНастройка
				|ИЗ РегистрСведений.АпкПараметрыОтраженияЗатратРастениеводства КАК Параметры
				|ГДЕ Параметры.ОбъектНастройки = &Цель";
			ЗапросНаличие.УстановитьПараметр("Цель", ВидРаботыЦель);
			Если ЗапросНаличие.Выполнить().Выбрать().Следующий() Тогда
				// настройка уже есть (идемпотентность)
			Иначе
				ЗапросДонор = Новый Запрос;
				ЗапросДонор.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 *
					|ИЗ РегистрСведений.АпкПараметрыОтраженияЗатратРастениеводства КАК Параметры
					|ГДЕ Параметры.ОбъектНастройки = &Донор
					|УПОРЯДОЧИТЬ ПО Параметры.Период УБЫВ";
				ЗапросДонор.УстановитьПараметр("Донор", ВидРаботыДонор);
				ВыборкаДонора = ЗапросДонор.Выполнить().Выбрать();
				Если ВыборкаДонора.Следующий() Тогда
					Набор = РегистрыСведений.АпкПараметрыОтраженияЗатратРастениеводства.СоздатьНаборЗаписей();
					Набор.Отбор.Период.Установить(ВыборкаДонора.Период);
					Набор.Отбор.ОбъектНастройки.Установить(ВидРаботыЦель);
					Набор.Отбор.Организация.Установить(ВыборкаДонора.Организация);
					Запись = Набор.Добавить();
					ЗаполнитьЗначенияСвойств(Запись, ВыборкаДонора);
					Запись.ОбъектНастройки = ВидРаботыЦель;
					Набор.Записать(Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	"""
	Дано Я открываю навигационную ссылку "e1cib/app/Обработка.АпкАРМПоОтражениюВыпускаУслуг"
	Тогда открылось окно "Рабочее место по отражению выпуска услуг*"
	# Пауза перед кликом Период + медленный каденс диалога (паттерн
	# fuel-receipt): быстрый каденс флейкит (E2E#3/#4).
	И Пауза 3
	И я нажимаю кнопку выбора у поля с именем "Период"
	Тогда открылось окно "Выберите период"
	И Пауза 5
	И я эмулирую ввод текста "{{period.start}}"
	И Пауза 2
	И я нажимаю сочетание клавиш "TAB"
	И Пауза 2
	И я эмулирую ввод текста "{{period.end}}"
	И Пауза 2
	И я нажимаю сочетание клавиш "TAB"
	И Пауза 2
	И я нажимаю сочетание клавиш "TAB"
	И Пауза 2
	И я нажимаю сочетание клавиш "ENTER"
	И Пауза 8
	И в таблице "СписокСостояния" количество строк "больше" 0
	И я нажимаю на кнопку с именем "ВыполнитьОтражение"
	И Пауза 20
	И я закрываю все окна клиентского приложения
