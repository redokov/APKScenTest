# language: ru
# encoding: utf-8
# АРМ Выработка сотрудников: отражение выработки в регл. учете
# (создаёт Документ.ВыработкаСотрудников; повторный прогон удаляет и
# пересоздаёт документ через ДокументыКУдалению).
# Шаблон без документа: доступны плейсхолдеры {{user}}, {{date}}
# и периода {{period.start}}/{{period.end}} (месяц рабочей даты; s006 01.11.2026 — фикс жёсткого октября);
# здесь они не используются (АРМ работает с периодом, а не с одним документом).
# ВАЖНО (form discovery): фильтр организаций формы по умолчанию содержит
# «Колос ООО», из-за чего Дерево пустое. ОБЯЗАТЕЛЬНО сбрасывать фильтр:
# кнопка выбора у поля "ПредставлениеОрганизаций" -> окно "Организации*"
# -> "ФормаОтметитьВсе" -> "ФормаВыбратьОрганизации" (см. зелёный probe:
# tmp/t9/arm-vyusotr-final/final-vyusotr.feature). Пауза 40 после выбора -
# построение Дерева.
# ВАЖНО (idempotency, s2-T9): после зелёного отражения всего октября
# Дерево пусто при флаге "ВыводитьТолькоТребующееОтражения" (default для
# свежего пользователя). Шаг "снимаю флаг" детерминирован (не тогглер):
# для свежих зондов и сохранённых настроек даёт Ложь -> Дерево > 0,
# ВыполнитьОтражение = delete+recreate (безобидно).
# ВАЖНО (период, s2-T9/T9.2): у свежего пользователя Период формы -
# не октябрь (сохранённые настройки есть только у админа), Дерево
# пусто. Границы месяца проставляем явно, как в arm-fuel-receipt
# (probe-артефакты s2 = октябрь 2026; при смене месяца фикстур -
# актуализировать даты в шагах).
# Структура шагов скопирована с зелёного probe (см. выше), структура
# проверена rs=0 в s2-T8/T9.
# NB (s009): ПБЗ периода от АРМ Выпуск услуг с ПУСТОЙ ТЧ ВыходныеИзделия
# -> нет ПартииПроизводства -> leaf дерева без АпкПартияПроизводства ->
# ЗапуститьОтражение молча выходит (root-cause
# tmp/t9/arm-vyusotr-final, воспроизведено на ноябре: ПБЗ НВЦБ-000003
# «Загрузка удобрений»). Идемпотентный серверный блок до открытия АРМ:
# добавить в каждый такой ПБЗ строку ВыходныеИзделия (Номенклатура
# «Услуги машино-тракторного парка», Кол-во 1, НомерГруппыЗатрат 1) +
# элемент ПартииПроизводства (Документ=ПБЗ, Код="1") - перенос правки
# scripts/t9_upd_pbz_vyrabotka.py в шаблон.
Функционал: АРМ выработка сотрудников отражение

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий

Сценарий: Отражение выработки сотрудников
	Когда я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере
	"""bsl
		НачПериода = НачалоМесяца(ТекущаяДатаСеанса());
		КонПериода = КонецМесяца(ТекущаяДатаСеанса());
		ЗапросПБЗ = Новый Запрос;
		ЗапросПБЗ.Текст = "ВЫБРАТЬ Док.Ссылка КАК Реф
			|ИЗ Документ.ПроизводствоБезЗаказа КАК Док
			|ГДЕ Док.Дата МЕЖДУ &Нач И &Кон И НЕ Док.ПометкаУдаления";
		ЗапросПБЗ.УстановитьПараметр("Нач", НачПериода);
		ЗапросПБЗ.УстановитьПараметр("Кон", КонПериода);
		ВыборкаПБЗ = ЗапросПБЗ.Выполнить().Выбрать();
		НоменклатураУслуг = Справочники.Номенклатура.НайтиПоНаименованию("Услуги машино-тракторного парка", Истина);
		Пока ВыборкаПБЗ.Следующий() Цикл
			ПБЗ = ВыборкаПБЗ.Реф;
			Если ПБЗ.ВыходныеИзделия.Количество() = 0 Тогда
				ДокОбъект = ПБЗ.ПолучитьОбъект();
				СтрокаВИ = ДокОбъект.ВыходныеИзделия.Добавить();
				СтрокаВИ.Номенклатура = НоменклатураУслуг;
				СтрокаВИ.Количество = 1;
				СтрокаВИ.НомерГруппыЗатрат = 1;
				Если ДокОбъект.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
			КонецЕсли;
			// NB (s009): проверка партии - СУЩЕСТВОВАНИЕ строки
			// (ПЕРВЫЕ 1), а не КОЛИЧЕСТВО(*): агрегат всегда возвращает
			// одну строку (Следующий() = Истина даже при нуле), а партия
			// нужна и для ПБЗ, у которого VI уже добавлена ранее
			// (идемпотентность не должна пропускать создание партии).
			ЗапросПартии = Новый Запрос;
			ЗапросПартии.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Партия.Ссылка КАК Реф
				|ИЗ Справочник.ПартииПроизводства КАК Партия
				|ГДЕ Партия.Документ = &Док И НЕ Партия.ПометкаУдаления";
			ЗапросПартии.УстановитьПараметр("Док", ПБЗ);
			Если ЗапросПартии.Выполнить().Выбрать().Следующий() Тогда
				// партия уже есть (идемпотентность)
			Иначе
				ПартияПроизв = Справочники.ПартииПроизводства.СоздатьЭлемент();
				ПартияПроизв.Код = "1";
				ПартияПроизв.Наименование = "Услуги МТП (группа затрат 1)";
				ПартияПроизв.Документ = ПБЗ;
				ПартияПроизв.Номенклатура = НоменклатураУслуг;
				ПартияПроизв.Записать();
			КонецЕсли;
		КонецЦикла;
	"""
	Дано Я открываю навигационную ссылку "e1cib/app/Обработка.АпкАРМПоОтражениюВыработкиСотрудников"
	Тогда открылось окно "Рабочее место по отражению выработки сотрудников*"
	И Пауза 5
	И я нажимаю кнопку выбора у поля с именем "Период"
	Тогда открылось окно "Выберите период"
	И Пауза 5
	И я эмулирую ввод текста "{{period.start}}"
	И Пауза 2
	И я нажимаю сочетание клавиш "TAB"
	И Пауза 2
	И я эмулирую ввод текста "{{period.end}}"
	И Пауза 2
	И я нажимаю сочетание клавиш "TAB"
	И Пауза 2
	И я нажимаю сочетание клавиш "TAB"
	И Пауза 2
	И я нажимаю сочетание клавиш "ENTER"
	И Пауза 8
	И я снимаю флаг с именем "ВыводитьТолькоТребующееОтражения"
	И Пауза 5
	И я нажимаю кнопку выбора у поля с именем "ПредставлениеОрганизаций"
	И Пауза 5
	Тогда открылось окно "Организации*"
	И я нажимаю на кнопку с именем "ФормаОтметитьВсе"
	И я нажимаю на кнопку с именем "ФормаВыбратьОрганизации"
	И Пауза 40
	И в таблице "Дерево" количество строк "больше" 0
	И я нажимаю на кнопку с именем "ВыполнитьОтражение"
	И Пауза 90
	И я закрываю все окна клиентского приложения
