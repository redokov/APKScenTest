// T8 Stage-A runner: НачатьПрогон -> Сканировать -> СформироватьФикстуры
// -> СгенерироватьФичи. Задание: tmp/t8/runner_task.json
// {target, settings, runsDir}. Результат: tmp/t8/runner_result.json.
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Отказ = Истина;

	Отчёт = Новый Структура;
	Отчёт.Вставить("step", "start");
	Отчёт.Вставить("errors", Новый Массив);

	Задание = ПрочитатьЗадание();
	Если Задание = Неопределено Тогда
		ДобавитьОшибку(Отчёт, "task: не удалось прочитать runner_task.json");
		Финал(Отчёт);
		Возврат;
	КонецЕсли;

	Отчёт.Вставить("target", Задание.target);
	Шаг(Отчёт, "task-read");

	Если ПустаяСтрока(Задание.target) Или ПустаяСтрока(Задание.settings) Тогда
		ДобавитьОшибку(Отчёт, "task: пустой target/settings");
		Финал(Отчёт);
		Возврат;
	КонецЕсли;

	Доп = Новый Структура("Задание, Отчёт", Задание, Отчёт);
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ФайлПомещён", ЭтаФорма, Доп), ,
		Задание.target, Ложь, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ФайлПомещён(ПомещенныйФайл, АдресВоВременномХранилище, ПомещенноеИмяФайла, ДополнительныеПараметры) Экспорт

	Задание = ДополнительныеПараметры.Задание;
	Отчёт = ДополнительныеПараметры.Отчёт;
	Шаг(Отчёт, "file-placed");

	ИмяОбработки = "";
	Попытка
		ИмяОбработки = ПодключитьНаСервере(АдресВоВременномХранилище);
		Отчёт.Вставить("connected", ИмяОбработки);
		Шаг(Отчёт, "connected");
	Исключение
		ДобавитьОшибку(Отчёт, "connect: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Финал(Отчёт);
		Возврат;
	КонецПопытки;

	ВыполнитьЭтапы(Задание, Отчёт, ИмяОбработки);
	Финал(Отчёт);

КонецПроцедуры

// Полный конвейер генерации: новый каталог прогона -> скан -> фикстуры -> фичи.
&НаКлиенте
Процедура ВыполнитьЭтапы(Задание, Отчёт, ИмяОбработки)

	КаталогПрогона = "";
	Попытка
		КаталогПрогона = Сервер_НачатьПрогон(ИмяОбработки, Задание.settings, Задание.runsDir);
		Отчёт.Вставить("runDir", КаталогПрогона);
		Шаг(Отчёт, "run-created");
	Исключение
		ДобавитьОшибку(Отчёт, "НачатьПрогон: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Попытка
		СводкаСкана = Сервер_Сканировать(ИмяОбработки, КаталогПрогона, Задание.filters);
		Отчёт.Вставить("scanSummary", СводкаСкана);
		Шаг(Отчёт, "scan-done");
	Исключение
		ДобавитьОшибку(Отчёт, "Сканировать: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Попытка
		СводкаФикстур = Сервер_СформироватьФикстуры(ИмяОбработки, КаталогПрогона);
		Отчёт.Вставить("fixturesSummary", СводкаФикстур);
		Шаг(Отчёт, "fixtures-done");
	Исключение
		ДобавитьОшибку(Отчёт, "СформироватьФикстуры: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Попытка
		СводкаФич = Сервер_СгенерироватьФичи(ИмяОбработки, КаталогПрогона);
		Отчёт.Вставить("featuresSummary", СводкаФич);
		Шаг(Отчёт, "features-done");
	Исключение
		ДобавитьОшибку(Отчёт, "СгенерироватьФичи: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция Сервер_НачатьПрогон(ИмяОбработки, ПутьНастроек, ПутьКаталогаПрогонов)

	ОбъектОбр = ВнешниеОбработки.Создать(ИмяОбработки);
	Возврат ОбъектОбр.НачатьПрогон(ПутьНастроек, ПутьКаталогаПрогонов);

КонецФункции

&НаСервере
Функция Сервер_Сканировать(ИмяОбработки, КаталогПрогона, ПутьФильтров)

	ОбъектОбр = ВнешниеОбработки.Создать(ИмяОбработки);
	Возврат ОбъектОбр.Сканировать(КаталогПрогона, ПутьФильтров);

КонецФункции

&НаСервере
Функция Сервер_СформироватьФикстуры(ИмяОбработки, КаталогПрогона)

	ОбъектОбр = ВнешниеОбработки.Создать(ИмяОбработки);
	Возврат ОбъектОбр.СформироватьФикстуры(КаталогПрогона);

КонецФункции

&НаСервере
Функция Сервер_СгенерироватьФичи(ИмяОбработки, КаталогПрогона)

	ОбъектОбр = ВнешниеОбработки.Создать(ИмяОбработки);
	Возврат ОбъектОбр.СгенерироватьФичи(КаталогПрогона);

КонецФункции

&НаСервереБезКонтекста
Функция ПодключитьНаСервере(Адрес)

	Возврат ВнешниеОбработки.Подключить(Адрес, , Ложь);

КонецФункции

&НаКлиенте
Функция ПрочитатьЗадание()

	Задание = Неопределено;
	Попытка
		Чтение = Новый ЧтениеJSON;
		// BSLLS:UsingHardcodePath-off
		Чтение.ОткрытьФайл("C:/MyProjects/APKScenTest/tmp/t8/runner_task.json");
		Задание = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		Задание = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Задание) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Поля = Новый Массив;
	Поля.Добавить("target");
	Поля.Добавить("settings");
	Поля.Добавить("runsDir");
	Поля.Добавить("filters");
	Для каждого Поле Из Поля Цикл
		Если Задание.Свойство(Поле) Тогда
			Задание.Вставить(Поле, СокрЛП(Задание[Поле]));
		Иначе
			Задание.Вставить(Поле, "");
		КонецЕсли;
	КонецЦикла;
	Возврат Задание;

КонецФункции

&НаКлиенте
Процедура Шаг(Отчёт, ИмяШага)

	Отчёт.Вставить("step", ИмяШага);
	ЗаписатьАртефакт(Отчёт);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОшибку(Отчёт, Текст)

	Отчёт.errors.Добавить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура Финал(Отчёт)

	Отчёт.Вставить("step", "done");
	Отчёт.Вставить("errorsCount", Отчёт.errors.Количество());
	ЗаписатьАртефакт(Отчёт);
	Попытка
		Закрыть();
	Исключение
		Отчёт.Вставить("closed", Ложь);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьАртефакт(Отчёт)

	Попытка
		Запись = Новый ЗаписьJSON;
		// BSLLS:UsingHardcodePath-off
		Запись.ОткрытьФайл("C:/MyProjects/APKScenTest/tmp/t8/runner_result.json");
		ЗаписатьJSON(Запись, Отчёт);
		Запись.Закрыть();
	Исключение
		Запись = Неопределено;
	КонецПопытки;

КонецПроцедуры
