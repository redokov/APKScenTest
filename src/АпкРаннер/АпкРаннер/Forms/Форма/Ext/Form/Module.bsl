&НаСервере
Функция Сервер_ТаблицаРезультатов(Сценарии, БатчиСводно, Базовые)

	// Колонки реквизита Результаты типизированы в Form.xml; ЗначениеВРеквизитФормы
	// на клиенте скопирует строки по совпадению имён колонок.
	// ТаблицаЗначений создаётся только на сервере (тонкий клиент не умеет).
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Сценарий");
	ТЗ.Колонки.Добавить("Пользователь");
	ТЗ.Колонки.Добавить("Статус");
	ТЗ.Колонки.Добавить("VsBaseline");
	ТЗ.Колонки.Добавить("Сек");
	ТЗ.Колонки.Добавить("Негативный");

	КартаБазовой = КартаBaselineСрв(Базовые);
	КлючиТекущие = Новый Массив;

	Для Каждого Строк Из Сценарии Цикл
		Сценарий = ЗначениеИзСоответствияСрв(Строк, "scenario");
		Пользователь = ЗначениеИзСоответствияСрв(Строк, "user");
		Статус = ЗначениеИзСоответствияСрв(Строк, "status");
		Ключ = Сценарий + "|" + Пользователь;
		КлючиТекущие.Добавить(Ключ);

		Класс = "=";
		Если КартаБазовой = Неопределено Тогда
			Класс = "n/a";
		ИначеЕсли Не КартаБазовой.Получить(Ключ) = Неопределено Тогда
			Класс = "NEW";
		Иначе
			БазовыйСтатус = КартаБазовой.Получить(Ключ);
			Если БазовыйСтатус = Статус Тогда
				Класс = "=";
			ИначеЕсли ЭтоПлохойСтатусСрв(БазовыйСтатус) И Статус = "passed" Тогда
				Класс = "IMPROVED";
			ИначеЕсли БазовыйСтатус = "passed" И ЭтоПлохойСтатусСрв(Статус) Тогда
				Класс = "REGRESSION";
			Иначе
				Класс = "=";
			КонецЕсли;
		КонецЕсли;

		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.Сценарий = Сценарий;
		НоваяСтрока.Пользователь = Пользователь;
		НоваяСтрока.Статус = Статус;
		НоваяСтрока.VsBaseline = Класс;
		НоваяСтрока.Сек = Окр(Число(ЗначениеИзСоответствияСрв(Строк, "durationMs")) / 1000, 1);
		НоваяСтрока.Негативный = НегативныйПользовательСрв(Пользователь, БатчиСводно);
	КонецЦикла;

	// MISSING: ключи базовой сетки без текущего результата.
	Если КартаБазовой <> Неопределено Тогда
		Для Каждого Пара Из КартаБазовой Цикл
			Если КлючиТекущие.Найти(Пара.Ключ) = Неопределено Тогда
				НоваяСтрока = ТЗ.Добавить();
				РазделитьКлючBaselineСрв(Пара.Ключ, Сценарий, Пользователь);
				НоваяСтрока.Сценарий = Сценарий;
				НоваяСтрока.Пользователь = Пользователь;
				НоваяСтрока.Статус = "";
				НоваяСтрока.VsBaseline = "MISSING";
				НоваяСтрока.Сек = 0;
				НоваяСтрока.Негативный = НегативныйПользовательСрв(Пользователь, БатчиСводно);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат ТЗ;

КонецФункции

