&НаКлиенте
Процедура ПриЗакрытии()

	Если ПрогонАктивен Тогда
		// Грязное закрытие формы: убить процесс батча и восстановить
		// пароль по активному снимку (server-call в ПриЗакрытии допустим).
		ПрерватьФлаг = Истина;
		Попытка
			УбитьПроцессБатча();
		Исключение
			СтатусПрогона = НСтр("ru = 'Закрытие: процесс батча уже завершён.'");
		КонецПопытки;
		Если СнимокТекущий <> Неопределено Тогда
			Попытка
				Сервер_ВосстановитьПароль(ИмяПодключенной, ПользовательСнимка, СнимокТекущий);
			Исключение
				Сообщить(НСтр("ru = 'ВНИМАНИЕ: пароль не восстановлен при закрытии формы!'"));
			КонецПопытки;
		КонецЕсли;
		Попытка
			УбратьОсиротевшихTestClient(Шелл, БатчТекущий.Порт);
		Исключение
			СтатусПрогона = НСтр("ru = 'Закрытие: зачистка TestClient не удалась.'");
		КонецПопытки;
		ОтключитьОбработчикОжидания("ТикПрогона");
		ПрогонАктивен = Ложь;
	КонецЕсли;

