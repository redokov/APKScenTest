&НаСервере
Функция КартаBaselineСрв(Базовые)

	Если ТипЗнч(Базовые) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сценарии = ЗначениеИзСоответствияСрв(Базовые, "scenarios");
	Если ТипЗнч(Сценарии) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Карта = Новый Соответствие;
	Для Каждого Строк Из Сценарии Цикл
		Карта.Вставить(ЗначениеИзСоответствияСрв(Строк, "scenario") + "|"
			+ ЗначениеИзСоответствияСрв(Строк, "user"),
			ЗначениеИзСоответствияСрв(Строк, "status"));
	КонецЦикла;
	Возврат Карта;

КонецФункции

&НаСервере
Процедура РазделитьКлючBaselineСрв(Ключ, Сценарий, Пользователь)

	Позиция = Найти(Ключ, "|");
	Если Позиция > 0 Тогда
		Сценарий = Лев(Ключ, Позиция - 1);
		Пользователь = Сред(Ключ, Позиция + 1);
	Иначе
		Сценарий = Ключ;
		Пользователь = "";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НегативныйПользовательСрв(Пользователь, БатчиСводно)

	Для Каждого Батч Из БатчиСводно Цикл
		Если ЗначениеИзСоответствияСрв(Батч, "user") = Пользователь Тогда
			Возврат ЗначениеИзСоответствияСрв(Батч, "negative") = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Серверная копия getter'а для JSON-структур (клиентская - ниже по коду).
&НаСервере
Функция ЗначениеИзСоответствияСрв(ОбъектДанные, ИмяСвойства)

	Если ОбъектДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(ОбъектДанные) = Тип("Соответствие") Тогда
		Значение = ОбъектДанные[ИмяСвойства];
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(ОбъектДанные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если ОбъектДанные.Свойство(ИмяСвойства, Значение) Тогда
			Если Значение = Неопределено Тогда
				Возврат "";
			КонецЕсли;
			Возврат Значение;
		КонецЕсли;
		Возврат "";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция Сервер_ПрочитатьBaseline(ПутьФайла)

	ФайлBaseline = Новый Файл(ПутьФайла);
	Если Не ФайлBaseline.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПутьФайла);
	Попытка
		Данные = ПрочитатьJSON(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

// Клон формата python write_baseline (regress_run.py):
// {baselineOf, createdAt, totals, scenarios[{scenario,user,status}], runDir}.
&НаСервереБезКонтекста
Процедура Сервер_ЗаписатьBaseline(ПутьФайла, КаталогПрогона, ДанныеОтчета)

	Итоги = ДанныеОтчета.totals;
	Сценарии = ДанныеОтчета.scenarios;

	Baseline = Новый Структура;
	Baseline.Вставить("baselineOf", ИмяКаталогаПоПути(КаталогПрогона));
	Теперь = ТекущаяДатаСеанса();
	Baseline.Вставить("createdAt",
		Формат(Теперь, "ДФ=yyyy-MM-dd") + "T" + Формат(Теперь, "ДФ=HH:mm:ss"));
	Baseline.Вставить("totals", Итоги);
	Baseline.Вставить("scenarios", Сценарии);
	// BSLLS:UsingHardcodePath-off
	Baseline.Вставить("runDir", RelativeRunDir(КаталогПрогона));

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьФайла);
	Попытка
		ЗаписатьJSON(Запись, Baseline);
	Исключение
		Запись.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Запись.Закрыть();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяКаталогаПоПути(Путь)

	// В строках BSL нет escape-последовательностей: бэкслеш - обычный символ.
	Части = СтрРазделить(СтрЗаменить(Путь, "\", "/"), "/", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Части[Части.Количество() - 1];

КонецФункции

&НаСервереБезКонтекста
Функция RelativeRunDir(Путь)

	Норм = СтрЗаменить(Путь, "\", "/");
	// tests/run-... -> относительный путь от корня проекта
	Позиция = СтрНайти(Норм, "/tests/", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Возврат Сред(Норм, Позиция + 1);
	КонецЕсли;
	Возврат Норм;

КонецФункции

&НаСервереБезКонтекста
Функция ПодключитьНаСервере(Адрес)

	Возврат ВнешниеОбработки.Подключить(Адрес, , Ложь);

КонецФункции
