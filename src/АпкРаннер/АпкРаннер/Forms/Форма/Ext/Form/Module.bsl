&НаКлиенте
Функция ПрочитатьЗадание()

	Задание = Неопределено;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл("C:/MyProjects/APKScenTest/tmp/t6/runner_task.json");
		Задание = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
	КонецПопытки;
	Если ТипЗнч(Задание) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Поля = Новый Массив;
	Поля.Добавить("target");
	Поля.Добавить("runDir");
	Поля.Добавить("timeoutOverrideSec");
	Для каждого Поле Из Поля Цикл
		Если Задание.Свойство(Поле) Тогда
			Задание.Вставить(Поле, Задание[Поле]);
		Иначе
			Задание.Вставить(Поле, "");
		КонецЕсли;
	КонецЦикла;
	Попытка
		Задание.timeoutOverrideSec = Число(Задание.timeoutOverrideSec);
	Исключение
		Задание.timeoutOverrideSec = 0;
	КонецПопытки;
	Возврат Задание;

КонецФункции

&НаКлиенте
Процедура Шаг(Отчёт, ИмяШага)

	Отчёт.Вставить("step", ИмяШага);
	ЗаписатьАртефакт(Отчёт);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОшибку(Отчёт, Текст)

	Отчёт.errors.Добавить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура Финал(Отчёт)

	Отчёт.Вставить("step", "done");
	Отчёт.Вставить("errorsCount", Отчёт.errors.Количество());
	ЗаписатьАртефакт(Отчёт);
	Попытка
		Закрыть();
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьАртефакт(Отчёт)

	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьФайл("C:/MyProjects/APKScenTest/tmp/t6/runner_result.json");
		ЗаписатьJSON(Запись, Отчёт);
		Запись.Закрыть();
	Исключение
	КонецПопытки;

КонецПроцедуры
