&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Отказ = Истина;

	Отчёт = Новый Структура;
	Отчёт.Вставить("step", "start");
	Отчёт.Вставить("errors", Новый Массив);

	Задание = ПрочитатьЗадание();
	Если Задание = Неопределено Тогда
		ДобавитьОшибку(Отчёт, "task: не удалось прочитать runner_task.json");
		Финал(Отчёт);
		Возврат;
	КонецЕсли;

	Отчёт.Вставить("target", Задание.target);
	Отчёт.Вставить("runDir", Задание.runDir);
	Шаг(Отчёт, "task-read");

	Если ПустаяСтрока(Задание.target) Или ПустаяСтрока(Задание.runDir) Тогда
		ДобавитьОшибку(Отчёт, "task: пустой target/runDir");
		Финал(Отчёт);
		Возврат;
	КонецЕсли;

	Доп = Новый Структура("Задание, Отчёт", Задание, Отчёт);
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ФайлПомещён", ЭтаФорма, Доп), ,
		Задание.target, Ложь, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ФайлПомещён(ПомещенныйФайл, АдресВоВременномХранилище, ПомещенноеИмяФайла, ДополнительныеПараметры) Экспорт

	Задание = ДополнительныеПараметры.Задание;
	Отчёт = ДополнительныеПараметры.Отчёт;
	Шаг(Отчёт, "file-placed");

	ИмяОбработки = "";
	Попытка
		ИмяОбработки = ПодключитьНаСервере(АдресВоВременномХранилище);
		Отчёт.Вставить("connected", ИмяОбработки);
		Шаг(Отчёт, "connected");
	Исключение
		ДобавитьОшибку(Отчёт, "connect: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Финал(Отчёт);
		Возврат;
	КонецПопытки;

	ВыполнитьПрогон(Задание, Отчёт, ИмяОбработки);
	Финал(Отчёт);

КонецПроцедуры

// Зеркало production-цикла (Module.bsl целевого EPF): план батчей ->
// тестовый пароль -> цикл подмена/батч/восстановление -> сводка.
&НаКлиенте
Процедура ВыполнитьПрогон(Задание, Отчёт, ИмяОбработки)

	План = Неопределено;
	Попытка
		План = Сервер_ПодготовитьПрогон(ИмяОбработки, Задание.runDir);
		Отчёт.Вставить("batchCount", План.Батчи.Количество());
	Исключение
		ДобавитьОшибку(Отчёт, "ПодготовитьПрогон: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Шаг(Отчёт, "plan-ready");

	ТестовыйПароль = "";
	Попытка
		ТестовыйПароль = Сервер_ТестовыйПароль(ИмяОбработки);
		Отчёт.Вставить("testPassword", ТестовыйПароль);
	Исключение
		ДобавитьОшибку(Отчёт, "ТестовыйПароль: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Шаг(Отчёт, "password-generated");

	Результаты = Новый Массив;
	Номер = 0;
	Для Каждого Батч Из План.Батчи Цикл
		Номер = Номер + 1;
		Результат = ВыполнитьБатч(Батч, ТестовыйПароль, Задание, ИмяОбработки);
		Результаты.Добавить(Результат);
		Шаг(Отчёт, "batch-" + Строка(Номер) + "-" + Результат.status);
	КонецЦикла;
	Отчёт.Вставить("batches", Результаты);

	Попытка
		ПутьСводки = Сервер_ЗаписатьРезультаты(ИмяОбработки, Задание.runDir, Результаты);
		Отчёт.Вставить("batchesJson", ПутьСводки);
	Исключение
		ДобавитьОшибку(Отчёт, "ЗаписатьРезультаты: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Зеркало ВыполнитьБатчКлиентом целевого EPF (finally-семантика FR-006).
&НаКлиенте
Функция ВыполнитьБатч(Батч, ТестовыйПароль, Задание, ИмяОбработки)

	Результат = Новый Структура;
	Результат.Вставить("user",      Батч.Пользователь);
	Результат.Вставить("batch",     Батч.Номер);
	Результат.Вставить("status",    "error");
	Результат.Вставить("returnStatus", "");
	Результат.Вставить("verdict",   "");
	Результат.Вставить("durationSec", 0);
	Результат.Вставить("pid",       0);
	Результат.Вставить("passwordRestored", Ложь);
	Результат.Вставить("pwdSubstituted",    Ложь);
	Результат.Вставить("negative",          Батч.Негативный);
	Результат.Вставить("zodRestored", Ложь);
	Результат.Вставить("error",     "");

	Если Задание.timeoutOverrideSec > 0 Тогда
		Батч.ТаймаутСек = Задание.timeoutOverrideSec;
	КонецЕсли;

	Снимок = Неопределено;
	Попытка
		Если Батч.ПодменятьПароль Тогда
			// s004 (TD-001): реальный автор - подмена всегда
			Снимок = Сервер_ПодменитьПарольБезусловно(ИмяОбработки, Батч.Пользователь, ТестовыйПароль);
			Результат.pwdSubstituted = Истина;
		Иначе
			// зондовый режим - замороженный путь спеки 001 (as-is)
			Снимок = Сервер_ПодменитьПароль(ИмяОбработки, Батч.Пользователь, ТестовыйПароль);
			Результат.pwdSubstituted = Снимок.ПарольУстановлен;
		КонецЕсли;
		Сервер_ЗаписатьVAParams(ИмяОбработки, Батч, ТестовыйПароль);
		// 24.10 (run10e batch-1 root cause): если автор батча = админ
		// TestManager (adminUser), выше его пароль подменен на тестовый -
		// менеджер с Батч.ПарольАдмина (старый/пустой) не авторизуется и
		// висит до таймаута (0-байтовые логи, VA не стартует). Эффективный
		// пароль менеджера = тестовый.
		Если Батч.Админ = Батч.Пользователь И Батч.ПодменятьПароль Тогда
			Батч.Вставить("ПарольМенеджера", ТестовыйПароль);
		КонецЕсли;
		ЗапуститьVAИДождаться(Батч, Результат);
	Исключение
		Результат.error = Результат.error
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Снимок <> Неопределено Тогда
		Попытка
			Восстановление = Сервер_ВосстановитьПароль(ИмяОбработки, Батч.Пользователь, Снимок);
			// s004: агрегирующий вердикт обеих веток
			Результат.passwordRestored = Восстановление.ПарольВосстановлен;
			Результат.zodRestored = Восстановление.ЗОДВосстановлен;
		Исключение
			Результат.error = Результат.error
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Попытка
		РезультатVA = Сервер_ПрочитатьРезультат(ИмяОбработки, Батч);
		Результат.returnStatus = РезультатVA.Код;
		Результат.verdict = РезультатVA.Вердикт;
		Если Результат.status = "done" Тогда
			Результат.status = РезультатVA.Вердикт;
		КонецЕсли;
	Исключение
		Результат.error = Результат.error
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		Сервер_УдалитьФайлыБатча(ИмяОбработки, Батч);
	Исключение
		Результат.error = Результат.error
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Зеркало ЗапуститьVAИДождаться: WScript.Shell.Exec, опрос с таймаутом,
// taskkill /PID /T /F (kill-tree) на таймауте.
&НаКлиенте
Процедура ЗапуститьVAИДождаться(Батч, Результат)

	Команда = КомандаЗапускаБатча(Батч);
	Шелл = Новый COMОбъект("WScript.Shell");
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Процесс = Шелл.Exec("cmd /c " + Команда);
	Результат.pid = Процесс.ProcessID;

	Прервано = Ложь;
	// Осиротевший TestClient батча (его родитель - не TestManager, а брокер,
	// kill-tree из PID батча его не достаёт) держит порт батча и блокирует
	// следующий запуск - убираем перед стартом (NFR-003).
	УбратьОсиротевшихTestClient(Шелл, Батч.Порт);
	Пока Процесс.Status = 0 Цикл
		Если (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000 >= Батч.ТаймаутСек Тогда
			Прервано = Истина;
			Прервать;
		КонецЕсли;
		ПаузаКлиента(Шелл, 2);
	КонецЦикла;

	Если Прервано Тогда
		// Строка(PID) даёт NBSP-разделитель групп ("28 104") - taskkill молча
		// падает; Формат без группировки.
		Шелл.Run("cmd /c taskkill /PID " + Формат(Процесс.ProcessID, "ЧГ=")
			+ " /T /F", 0, Истина);
		Результат.status = "timeout";
		ПаузаКлиента(Шелл, 1);
		Результат.Вставить("killConfirmed", Процесс.Status <> 0);
	Иначе
		Результат.status = "done";
	КонецЕсли;
	// TestClient запускается VA не как дочерний процесс TestManager
	// (родитель - брокер), поэтому kill-tree его не убивает: убираем
	// осиротевший TestClient на порту батча при любом исходе.
	УбратьОсиротевшихTestClient(Шелл, Батч.Порт);
	Результат.durationSec = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;

КонецПроцедуры

// Убирает осиротевший TestClient батча: VA запускает TestClient не как
// дочерний процесс TestManager (родитель - брокер), поэтому kill-tree
// из PID батча его не достаёт. Точечная зачистка по порту батча
// ("-TPort <порт>" в командной строке) не задевает чужие процессы.
&НаКлиенте
Процедура УбратьОсиротевшихTestClient(Шелл, Порт)

	Шелл.Run("cmd /c powershell -NoProfile -Command ""Get-CimInstance Win32_Process "
		+ "| Where-Object { $_.Name -eq '1cv8c.exe' "
		+ "-and $_.CommandLine -like '*-TPort " + Строка(Порт) + "*' } "
		+ "| ForEach-Object { Stop-Process -Id $_.ProcessId -Force }""", 0, Истина);

КонецПроцедуры

// Зеркало КомандаЗапускаБатча целевого EPF.
&НаКлиенте
Функция КомандаЗапускаБатча(Батч)

	// 24.10: ПарольМенеджера - эффективный пароль админа TestManager
	// (раннер подменяет его, когда автор батча = админ; см. ВыполнитьБатч).
	ПарольМенеджера = Батч.ПарольАдмина;
	Батч.Свойство("ПарольМенеджера", ПарольМенеджера);
	Команда = КавычкиКлиент(Батч.Путь1cv8c)
		+ " ENTERPRISE /TESTMANAGER"
		+ " /S " + КавычкиКлиент(Батч.База)
		+ " /N " + КавычкиКлиент(Батч.Админ)
		+ " /P " + КавычкиКлиент(ПарольМенеджера)
		+ " /Out " + КавычкиКлиент(Батч.ПутьЛога1С)
		+ " /Execute " + КавычкиКлиент(Батч.ПутьVA)
		+ " /C " + КавычкиКлиент("StartFeaturePlayer;VAParams=" + Батч.ПутьVAParams);
	Возврат """" + Команда + """";

КонецФункции

&НаКлиенте
Процедура ПаузаКлиента(Шелл, Секунд)

	Шелл.Run("cmd /c ping -n " + Строка(Секунд + 1) + " localhost > nul", 0, Истина);

КонецПроцедуры

