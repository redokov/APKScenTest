// T4 (спека 005): тонкий интерактивный драйвер прогона VA.
// Вся серверная механика (план батчей, подмена/восстановление паролей,
// VAParams, чтение результата, отчёт) - в препроцессоре
// АпкПодготовкаСценарныхТестов.epf; раннер подключает его как внешнюю
// обработку и крутит асинхронный цикл батчей через обработчик ожидания,
// чтобы «Прервать» срабатывало посреди батча (убить процесс -> пароль
// восстановить в любом случае -> финализировать).
//
// Семантика перенесена 1-1 из проверенного харнесса t6 (run10e) и
// python-эталона scripts/regress_run.py (diff_classes, write_baseline).

#Область ОписаниеПеременных

// Состояние прогона (паттерн объявления как в Vanessa Automation:
// директива компиляции перед каждой группой, без Экспорт).
&НаКлиенте
Перем ИмяПодключенной, ПланПрогона, ТестовыйПароль, ИндексБатча, РезультатыБатчей;

&НаКлиенте
Перем Шелл, ПроцессБатча, БатчТекущий, СнимокТекущий, ПользовательСнимка, НачалоБатча;

&НаКлиенте
Перем ПрерватьФлаг, ПрогонАктивен, ВердиктPASS, ПоследнийИтоги, ПоследнийСценарии;

#КонецОбласти

&НаКлиенте
Процедура ПодключитьПрепроцессор(Команда)

	Доп = Новый Структура;
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ПрепроцессорПомещён", ЭтаФорма, Доп), ,
		, Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПрепроцессорПомещён(ПомещенныйФайл, АдресВоВременномХранилище, ПомещенноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если АдресВоВременномХранилище = Неопределено Или ПустаяСтрока(АдресВоВременномХранилище) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Файл препроцессора не выбран.'"));
		Возврат;
	КонецЕсли;

	Попытка
		ИмяПодключенной = ПодключитьНаСервере(АдресВоВременномХранилище);
		ПутьПрепроцессора = ПомещенноеИмяФайла;
	Исключение
		ИмяПодключенной = "";
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось подключить препроцессор: '")
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПрогон(Команда)

	Если ПрогонАктивен Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Прогон уже выполняется.'"));
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ИмяПодключенной) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала подключите препроцессор (кнопка «Подключить препроцессор...»)."));
		Возврат;
	КонецЕсли;
	КаталогПрогона = СокрЛП(КаталогПрогона);
	Если ПустаяСтрока(КаталогПрогона) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите каталог прогона (features-manifest.json + features/)."));
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ЗапускПодтверждён", ЭтаФорма),
		НСтр("ru = 'Прогон подменит пароли авторов на время батчей и восстановит их после. Продолжить?"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗапускПодтверждён(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПланПрогона = Сервер_ПодготовитьПрогон(ИмяПодключенной, КаталогПрогона);
	Исключение
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось подготовить прогон: '")
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если ПланПрогона.Батчи.Количество() = 0 Тогда
		Текст = НСтр("ru = 'План прогона пуст: нет пользователей-авторов с найденными фичами.'");
		Для Каждого Предупреждение Из ПланПрогона.Предупреждения Цикл
			Текст = Текст + Символы.ПС + Предупреждение;
		КонецЦикла;
		ПоказатьПредупреждение(, Текст);
		Возврат;
	КонецЕсли;

	Попытка
		ТестовыйПароль = Сервер_ТестовыйПароль(ИмяПодключенной);
	Исключение
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось сгенерировать тестовый пароль: '")
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ИндексБатча = 0;
	РезультатыБатчей = Новый Массив;
	ПрерватьФлаг = Ложь;
	ПрогонАктивен = Истина;
	ВердиктPASS = Ложь;
	ПанельВердикта = "";
	МаркерыПаролей = "";

	Шелл = Новый COMОбъект("WScript.Shell"); // BSLLS:UsingObjectNotAvailableUnix-off

	НачатьБатч();
	ПодключитьОбработчикОжидания("ТикПрогона", 1, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура НачатьБатч()

	БатчТекущий = ПланПрогона.Батчи[ИндексБатча];
	СнимокТекущий = Неопределено;
	ПользовательСнимка = "";
	ПроцессБатча = Неопределено;
	НачалоБатча = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Если БатчТекущий.ПодменятьПароль Тогда
			// s004 (TD-001): реальный автор - подмена всегда
			СнимокТекущий = Сервер_ПодменитьПарольБезусловно(ИмяПодключенной,
				БатчТекущий.Пользователь, ТестовыйПароль);
		Иначе
			// зондовый режим - замороженный путь спеки 001 (as-is)
			СнимокТекущий = Сервер_ПодменитьПароль(ИмяПодключенной,
				БатчТекущий.Пользователь, ТестовыйПароль);
		КонецЕсли;
		ПользовательСнимка = БатчТекущий.Пользователь;

		Сервер_ЗаписатьVAParams(ИмяПодключенной, БатчТекущий, ТестовыйПароль);

		// 24.10 (run10e batch-1 root cause): если автор батча = админ
		// TestManager, его пароль выше подменён на тестовый - менеджер со
		// старым/пустым ПарольАдмина не авторизуется и висит до таймаута.
		Если БатчТекущий.Админ = БатчТекущий.Пользователь И БатчТекущий.ПодменятьПароль Тогда
			БатчТекущий.Вставить("ПарольМенеджера", ТестовыйПароль);
		КонецЕсли;

		// Осиротевший TestClient прошлой попытки держит порт батча -
		// убираем ДО старта (NFR-003).
		УбратьОсиротевшихTestClient(Шелл, БатчТекущий.Порт);

		ПроцессБатча = Шелл.Exec("cmd /c " + КомандаЗапускаБатча(БатчТекущий));
	Исключение
		ЗавершитьБатч("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ТикПрогона()

	Если Не ПрогонАктивен Тогда
		ОтключитьОбработчикОжидания("ТикПрогона");
		Возврат;
	КонецЕсли;

	Если ПрерватьФлаг Тогда
		УбитьПроцессБатча();
		ЗавершитьБатч("aborted", "");
		Возврат;
	КонецЕсли;

	Если ПроцессБатча = Неопределено Тогда
		Возврат; // батч ещё не запущен или уже финализирован
	КонецЕсли;

	Если ПроцессБатча.Status <> 0 Тогда
		ЗавершитьБатч("done", "");
		Возврат;
	КонецЕсли;

	Если (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоБатча) / 1000
			>= БатчТекущий.ТаймаутСек Тогда
		УбитьПроцессБатча();
		ЗавершитьБатч("timeout", "");
		Возврат;
	КонецЕсли;

	ОбновитьСтатусПрогона();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусПрогона()

	Сек = Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоБатча) / 1000);
	Минуты = Цел(Сек / 60);
	Секунды = Сек % 60;
	СтатусПрогона = НСтр("ru = 'Батч '") + Строка(ИндексБатча + 1) + "/"
		+ Строка(ПланПрогона.Батчи.Количество()) + " (" + БатчТекущий.Пользователь + "): "
		+ ?(Минуты < 10, "0", "") + Строка(Минуты) + ":"
		+ ?(Секунды < 10, "0", "") + Строка(Секунды);

КонецПроцедуры

&НаКлиенте
Процедура УбитьПроцессБатча()

	Если ПроцессБатча = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Строка(PID) даёт NBSP-разделитель групп ("28 104") - taskkill молча
	// падает; Формат без группировки. Kill-tree: /T /F.
	Шелл.Run("cmd /c taskkill /PID " + Формат(ПроцессБатча.ProcessID, "ЧГ=")
		+ " /T /F", 0, Истина);
	ПаузаКлиента(Шелл, 1);

КонецПроцедуры

// Завершает текущий батч при ЛЮБОМ исходе (finally-семантика FR-006):
// восстановление пароля -> чтение результата VA -> удаление файлов
// батча -> переход к следующему или финал прогона.
&НаКлиенте
Процедура ЗавершитьБатч(Исход, ТекстОшибки)

	Результат = Новый Структура;
	Результат.Вставить("user",             БатчТекущий.Пользователь);
	Результат.Вставить("batch",            БатчТекущий.Номер);
	Результат.Вставить("status",           Исход);
	Результат.Вставить("returnStatus",     "");
	Результат.Вставить("verdict",          "");
	Результат.Вставить("durationSec",      0);
	Результат.Вставить("pid",              0);
	Результат.Вставить("passwordRestored", Ложь);
	Результат.Вставить("pwdSubstituted",   БатчТекущий.ПодменятьПароль);
	Результат.Вставить("negative",         БатчТекущий.Негативный);
	Результат.Вставить("zodRestored",      Ложь);
	Результат.Вставить("killConfirmed",    Неопределено);
	Результат.Вставить("error",            ТекстОшибки);

	Если ПроцессБатча <> Неопределено Тогда
		Результат.pid = ПроцессБатча.ProcessID;
		Результат.killConfirmed = ПроцессБатча.Status <> 0;
	КонецЕсли;
	Результат.durationSec = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоБатча) / 1000;

	// Восстановление пароля - при любом исходе, в первую очередь.
	Если СнимокТекущий <> Неопределено Тогда
		Попытка
			Восстановление = Сервер_ВосстановитьПароль(ИмяПодключенной,
				ПользовательСнимка, СнимокТекущий);
			// s004: агрегирующий вердикт обеих веток
			Результат.passwordRestored = Восстановление.ПарольВосстановлен;
			Результат.zodRestored = Восстановление.ЗОДВосстановлен;
		Исключение
			Результат.error = Результат.error
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		СнимокТекущий = Неопределено;
		ПользовательСнимка = "";
	КонецЕсли;

	// Вердикт VA по ReturnStatus-файлу (TD-006: код процесса не используется).
	Попытка
		РезультатVA = Сервер_ПрочитатьРезультат(ИмяПодключенной, БатчТекущий);
		Результат.returnStatus = РезультатVA.Код;
		Результат.verdict = РезультатVA.Вердикт;
		Если Исход = "done" Тогда
			Результат.status = РезультатVA.Вердикт;
		КонецЕсли;
	Исключение
		Результат.error = Результат.error
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// NFR-001: временные файлы батча (VAParams с тестовым паролем, статус,
	// временный каталог фич) не остаются на диске.
	Попытка
		Сервер_УдалитьФайлыБатча(ИмяПодключенной, БатчТекущий);
	Исключение
		Результат.error = Результат.error
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// TestClient запускается VA не как дочерний процесс TestManager
	// (родитель - брокер), kill-tree его не достаёт: убираем осиротевший
	// TestClient на порту батча ПОСЛЕ любого исхода.
	Попытка
		УбратьОсиротевшихTestClient(Шелл, БатчТекущий.Порт);
	Исключение
		Результат.error = Результат.error + " orphan-cleanup: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	РезультатыБатчей.Добавить(Результат);
	БатчТекущий = Неопределено;
	ПроцессБатча = Неопределено;
	ИндексБатча = ИндексБатча + 1;

	Если ПрерватьФлаг Или ИндексБатча >= ПланПрогона.Батчи.Количество() Тогда
		ФиналПрогона();
	Иначе
		НачатьБатч();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФиналПрогона()

	ПрогонАктивен = Ложь;
	ОтключитьОбработчикОжидания("ТикПрогона");

	Попытка
		Сервер_ЗаписатьРезультаты(ИмяПодключенной, КаталогПрогона, РезультатыБатчей);
	Исключение
		СтатусПрогона = НСтр("ru = 'Прогон завершён; сводку батчей записать не удалось: '")
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	СобратьИПоказатьОтчет();

КонецПроцедуры

&НаКлиенте
Процедура ПрерватьПрогон(Команда)

	Если ПрогонАктивен Тогда
		ПрерватьФлаг = Истина;
		СтатусПрогона = НСтр("ru = 'Прерывание...'");
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Прогон не выполняется.'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтчет(Команда)

	Если ПрогонАктивен Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Дождитесь окончания прогона.'"));
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(КаталогПрогона) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите каталог прогона.'"));
		Возврат;
	КонецЕсли;

	СобратьИПоказатьОтчет();

КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьЭталон(Команда)

	Если Не ВердиктPASS Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Эталон фиксируется только при зелёном прогоне (вердикт PASS).'"));
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ПутьBaseline) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите путь файла baseline.'"));
		Возврат;
	КонецЕсли;

	Попытка
		Сервер_ЗаписатьBaseline(ПутьBaseline, КаталогПрогона, ОтчетДляBaseline());
		Сообщить(НСтр("ru = 'Эталон записан: '") + ПутьBaseline);
	Исключение
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось записать эталон: '")
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Данные последнего собранного отчёта для записи эталона (только
// нужное: totals + сценарии {scenario,user,status}).
&НаКлиенте
Функция ОтчетДляBaseline()

	Данные = Новый Структура;
	Данные.Вставить("totals", ПоследнийИтоги);
	Сценарии = Новый Массив;
	Для Каждого СтрокаСценария Из ПоследнийСценарии Цикл
		Сценарии.Добавить(Новый Структура("scenario,user,status",
			ЗначениеИзСоответствия(СтрокаСценария, "scenario"),
			ЗначениеИзСоответствия(СтрокаСценария, "user"),
			ЗначениеИзСоответствия(СтрокаСценария, "status")));
	КонецЦикла;
	Данные.Вставить("scenarios", Сценарии);
	Возврат Данные;

КонецФункции

&НаКлиенте
Процедура СобратьИПоказатьОтчет()

	Попытка
		Отчет = Сервер_СобратьОтчет(ИмяПодключенной, КаталогПрогона);
	Исключение
		СтатусПрогона = НСтр("ru = 'Отчёт собрать не удалось: '")
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	ПоследнийИтоги = Отчет.Итоги;
	ПоследнийСценарии = Отчет.Сценарии;

	Базовые = Неопределено;
	Если Не ПустаяСтрока(ПутьBaseline) Тогда
		Попытка
			Базовые = Сервер_ПрочитатьBaseline(ПутьBaseline);
		Исключение
			Базовые = Неопределено;
		КонецПопытки;
	КонецЕсли;

	ЗначениеВРеквизитФормы(Сервер_ТаблицаРезультатов(Отчет.Сценарии, Отчет.БатчиСводно, Базовые),
		"Результаты");
	ОбновитьВердиктИМаркеры(Отчет, Базовые);

	Если ПрогонАктивен Тогда
		СтатусПрогона = НСтр("ru = 'Готово.'");
	Иначе
		СтатусПрогона = НСтр("ru = 'Отчёт: '") + Отчет.ПутьMD;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВердиктИМаркеры(Отчет, Базовые)

	Итоги = Отчет.Итоги;
	Зеленый = Число(ЗначениеИзСоответствия(Итоги, "failed")) = 0
		И Число(ЗначениеИзСоответствия(Итоги, "broken")) = 0
		И Число(ЗначениеИзСоответствия(Итоги, "timeout")) = 0
		И Число(ЗначениеИзСоответствия(Итоги, "unknown")) = 0
		И Число(ЗначениеИзСоответствия(Итоги, "negativeFailed")) = 0;

	ПаролиОк = Истина;
	Маркеры = Новый Массив;
	Для Каждого Батч Из Отчет.БатчиСводно Цикл
		Восстановлен = ЗначениеИзСоответствия(Батч, "passwordRestored") = Истина
			И ЗначениеИзСоответствия(Батч, "zodRestored") = Истина;
		Если Не Восстановлен Тогда
			ПаролиОк = Ложь;
		КонецЕсли;
		Маркеры.Добавить(НСтр("ru = 'Батч '") + Строка(ЗначениеИзСоответствия(Батч, "batch"))
			+ " " + ЗначениеИзСоответствия(Батч, "user") + ": "
			+ ?(Восстановлен, НСтр("ru = 'пароль восстановлен'"),
				НСтр("ru = 'ПАРОЛЬ НЕ ВОССТАНОВЛЕН!'")));
	КонецЦикла;

	ВердиктPASS = Зеленый И ПаролиОк;

	Регрессий = 0;
	Для Каждого СтрокаТаблицы Из Результаты Цикл
		Если СтрокаТаблицы.VsBaseline = "REGRESSION" Или СтрокаТаблицы.VsBaseline = "MISSING" Тогда
			Регрессий = Регрессий + 1;
		КонецЕсли;
	КонецЦикла;

	ТекстВердикта = ?(ВердиктPASS, НСтр("ru = 'PASS'"), НСтр("ru = 'FAIL'"));
	ТекстВердикта = ТекстВердикта + ". passed=" + Строка(ЗначениеИзСоответствия(Итоги, "passed"))
		+ " failed=" + Строка(ЗначениеИзСоответствия(Итоги, "failed"))
		+ " broken=" + Строка(ЗначениеИзСоответствия(Итоги, "broken"))
		+ " timeout=" + Строка(ЗначениеИзСоответствия(Итоги, "timeout"))
		+ " unknown=" + Строка(ЗначениеИзСоответствия(Итоги, "unknown"))
		+ " neg-passed=" + Строка(ЗначениеИзСоответствия(Итоги, "negativePassed"))
		+ " neg-failed=" + Строка(ЗначениеИзСоответствия(Итоги, "negativeFailed"));

	Если Базовые <> Неопределено Тогда
		ТекстВердикта = ТекстВердикта + Символы.ПС + НСтр("ru = 'регрессий '")
			+ Строка(Регрессий) + " vs baseline "
			+ ЗначениеИзСоответствия(Базовые, "baselineOf");
	Иначе
		ТекстВердикта = ТекстВердикта + Символы.ПС + НСтр("ru = 'baseline не задан - сравнение n/a'");
	КонецЕсли;

	ПанельВердикта = ТекстВердикта;
	МаркерыПаролей = СклеитьСтроки(Маркеры);

КонецПроцедуры

// BAD = failed|broken|timeout|unknown (ровно как в python diff_classes).
&НаКлиенте
Функция ЗначениеИзСоответствия(ОбъектДанные, ИмяСвойства)

	Если ОбъектДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(ОбъектДанные) = Тип("Соответствие") Тогда
		Значение = ОбъектДанные[ИмяСвойства];
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(ОбъектДанные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если ОбъектДанные.Свойство(ИмяСвойства, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат "";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Функция СклеитьСтроки(МассивСтрок)

	Текст = "";
	Для Каждого Строка Из МассивСтрок Цикл
		Если Текст = "" Тогда
			Текст = Строка;
		Иначе
			Текст = Текст + Символы.ПС + Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Зеркало КомандаЗапускаБатча целевого EPF (t6/run10e, as-is).
&НаКлиенте
Функция КомандаЗапускаБатча(Батч)

	// ПарольМенеджера - эффективный пароль админа TestManager (раннер
	// подменяет его, когда автор батча = админ; см. НачатьБатч).
	ПарольМенеджера = Батч.ПарольАдмина;
	Батч.Свойство("ПарольМенеджера", ПарольМенеджера);
	Команда = КавычкиКлиент(Батч.Путь1cv8c)
		+ " ENTERPRISE /TESTMANAGER"
		+ " /S " + КавычкиКлиент(Батч.База)
		+ " /N " + КавычкиКлиент(Батч.Админ)
		+ " /P " + КавычкиКлиент(ПарольМенеджера)
		+ " /Out " + КавычкиКлиент(Батч.ПутьЛога1С)
		+ " /Execute " + КавычкиКлиент(Батч.ПутьVA)
		+ " /C " + КавычкиКлиент("StartFeaturePlayer;VAParams=" + Батч.ПутьVAParams);
	Возврат """" + Команда + """";

КонецФункции

// Убирает осиротевший TestClient батча: VA запускает TestClient не как
// дочерний процесс TestManager (родитель - брокер), поэтому kill-tree из
// PID батча его не достаёт. Точечная зачистка по порту батча
// ("-TPort <порт>" в командной строке) не задевает чужие процессы.
&НаКлиенте
Процедура УбратьОсиротевшихTestClient(Шелл, Порт)

	Шелл.Run("cmd /c powershell -NoProfile -Command ""Get-CimInstance Win32_Process "
		+ "| Where-Object { $_.Name -eq '1cv8c.exe' "
		+ "-and $_.CommandLine -like '*-TPort " + Строка(Порт) + "*' } "
		+ "| ForEach-Object { Stop-Process -Id $_.ProcessId -Force }""", 0, Истина);

КонецПроцедуры

