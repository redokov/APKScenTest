#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Умолчания только для этого проекта; пользователь меняет в форме.
	// BSLLS:UsingHardcodePath-off
	ПутьНастроек = "C:/MyProjects/APKScenTest/tests/preprocessor-settings.json";
	// BSLLS:UsingHardcodePath-off
	ПутьКаталогаПрогонов = "C:/MyProjects/APKScenTest/tests";
	ПутьФильтров = "";
	ИтогСканирования = "";
	Предупреждения = "";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СканироватьДокументы(Команда)
	СканироватьНаСервере();
КонецПроцедуры
&НаКлиенте
Процедура СгенерироватьФичи(Команда)

	Если ПустаяСтрока(СокрЛП(КаталогПрогона)) Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Укажите каталог прогона (сначала выполните сканирование)'"));
		Возврат;
	КонецЕсли;

	Попытка
		ИтогФикстур = Сервер_СформироватьФикстуры(СокрЛП(КаталогПрогона));
		ИтогФич = Сервер_СгенерироватьФичи(СокрЛП(КаталогПрогона));
	Исключение
		Предупреждения = НСтр("ru = 'Генерация фич не выполнена:'") + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	ИтогСканирования = ИтогФикстур + Символы.ПС + ИтогФич;

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПрогон(Команда)

	Если ПустаяСтрока(СокрЛП(КаталогПрогона)) Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Укажите каталог прогона с fixtures.json и features/'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПодтверждениеЗапускаПрогона", ЭтаФорма);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Запустить прогон VA? Пароли пользователей плана будут временно подменены и восстановлены после каждого батча'"),
		РежимДиалогаВопрос.ДаНет, 0, ,
		НСтр("ru = 'Запуск прогона'"));

КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеЗапускаПрогона(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ИтогПрогона = ВыполнитьПрогонКлиентом(СокрЛП(КаталогПрогона));

КонецПроцедуры


&НаКлиенте
Процедура СформироватьОтчет(Команда)

	Если ПустаяСтрока(СокрЛП(КаталогПрогона)) Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Укажите каталог прогона с batches.json (после прогона)'"));
		Возврат;
	КонецЕсли;
	Попытка
		ИтогОтчета = Сервер_СобратьОтчет(СокрЛП(КаталогПрогона));
	Исключение
		ИтогОтчета = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ПрогонVA

// Цикл батчей прогона: подмена → батч → восстановление (finally-семантика,
// FR-006/FR-009) → следующий; таймаут/сбой одного батча не рушат цикл.
&НаКлиенте
Функция ВыполнитьПрогонКлиентом(КаталогПрогона)

	План = Неопределено;
	Попытка
		План = Сервер_ПодготовитьПрогон(КаталогПрогона);
	Исключение
		Возврат ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ТестовыйПароль = "";
	Попытка
		ТестовыйПароль = Сервер_ТестовыйПароль();
	Исключение
		Возврат ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Журнал = "";
	Для Каждого Предупреждение Из План.Предупреждения Цикл
		Журнал = Журнал + Предупреждение + Символы.ПС;
	КонецЦикла;

	Результаты = Новый Массив;
	Номер = 0;
	Для Каждого Батч Из План.Батчи Цикл
		Номер = Номер + 1;
		Результат = ВыполнитьБатчКлиентом(Батч, ТестовыйПароль);
		Результаты.Добавить(Результат);
		Журнал = Журнал + "Батч " + Строка(Номер) + " (" + Батч.Пользователь + "): "
			+ Результат.status + ", VA=" + Результат.verdict
			+ ", пароль восстановлен: " + Строка(Результат.passwordRestored) + Символы.ПС;
	КонецЦикла;

	Попытка
		ПутьСводки = Сервер_ЗаписатьРезультаты(КаталогПрогона, Результаты);
		Журнал = Журнал + "Сводка батчей: " + ПутьСводки;
	Исключение
		Журнал = Журнал + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Журнал;

КонецФункции

// Один батч (батч = пользователь, TD-004): подмена → запуск VA →
// восстановление при любом исходе → вердикт ReturnStatus (TD-006) →
// удаление VAParams (NFR-001).
&НаКлиенте
Функция ВыполнитьБатчКлиентом(Батч, ТестовыйПароль)

	Результат = Новый Структура;
	Результат.Вставить("user",      Батч.Пользователь);
	Результат.Вставить("batch",     Батч.Номер);
	Результат.Вставить("status",    "error");
	Результат.Вставить("returnStatus", "");
	Результат.Вставить("verdict",   "");
	Результат.Вставить("durationSec", 0);
	Результат.Вставить("pid",       0);
	Результат.Вставить("passwordRestored", Ложь);
	Результат.Вставить("pwdSubstituted",    Ложь);
	Результат.Вставить("negative",          Батч.Негативный);
	Результат.Вставить("zodRestored", Ложь);
	Результат.Вставить("error",     "");

	Снимок = Неопределено;
	Попытка
		Если Батч.ПодменятьПароль Тогда
			// s004 (TD-001): реальный автор - подмена всегда, в т.ч. если
			// исходного пароля не было (ПодменитьПарольБезусловно);
			// ветка ПарольУстановлен=Истина идентична замороженной.
			Снимок = Сервер_ПодменитьПарольБезусловно(Батч.Пользователь, ТестовыйПароль);
			Результат.pwdSubstituted = Истина;
		Иначе
			// зондовый режим - замороженный путь спеки 001 (as-is)
			Снимок = Сервер_ПодменитьПароль(Батч.Пользователь, ТестовыйПароль);
			Результат.pwdSubstituted = Снимок.ПарольУстановлен;
		КонецЕсли;
		Сервер_ЗаписатьVAParams(Батч, ТестовыйПароль);
		ЗапуститьVAИДождаться(Батч, Результат);
	Исключение
		Результат.error = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// finally-семантика: восстановление при любом исходе батча (FR-006).
	Если Снимок <> Неопределено Тогда
		Попытка
			Восстановление = Сервер_ВосстановитьПароль(Батч.Пользователь, Снимок);
			// s004: агрегирующий вердикт обеих веток (с паролем / без пароля)
			Результат.passwordRestored = Восстановление.ПарольВосстановлен;
			Результат.zodRestored = Восстановление.ЗОДВосстановлен;
		Исключение
			Результат.error = Результат.error
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Попытка
		РезультатVA = Сервер_ПрочитатьРезультат(Батч);
		Результат.returnStatus = РезультатVA.Код;
		Результат.verdict = РезультатVA.Вердикт;
		Если Результат.status = "done" Тогда
			Результат.status = РезультатVA.Вердикт;
		КонецЕсли;
	Исключение
		// вердикт недоступен - статус остаётся от запуска (timeout/error)
		Результат.error = Результат.error
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// NFR-001: VAParams и временные фичи удаляются после батча.
	Попытка
		Сервер_УдалитьФайлыБатча(Батч);
	Исключение
		// артефакты батча необязательны для вердикта
		Результат.error = Результат.error
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Запускает 1cv8c TestManager через WScript.Shell.Exec (PID) и ждёт
// окончания с таймаутом; таймаут → taskkill /PID /T /F (kill-tree,
// TD-003). Убиваются ТОЛЬКО процессы, запущенные этим батчем.
&НаКлиенте
Процедура ЗапуститьVAИДождаться(Батч, Результат)

	Команда = КомандаЗапускаБатча(Батч);
	// BSLLS:UsingObjectNotAvailableUnix-off
	Шелл = Новый COMОбъект("WScript.Shell");
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Процесс = Шелл.Exec("cmd /c " + Команда);
	Результат.pid = Процесс.ProcessID;

	Прервано = Ложь;
	// Осиротевший TestClient батча (его родитель - не TestManager, а брокер,
	// kill-tree из PID батча его не достаёт) держит порт батча и блокирует
	// следующий запуск - убираем перед стартом (NFR-003).
	УбратьОсиротевшихTestClient(Шелл, Батч.Порт);
	Пока Процесс.Status = 0 Цикл
		Если (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000 >= Батч.ТаймаутСек Тогда
			Прервано = Истина;
			Прервать;
		КонецЕсли;
		ПаузаКлиента(Шелл, 2);
	КонецЦикла;

	Если Прервано Тогда
		// Строка(PID) даёт NBSP-разделитель групп ("28 104") - taskkill молча
		// падает; Формат без группировки.
		Шелл.Run("cmd /c taskkill /PID " + Формат(Процесс.ProcessID, "ЧГ=")
			+ " /T /F", 0, Истина);
		Результат.status = "timeout";
	Иначе
		Результат.status = "done";
	КонецЕсли;
	// TestClient запускается VA не как дочерний процесс TestManager
	// (родитель - брокер), поэтому kill-tree его не убивает: убираем
	// осиротевший TestClient на порту батча при любом исходе.
	УбратьОсиротевшихTestClient(Шелл, Батч.Порт);
	Результат.durationSec = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;

КонецПроцедуры

// Убирает осиротевший TestClient батча: VA запускает TestClient не как
// дочерний процесс TestManager (родитель - брокер), поэтому kill-tree
// из PID батча его не достаёт. Точечная зачистка по порту батча
// ("-TPort <порт>" в командной строке) не задевает чужие процессы.
&НаКлиенте
Процедура УбратьОсиротевшихTestClient(Шелл, Порт)

	Шелл.Run("cmd /c powershell -NoProfile -Command ""Get-CimInstance Win32_Process "
		+ "| Where-Object { $_.Name -eq '1cv8c.exe' "
		+ "-and $_.CommandLine -like '*-TPort " + Строка(Порт) + "*' } "
		+ "| ForEach-Object { Stop-Process -Id $_.ProcessId -Force }""", 0, Истина);

КонецПроцедуры

// Командная строка запуска батча. Паттерн cmd /c с дополнительной
// обёрткой кавычек (TD-003): cmd корректно разбирает внутренние кавычки.
&НаКлиенте
Функция КомандаЗапускаБатча(Батч)

	Команда = КавычкиКлиент(Батч.Путь1cv8c)
		+ " ENTERPRISE /TESTMANAGER"
		+ " /S " + КавычкиКлиент(Батч.База)
		+ " /N " + КавычкиКлиент(Батч.Админ)
		+ " /P " + КавычкиКлиент(Батч.ПарольАдмина)
		+ " /Out " + КавычкиКлиент(Батч.ПутьЛога1С)
		+ " /Execute " + КавычкиКлиент(Батч.ПутьVA)
		+ " /C " + КавычкиКлиент("StartFeaturePlayer;VAParams=" + Батч.ПутьVAParams);
	Возврат """" + Команда + """";

КонецФункции

// Синхронная пауза клиентского кода: ping как таймер
// (функции сна в клиентском BSL нет).
&НаКлиенте
Процедура ПаузаКлиента(Шелл, Секунд)

	Шелл.Run("cmd /c ping -n " + Строка(Секунд + 1) + " localhost > nul", 0, Истина);

КонецПроцедуры

// Значение в двойных кавычках.
&НаКлиенте
Функция КавычкиКлиент(Значение)

	Возврат """" + Строка(Значение) + """";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СканироватьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	КаталогПрогона = "";
	Попытка
		КаталогПрогона = Обработка.НачатьПрогон(ПутьНастроек, ПутьКаталогаПрогонов);
	Исключение
		Предупреждения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Попытка
		ИтогСканирования = Обработка.Сканировать(КаталогПрогона, ПутьФильтров);
	Исключение
		Предупреждения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Попытка
		Результат = Обработка.ВернутьРезультатСканирования(КаталогПрогона);
		ОтобразитьРезультат(Результат);
	Исключение
		Предупреждения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОтобразитьРезультат(Результат)

	ИменаАвторов = ИменаАвторов(Результат);

	ТаблицаПредставители = Новый ТаблицаЗначений;
	ТаблицаПредставители.Колонки.Добавить("ТипДокумента", Новый ОписаниеТипов("Строка"));
	ТаблицаПредставители.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблицаПредставители.Колонки.Добавить("Автор", Новый ОписаниеТипов("Строка"));
	ТаблицаПредставители.Колонки.Добавить("ДатаДокумента", Новый ОписаниеТипов("Дата"));
	ТаблицаПредставители.Колонки.Добавить("Ячейки", Новый ОписаниеТипов("Строка"));

	Представители = ЗначениеСвойства(Результат, "representatives", Неопределено);
	Если Представители <> Неопределено Тогда
		Для Каждого Представитель Из Представители Цикл
			СтрокаТаблицы = ТаблицаПредставители.Добавить();
			СтрокаТаблицы.ТипДокумента = ЗначениеСвойства(Представитель, "type", "");
			СтрокаТаблицы.Номер = ЗначениеСвойства(Представитель, "number", "");
			СтрокаТаблицы.Автор = ЗначениеСвойства(Представитель, "author", "");
			СтрокаТаблицы.ДатаДокумента = ПрочитатьДатуISO(
				ЗначениеСвойства(Представитель, "date", ""));
			СтрокаТаблицы.Ячейки = СтрокаЯчеек(Представитель);
			Если ИменаАвторов.Получить(СтрокаТаблицы.Автор) <> Неопределено Тогда
				СтрокаТаблицы.Автор = ИменаАвторов.Получить(СтрокаТаблицы.Автор);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ЗначениеВРеквизитФормы(ТаблицаПредставители, "Представители");

	ТаблицаПользователи = Новый ТаблицаЗначений;
	ТаблицаПользователи.Колонки.Добавить("Автор", Новый ОписаниеТипов("Строка"));
	ТаблицаПользователи.Колонки.Добавить("ИмяПользователяИБ", Новый ОписаниеТипов("Строка"));
	ТаблицаПользователи.Колонки.Добавить("ПарольУстановлен", Новый ОписаниеТипов("Булево"));
	ТаблицаПользователи.Колонки.Добавить("СтандартнаяАутентификация", Новый ОписаниеТипов("Булево"));
	ТаблицаПользователи.Колонки.Добавить("Исключен", Новый ОписаниеТипов("Булево"));
	ТаблицаПользователи.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));

	Пользователи = ЗначениеСвойства(Результат, "users", Неопределено);
	Если Пользователи <> Неопределено Тогда
		Для Каждого Пользователь Из Пользователи Цикл
			СтрокаТаблицы = ТаблицаПользователи.Добавить();
			СтрокаТаблицы.Автор = ЗначениеСвойства(Пользователь, "authorName", "");
			СтрокаТаблицы.ИмяПользователяИБ = ЗначениеСвойства(Пользователь, "ibName", "");
			СтрокаТаблицы.ПарольУстановлен = ЗначениеСвойства(Пользователь, "hasPassword", Ложь);
			СтрокаТаблицы.СтандартнаяАутентификация =
				ЗначениеСвойства(Пользователь, "standardAuth", Истина);
			СтрокаТаблицы.Исключен = ЗначениеСвойства(Пользователь, "excluded", Ложь);
			СтрокаТаблицы.Причина = ЗначениеСвойства(Пользователь, "reason", "");
		КонецЦикла;
	КонецЕсли;
	ЗначениеВРеквизитФормы(ТаблицаПользователи, "Пользователи");

	ОтобразитьПредупреждения(Результат);

КонецПроцедуры

&НаСервере
Процедура ОтобразитьПредупреждения(Результат)

	Текст = "";
	Пробелы = ЗначениеСвойства(Результат, "gaps", Неопределено);
	Если Пробелы <> Неопределено И Пробелы.Количество() > 0 Тогда
		Текст = Текст + НСтр("ru = 'Пробелы покрытия:'") + Символы.ПС;
		Для Каждого Пробел Из Пробелы Цикл
			Текст = Текст + "  "
				+ ЗначениеСвойства(Пробел, "type", "") + " / "
				+ ЗначениеСвойства(Пробел, "axis", "") + " = "
				+ ЗначениеСвойства(Пробел, "value", "") + Символы.ПС;
		КонецЦикла;
	КонецЕсли;

	Пользователи = ЗначениеСвойства(Результат, "users", Неопределено);
	Если Пользователи <> Неопределено Тогда
		ИсключеноСтроки = "";
		Для Каждого Пользователь Из Пользователи Цикл
			Если ЗначениеСвойства(Пользователь, "excluded", Ложь) Тогда
				ИсключеноСтроки = ИсключеноСтроки + "  "
					+ ЗначениеСвойства(Пользователь, "authorName", "") + ": "
					+ ЗначениеСвойства(Пользователь, "reason", "") + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(ИсключеноСтроки) Тогда
			Текст = Текст + НСтр("ru = 'Исключены из плана прогона:'") + Символы.ПС
				+ ИсключеноСтроки;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Текст) Тогда
		Предупреждения = Текст;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ИменаАвторов(Результат)

	Имена = Новый Соответствие;
	Пользователи = ЗначениеСвойства(Результат, "users", Неопределено);
	Если Пользователи <> Неопределено Тогда
		Для Каждого Пользователь Из Пользователи Цикл
			Имена.Вставить(
				ЗначениеСвойства(Пользователь, "author", ""),
				ЗначениеСвойства(Пользователь, "authorName", ""));
		КонецЦикла;
	КонецЕсли;
	Возврат Имена;

КонецФункции

&НаСервере
Функция СтрокаЯчеек(Представитель)

	Ячейки = ЗначениеСвойства(Представитель, "cells", Неопределено);
	Если Ячейки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Описания = Новый Массив;
	Для Каждого Ячейка Из Ячейки Цикл
		Описания.Добавить(
			ЗначениеСвойства(Ячейка, "axis", "") + "="
			+ ЗначениеСвойства(Ячейка, "value", ""));
	КонецЦикла;
	Возврат СтрСоединить(Описания, "; ");

КонецФункции

&НаСервере
Функция ПрочитатьДатуISO(СтрокаДаты)

	Попытка
		Возврат XMLЗначение(Тип("Дата"), СтрокаДаты);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция ЗначениеСвойства(ОбъектДанные, ИмяСвойства, Умолчание)

	Если ОбъектДанные = Неопределено Или ОбъектДанные = Null Тогда
		Возврат Умолчание;
	КонецЕсли;
	Если ТипЗнч(ОбъектДанные) <> Тип("Структура") Тогда
		Возврат Умолчание;
	КонецЕсли;

	Значение = Умолчание;
	Если ОбъектДанные.Свойство(ИмяСвойства, Значение) Тогда
		Если Значение = Null Тогда
			Возврат Умолчание;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	Возврат Умолчание;

КонецФункции

