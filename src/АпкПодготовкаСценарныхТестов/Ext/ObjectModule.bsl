#Область ПрограммныйИнтерфейс

// Начинает новый прогон: создаёт неперезаписываемый run-каталог
// <КаталогПрогонов>/run-<ГГГГММДД>-<ЧЧММСС> и пишет в него run.json
// (настройки + резолвнутые пути).
//
// Параметры:
//   ПутьНастроек         - путь к файлу preprocessor-settings.json;
//   ПутьКаталогаПрогонов - базовый каталог прогонов; пустая строка = взять
//                          из настроек (projectDir + runsBaseDir).
//
// Возвращаемое значение:
//   Строка - полный путь созданного каталога прогона.
//
Функция НачатьПрогон(ПутьНастроек, ПутьКаталогаПрогонов) Экспорт

	ПутьНастроек = СокрЛП(ПутьНастроек);
	Если ПустаяСтрока(ПутьНастроек) Тогда
		ВызватьИсключение НСтр("ru = 'Не задан путь к файлу настроек'");
	КонецЕсли;

	Настройки = ПрочитатьJSONФайл(ПутьНастроек);
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось прочитать настройки прогона'");
	КонецЕсли;

	Проект      = СокрЛП(ЗначениеСвойства(Настройки, "projectDir", ""));
	КаталогПрогонов = СокрЛП(ПутьКаталогаПрогонов);
	Если ПустаяСтрока(КаталогПрогонов) Тогда
		КаталогПрогонов = СокрЛП(ЗначениеСвойства(Настройки, "runsBaseDir", "tests"));
		КаталогПрогонов = ПолныйПуть(Проект, КаталогПрогонов);
	КонецЕсли;
	КаталогПрогонов = НормализоватьПуть(КаталогПрогонов);

	ИдПрогона = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd") + "-"
		+ Формат(ТекущаяДатаСеанса(), "ДФ=HHmmss");
	КаталогПрогона = КаталогПрогонов + "/" + "run-" + ИдПрогона;
	НомерДубля = 1;
	Пока КаталогСуществуетФ(КаталогПрогона) Цикл
		НомерДубля = НомерДубля + 1;
		КаталогПрогона = КаталогПрогонов + "/" + "run-" + ИдПрогона + "-" + Строка(НомерДубля);
		Если НомерДубля > 50 Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось выделить каталог прогона'");
		КонецЕсли;
	КонецЦикла;

	СоздатьКаталог(КаталогПрогона);
	Если Не КаталогСуществуетФ(КаталогПрогона) Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось создать каталог прогона: '") + КаталогПрогона;
	КонецЕсли;

	ДанныеПрогона = Новый Структура;
	ДанныеПрогона.Вставить("runId",     ИдПрогона);
	ДанныеПрогона.Вставить("startedAt", СтрокаДатыISO(ТекущаяДатаСеанса()));
	ДанныеПрогона.Вставить("settings",  Настройки);

	Пути = Новый Структура;
	Пути.Вставить("runDir",       КаталогПрогона);
	Пути.Вставить("projectDir",   Проект);
	Пути.Вставить("settingsFile", НормализоватьПуть(ПутьНастроек));
	Пути.Вставить("templatesDir",
		ПолныйПуть(Проект, СокрЛП(ЗначениеСвойства(Настройки, "templatesDir", ""))));
	Пути.Вставить("coverageMap",
		ПолныйПуть(Проект, СокрЛП(ЗначениеСвойства(Настройки, "coverageMapPath", ""))));
	ДанныеПрогона.Вставить("paths", Пути);

	ЗаписатьJSONФайл(КаталогПрогона + "/" + "run.json", ДанныеПрогона);

	Возврат КаталогПрогона;
КонецФункции

// Сканирует проведённые документы 5 типов из карты покрытия, строит
// оси покрытия, выбирает представителей и сопоставляет пользователей ИБ.
// Результат пишется в <КаталогПрогона>/scan.json.
//
// Параметры:
//   КаталогПрогона - каталог прогона (создан НачатьПрогон);
//   ПутьФильтров   - путь к JSON-файлу фильтров (необязателен).
//
// Возвращаемое значение:
//   Строка - итог сканирования (краткая сводка).
//
Функция Сканировать(КаталогПрогона, ПутьФильтров) Экспорт

	КаталогПрогона = НормализоватьПуть(СокрЛП(КаталогПрогона));
	Если ПустаяСтрока(КаталогПрогона) Или Не КаталогСуществуетФ(КаталогПрогона) Тогда
		ВызватьИсключение НСтр("ru = 'Каталог прогона не найден: '") + КаталогПрогона;
	КонецЕсли;

	ДанныеПрогона = ПрочитатьJSONФайл(КаталогПрогона + "/" + "run.json");
	Если ТипЗнч(ДанныеПрогона) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'В каталоге прогона нет корректного run.json'");
	КонецЕсли;

	ИдПрогона = ЗначениеСвойства(ДанныеПрогона, "runId", "");
	Пути      = ЗначениеСвойства(ДанныеПрогона, "paths", Новый Структура);
	ПутьКарты = ЗначениеСвойства(Пути, "coverageMap", "");
	Если ПустаяСтрока(ПутьКарты) Или Не ФайлСуществуетФ(ПутьКарты) Тогда
		ВызватьИсключение НСтр("ru = 'Не найдена карта покрытия: '") + ПутьКарты;
	КонецЕсли;

	Карта = ПрочитатьJSONФайл(ПутьКарты);
	ДокументыКарта = ЗначениеСвойства(Карта, "documents", Новый Структура);
	Если ТипЗнч(ДокументыКарта) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'В карте покрытия нет секции documents'");
	КонецЕсли;

	Фильтры = ПрочитатьФильтры(ПутьФильтров);

	// --- 1. Выборка проведённых документов ---
	НайденныеСтроки = ВыбратьДокументы(ДокументыКарта, Фильтры);

	// --- 2. Оси каждого документа ---
	КэшПеречислений = Новый Соответствие;
	Найденные = Новый Массив;
	Для Каждого СтрокаДок Из НайденныеСтроки Цикл
		ОбъектДок = СтрокаДок.Ссылка.ПолучитьОбъект();
		Если ОбъектДок = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОпределениеТипа = Новый Структура;
		Если ДокументыКарта.Свойство(СтрокаДок.ТипДокумента, ОпределениеТипа) Тогда
			ОсиДокумента = ВычислитьОсиДокумента(ОбъектДок, ОпределениеТипа, КэшПеречислений);
		Иначе
			ОсиДокумента = Новый Соответствие;
		КонецЕсли;
		Документ = Новый Структура;
		Документ.Вставить("ТипДокумента",   СтрокаДок.ТипДокумента);
		Документ.Вставить("Ссылка",        СтрокаДок.Ссылка);
		Документ.Вставить("Номер",          СтрокаДок.Номер);
		Документ.Вставить("ДатаДокумента",  СтрокаДок.ДатаДокумента);
		Документ.Вставить("Автор",          СтрокаДок.Автор);
		Документ.Вставить("Момент",         СтрокаДок.Момент);
		Документ.Вставить("Оси",            ОсиДокумента);
		Найденные.Добавить(Документ);
	КонецЦикла;

	// --- 3. Представители и пробелы ---
	ПредставителиПоКлючу = Новый Соответствие;
	Пробелы = Новый Массив;
	Для Каждого КлючЗначение Из ДокументыКарта Цикл
		ВыбратьПредставителейТипа(
			КлючЗначение.Ключ, КлючЗначение.Значение, Найденные, ПредставителиПоКлючу, Пробелы);
	КонецЦикла;

	// --- 4. Сопоставление пользователей ИБ по авторам представителей ---
	ЗаписиПользователей = СопоставитьПользователей(ПредставителиПоКлючу);

	// --- 5. Сборка и запись scan.json ---
	МассивНайденных = Новый Массив;
	Для Каждого Документ Из Найденные Цикл
		Запись = Новый Структура;
		Запись.Вставить("type",       Документ.ТипДокумента);
		Запись.Вставить("ref",        Строка(Документ.Ссылка.УникальныйИдентификатор()));
		Запись.Вставить("number",     Документ.Номер);
		Запись.Вставить("author",     Строка(Документ.Автор.УникальныйИдентификатор()));
		Запись.Вставить("authorName", Строка(Документ.Автор));
		Запись.Вставить("date",       СтрокаДатыISO(Документ.ДатаДокумента));
		Запись.Вставить("axes",       Документ.Оси);
		МассивНайденных.Добавить(Запись);
	КонецЦикла;

	МассивПредставителей = Новый Массив;
	Для Каждого КлючЗначение Из ПредставителиПоКлючу Цикл
		МассивПредставителей.Добавить(КлючЗначение.Значение);
	КонецЦикла;

	ДанныеСкана = Новый Структура;
	ДанныеСкана.Вставить("runId",         ИдПрогона);
	ДанныеСкана.Вставить("scannedAt",     СтрокаДатыISO(ТекущаяДатаСеанса()));
	ДанныеСкана.Вставить("filters",       Фильтры.Эхо);
	ДанныеСкана.Вставить("found",         МассивНайденных);
	ДанныеСкана.Вставить("representatives", МассивПредставителей);
	ДанныеСкана.Вставить("gaps",          Пробелы);
	ДанныеСкана.Вставить("users",         ЗаписиПользователей.Записи);

	ПутьРезультата = КаталогПрогона + "/" + "scan.json";
	ЗаписатьJSONФайл(ПутьРезультата, ДанныеСкана);

	Возврат СтрШаблон(
		НСтр("ru = 'Найдено: %1; представителей: %2; пробелов: %3; пользователей: %4; файл: %5'"),
		МассивНайденных.Количество(), МассивПредставителей.Количество(),
		Пробелы.Количество(), ЗаписиПользователей.Записи.Количество(), ПутьРезультата);
КонецФункции

// Читает scan.json каталога прогона в структуры/соответствия 1С.
// Используется формой обработки для отображения результата сканирования.
//
// Параметры:
//   КаталогПрогона - каталог прогона.
//
// Возвращаемое значение:
//   Структура/Массив - содержимое scan.json.
//
Функция ВернутьРезультатСканирования(КаталогПрогона) Экспорт

	ПутьРезультата = НормализоватьПуть(СокрЛП(КаталогПрогона)) + "/" + "scan.json";
	Если Не ФайлСуществуетФ(ПутьРезультата) Тогда
		ВызватьИсключение НСтр("ru = 'Не найден файл результата сканирования: '") + ПутьРезультата;
	КонецЕсли;

	Возврат ПрочитатьJSONФайл(ПутьРезультата);
КонецФункции

// Строит план прогона по результатам сканирования (scan.json каталога
// прогона): сценарии каждого пользователя и план АРМов с учётом
// условий arms.when карты покрытия (FR-004, FR-011).
//
// Параметры:
//   КаталогПрогона - каталог прогона (содержит run.json и scan.json).
//
// Возвращаемое значение:
//   Структура - users (массив записей по контракту fixtures.json)
//               и armPlan (план АРМов пользователя x АРМ).
//
Функция ПостроитьПланПрогона(КаталогПрогона) Экспорт

	Контекст = ПрочитатьКонтекстПрогона(КаталогПрогона);
	Представители = ЗначениеСвойства(Контекст.Скан, "representatives", Новый Массив);
	ПользователиСкана = ЗначениеСвойства(Контекст.Скан, "users", Новый Массив);

	ПланАРМовПоКлючу = Новый Соответствие;
	ПланПользователей = Новый Массив;

	Для Каждого Пользователь Из ПользователиСкана Цикл
		Если ЗначениеСвойства(Пользователь, "excluded", Истина) Тогда
			Продолжить;
		КонецЕсли;

		ИдАвтор = СокрЛП(ЗначениеСвойства(Пользователь, "author", ""));
		ДокументыПользователя = Новый Массив;
		Для Каждого Представитель Из Представители Цикл
			Если СокрЛП(ЗначениеСвойства(Представитель, "author", "")) = ИдАвтор Тогда
				ДокументыПользователя.Добавить(Представитель);
			КонецЕсли;
		КонецЦикла;

		Сценарии = Новый Массив;
		Для Каждого Представитель Из ДокументыПользователя Цикл
			ТипДокумента = СокрЛП(ЗначениеСвойства(Представитель, "type", ""));
			ОпределениеТипа = Новый Структура;
			Если Не Контекст.ДокументыКарта.Свойство(ТипДокумента, ОпределениеТипа) Тогда
				Продолжить;
			КонецЕсли;

			ШаблонТипа = СокрЛП(ЗначениеСвойства(ОпределениеТипа, "template", ""));
			Если Не ПустаяСтрока(ШаблонТипа) И Не СписокСодержит(Сценарии, ШаблонТипа) Тогда
				Сценарии.Добавить(ШаблонТипа);
			КонецЕсли;

			Ячейки = ЗначениеСвойства(Представитель, "cells", Новый Массив);
			АРМыТипа = ЗначениеСвойства(ОпределениеТипа, "arms", Новый Массив);
			Для Каждого АРМ Из АРМыТипа Цикл
				Условие = СокрЛП(ЗначениеСвойства(АРМ, "when", ""));
				Если Не УсловиеАРМаВыполнено(Условие, Ячейки) Тогда
					Продолжить;
				КонецЕсли;

				ЗаписьАРМа = ЗаписьПланаАРМа(ПланАРМовПоКлючу, Пользователь, АРМ);
				Если Не СписокСодержит(ЗаписьАРМа.docTypes, ТипДокумента) Тогда
					ЗаписьАРМа.docTypes.Добавить(ТипДокумента);
				КонецЕсли;
				Если Не ПустаяСтрока(Условие) И Не СписокСодержит(ЗаписьАРМа.reasons, Условие) Тогда
					ЗаписьАРМа.reasons.Добавить(Условие);
				КонецЕсли;
				ШаблонАРМа = СокрЛП(ЗначениеСвойства(АРМ, "template", ""));
				Если Не ПустаяСтрока(ШаблонАРМа) Тогда
					Если Не СписокСодержит(ЗаписьАРМа.templates, ШаблонАРМа) Тогда
						ЗаписьАРМа.templates.Добавить(ШаблонАРМа);
					КонецЕсли;
					Если Не СписокСодержит(Сценарии, ШаблонАРМа) Тогда
						Сценарии.Добавить(ШаблонАРМа);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		ЗаписьПользователя = Новый Структура;
		ЗаписьПользователя.Вставить("ibUser",       ЗначениеСвойства(Пользователь, "ibName", ""));
		ЗаписьПользователя.Вставить("sourceAuthor", ЗначениеСвойства(Пользователь, "authorName", ""));
		ЗаписьПользователя.Вставить("hasPassword",  ЗначениеСвойства(Пользователь, "hasPassword", Ложь));
		ЗаписьПользователя.Вставить("docTypes",     ТипыДокументовПользователя(ДокументыПользователя));
		ЗаписьПользователя.Вставить("scenarios",    Сценарии);
		ПланПользователей.Добавить(ЗаписьПользователя);
	КонецЦикла;

	ПланАРМов = Новый Массив;
	Для Каждого КлючЗначение Из ПланАРМовПоКлючу Цикл
		ЗаписьАРМа = КлючЗначение.Значение;
		ЗаписьАРМа.Вставить("reason", СтрСоединить(ЗаписьАРМа.reasons, "; "));
		ЗаписьАРМа.Удалить("reasons");
		ПланАРМов.Добавить(ЗаписьАРМа);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("users",   ПланПользователей);
	Результат.Вставить("armPlan", ПланАРМов);
	Возврат Результат;
КонецФункции

// Формирует файл fixtures.json в каталоге прогона: фикстуры данных
// каждого документа-представителя (шапка + до 3 строк ТЧ по fieldList
// карты) и план прогона (FR-002, FR-004, FR-012). Настройки - из run.json
// каталога прогона; представители и пробелы - из scan.json.
//
// Параметры:
//   КаталогПрогона - каталог прогона (создан НачатьПрогон,
//                    заполнен Сканировать).
//
// Возвращаемое значение:
//   Строка - краткая сводка о сформированных фикстурах.
//
Функция СформироватьФикстуры(КаталогПрогона) Экспорт

	Контекст = ПрочитатьКонтекстПрогона(КаталогПрогона);
	Представители = ЗначениеСвойства(Контекст.Скан, "representatives", Новый Массив);

	МаксимумСтрок = Число(ЗначениеСвойства(Контекст.Настройки, "maxTabularRows", 3));
	Если МаксимумСтрок <= 0 Тогда
		МаксимумСтрок = 3;
	КонецЕсли;

	План = ПостроитьПланПрогона(Контекст.КаталогПрогона);

	МассивДокументов = Новый Массив;
	МассивПробеловПериодов = Новый Массив;
	ПропущенныеДокументы = 0;
	ПервыйОбъектДокумента = Неопределено;
	Для Каждого Представитель Из Представители Цикл
		ТипДокумента = СокрЛП(ЗначениеСвойства(Представитель, "type", ""));
		ОпределениеТипа = Новый Структура;
		Если Не Контекст.ДокументыКарта.Свойство(ТипДокумента, ОпределениеТипа) Тогда
			ПропущенныеДокументы = ПропущенныеДокументы + 1;
			Продолжить;
		КонецЕсли;

		ИдентификаторДок = СокрЛП(ЗначениеСвойства(Представитель, "ref", ""));
		ОбъектДок = Неопределено;
		Если ЭтоУУИДСтрокой(ИдентификаторДок) Тогда
			Попытка
				СсылкаДок = Документы[ТипДокумента].ПолучитьСсылку(
					Новый УникальныйИдентификатор(ИдентификаторДок));
				ОбъектДок = СсылкаДок.ПолучитьОбъект();
			Исключение
				ОбъектДок = Неопределено;
			КонецПопытки;
		КонецЕсли;
		Если ОбъектДок = Неопределено Тогда
			ПропущенныеДокументы = ПропущенныеДокументы + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			ДанныеДокумента = ДанныеДокументаФикстуры(ОбъектДок, ОпределениеТипа, МаксимумСтрок);
		Исключение
			ПропущенныеДокументы = ПропущенныеДокументы + 1;
			Продолжить;
		КонецПопытки;

		Если ПервыйОбъектДокумента = Неопределено Тогда
			ПервыйОбъектДокумента = ОбъектДок;
		КонецЕсли;

		ЗаписьДокумента = Новый Структура;
		ЗаписьДокумента.Вставить("type",     ТипДокумента);
		ЗаписьДокумента.Вставить("ref",      ИдентификаторДок);
		ЗаписьДокумента.Вставить("number",   ЗначениеСвойства(Представитель, "number", ""));
		ЗаписьДокумента.Вставить("date",     СтрокаДатыISO(ОбъектДок.Дата));
		ЗаписьДокумента.Вставить("author",   СокрЛП(ЗначениеСвойства(Представитель, "author", "")));
		ЗаписьДокумента.Вставить("coverage", ПокрытиеДокумента(ЗначениеСвойства(Представитель, "cells", Новый Массив)));
		ЗаписьДокумента.Вставить("data",     ДанныеДокумента);
		МассивДокументов.Добавить(ЗаписьДокумента);
		Для Каждого ПробелПериода Из ПробелыПериодовОбъектовЗатрат(ОбъектДок, ОпределениеТипа) Цикл
			МассивПробеловПериодов.Добавить(ПробелПериода);
		КонецЦикла;
	КонецЦикла;

	Общие = Новый Структура;
	Если ПервыйОбъектДокумента <> Неопределено Тогда
		Общие = ОбщиеДанные(ПервыйОбъектДокумента);
	КонецЕсли;

	МассивПробелов = Новый Массив;
	Для Каждого ПробелПериода Из МассивПробеловПериодов Цикл
		МассивПробелов.Добавить(ПробелПериода);
	КонецЦикла;
	ПробелыСкана = ЗначениеСвойства(Контекст.Скан, "gaps", Новый Массив);
	Для Каждого Пробел Из ПробелыСкана Цикл
		ЗаписьПробела = Новый Структура;
		ЗаписьПробела.Вставить("docType", СокрЛП(ЗначениеСвойства(Пробел, "type", "")));
		ЗаписьПробела.Вставить("axis",    СокрЛП(ЗначениеСвойства(Пробел, "axis", "")));
		ЗаписьПробела.Вставить("value",   ЗначениеСвойства(Пробел, "value", ""));
		МассивПробелов.Добавить(ЗаписьПробела);
	КонецЦикла;

	Фикстуры = Новый Структура;
	Фикстуры.Вставить("runId",        Контекст.ИдПрогона);
	Фикстуры.Вставить("generatedAt",  СтрокаДатыISO(ТекущаяДатаСеанса()));
	Фикстуры.Вставить("filters",      ЗначениеСвойства(Контекст.Скан, "filters", Новый Структура));
	Фикстуры.Вставить("common",       Общие);
	Фикстуры.Вставить("users",        План.users);
	Фикстуры.Вставить("documents",    МассивДокументов);
	Фикстуры.Вставить("armPlan",      План.armPlan);
	Фикстуры.Вставить("coverageGaps", МассивПробелов);
	Фикстуры.Вставить("skippedDocs",  ПропущенныеДокументы);

	ПутьРезультата = Контекст.КаталогПрогона + "/" + "fixtures.json";
	ЗаписатьJSONФайл(ПутьРезультата, Фикстуры);

	Возврат СтрШаблон(
		НСтр("ru = 'Документов: %1; пользователей: %2; строк плана АРМ: %3; пробелов: %4; пропущено: %5; файл: %6'"),
		МассивДокументов.Количество(), План.users.Количество(), План.armPlan.Количество(),
		МассивПробелов.Количество(), ПропущенныеДокументы, ПутьРезультата);
КонецФункции

// Генерирует .feature файлы сценарных тестов в <КаталогПрогона>/features
// по шаблонам каталога templatesDir (FR-005): смоук-шаблон на каждого
// пользователя плана + шаблоны сценариев плана (пользователь × шаблон)
// с данными документов из fixtures.json + шаблоны строк armPlan
// (пользователь × шаблон АРМ, без документов). Имена форм - синонимы из
// метаданных; дата - текущим месяцем; незамещённые плейсхолдеры
// остаются в тексте и фиксируются предупреждением.
//
// Параметры:
//   КаталогПрогона - каталог прогона (с run.json, scan.json, fixtures.json).
//
// Возвращаемое значение:
//   Строка - краткая сводка о сгенерированных файлах.
//
Функция СгенерироватьФичи(КаталогПрогона) Экспорт

	Контекст = ПрочитатьКонтекстПрогона(КаталогПрогона);
	Фикстуры = ПрочитатьJSONФайл(Контекст.КаталогПрогона + "/" + "fixtures.json");
	Если ТипЗнч(Фикстуры) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'В каталоге прогона нет корректного fixtures.json'");
	КонецЕсли;

	КаталогШаблонов = КаталогШаблоновПрогона(Контекст.КаталогПрогона, Контекст.Настройки);
	КаталогВыгрузки = Контекст.КаталогПрогона + "/" + "features";
	Если Не КаталогСуществуетФ(КаталогВыгрузки) Тогда
		СоздатьКаталог(КаталогВыгрузки);
	КонецЕсли;

	ПользователиФикстур = ЗначениеСвойства(Фикстуры, "users", Новый Массив);
	ДокументыФикстур = ЗначениеСвойства(Фикстуры, "documents", Новый Массив);
	ИмяСмоукШаблона = СокрЛП(ЗначениеСвойства(Контекст.Настройки, "smokeTemplate", "00-smoke"));

	Предупреждения = Новый Массив;
	ЗаписиМанифеста = Новый Массив;
	Для Каждого Пользователь Из ПользователиФикстур Цикл
		ИмяПользователя = СокрЛП(ЗначениеСвойства(Пользователь, "ibUser", ""));
		Если ПустаяСтрока(ИмяПользователя) Тогда
			Продолжить;
		КонецЕсли;
		ИмяФайлаПользователя = ИмяФайлаЛатиницей(ИмяПользователя);
		ИдентификаторАвтор = АвторПользователяИБ(Контекст.Скан, ИмяПользователя);

		Если Не ПустаяСтрока(ИмяСмоукШаблона) Тогда
			ЗаписиМанифеста.Добавить(СгенерироватьФайлФичи(КаталогШаблонов, КаталогВыгрузки,
				ИмяСмоукШаблона, ИмяФайлаПользователя, ИмяПользователя, Новый Массив, Предупреждения));
		КонецЕсли;

		СценарииПлана = ЗначениеСвойства(Пользователь, "scenarios", Новый Массив);
		Для Каждого ИмяСценария Из СценарииПлана Цикл
			ТипДокумента = ТипДокументаШаблона(Контекст.ДокументыКарта, ИмяСценария);
			Если ПустаяСтрока(ТипДокумента) Тогда
				Продолжить;
			КонецЕсли;
			ДокументыПользователя = ДокументыПользователяПоТипу(ДокументыФикстур,
				ИдентификаторАвтор, ТипДокумента);
			Если ДокументыПользователя.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			ЗаписиМанифеста.Добавить(СгенерироватьФайлФичи(КаталогШаблонов, КаталогВыгрузки,
				ИмяСценария, ИмяФайлаПользователя, ИмяПользователя, ДокументыПользователя, Предупреждения));
		КонецЦикла;
	КонецЦикла;

	ПланАРМов = ЗначениеСвойства(Фикстуры, "armPlan", Новый Массив);
	СгенерированныеАРМы = Новый Массив;
	Для Каждого ЗаписьАРМа Из ПланАРМов Цикл
		Если ТипЗнч(ЗаписьАРМа) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		ИмяПользователяАРМ = СокрЛП(ЗначениеСвойства(ЗаписьАРМа, "user", ""));
		ИмяФайлаПользователяАРМ = ИмяФайлаЛатиницей(ИмяПользователяАРМ);
		Для Каждого ИмяШаблонаАРМа Из ЗначениеСвойства(ЗаписьАРМа, "templates", Новый Массив) Цикл
			ИмяШаблонаАРМа = СокрЛП(ИмяШаблонаАРМа);
			КлючАРМа = ИмяПользователяАРМ + "|" + ИмяШаблонаАРМа;
			Если ПустаяСтрока(ИмяПользователяАРМ) Или ПустаяСтрока(ИмяШаблонаАРМа)
				Или СписокСодержит(СгенерированныеАРМы, КлючАРМа) Тогда
				Продолжить;
			КонецЕсли;
			СгенерированныеАРМы.Добавить(КлючАРМа);
			ЗаписиМанифеста.Добавить(СгенерироватьФайлФичи(КаталогШаблонов, КаталогВыгрузки,
				ИмяШаблонаАРМа, ИмяФайлаПользователяАРМ, ИмяПользователяАРМ, Новый Массив, Предупреждения));
		КонецЦикла;
	КонецЦикла;

	ЗаписиМанифеста = БезПустыхЗаписей(ЗаписиМанифеста);
	ЧислоСценариев = 0;
	Для Каждого Запись Из ЗаписиМанифеста Цикл
		ЧислоСценариев = ЧислоСценариев + Запись.scenarios;
	КонецЦикла;

	Манифест = Новый Структура;
	Манифест.Вставить("generatedAt", СтрокаДатыISO(ТекущаяДатаСеанса()));
	Манифест.Вставить("files",      ЗаписиМанифеста);
	Манифест.Вставить("warnings",      Предупреждения);
	ЗаписатьJSONФайл(Контекст.КаталогПрогона + "/" + "features-manifest.json", Манифест);

	Возврат СтрШаблон(
		НСтр("ru = 'Файлов: %1; сценариев: %2; предупреждений: %3; каталог: %4'"),
		ЗаписиМанифеста.Количество(), ЧислоСценариев, Предупреждения.Количество(), КаталогВыгрузки);
КонецФункции

// Готовит цикл батчей прогона VA (батч = пользователь, TD-004):
// группирует сгенерированные .feature по пользователям, создаёт каталоги
// params/logs/allure, назначает порты и таймауты (FR-007, NFR-003).
// ЗОД отключается per-user в ПодменитьПароль (в VAParams параметра
// ЗОД нет - см. PROGRESS T6).
//
// Параметры:
//   КаталогПрогона - каталог прогона (run.json, features-manifest.json).
//
// Возвращаемое значение:
//   Структура - Батчи (массив структур батчей, окружение включено
//               в каждый) и Предупреждения (массив строк).
//
Функция ПодготовитьПрогон(КаталогПрогона) Экспорт

	КаталогПрогона = НормализоватьПуть(СокрЛП(КаталогПрогона));
	Если ПустаяСтрока(КаталогПрогона) Или Не КаталогСуществуетФ(КаталогПрогона) Тогда
		ВызватьИсключение НСтр("ru = 'Каталог прогона не найден: '") + КаталогПрогона;
	КонецЕсли;

	ДанныеПрогона = ПрочитатьJSONФайл(КаталогПрогона + "/" + "run.json");
	Если ТипЗнч(ДанныеПрогона) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'В каталоге прогона нет корректного run.json'");
	КонецЕсли;
	Настройки = ЗначениеСвойства(ДанныеПрогона, "settings", Новый Структура);
	ИдПрогона = ЗначениеСвойства(ДанныеПрогона, "runId", "");

	ПутьМанифеста = КаталогПрогона + "/" + "features-manifest.json";
	Если Не ФайлСуществуетФ(ПутьМанифеста) Тогда
		ВызватьИсключение
			НСтр("ru = 'В каталоге прогона нет features-manifest.json (сначала сгенерируйте фичи)'");
	КонецЕсли;
	Манифест = ПрочитатьJSONФайл(ПутьМанифеста);

	Путь1cv8c = НормализоватьПуть(СокрЛП(ЗначениеСвойства(Настройки, "v8cPath", "")));
	ПутьVA = НормализоватьПуть(СокрЛП(ЗначениеСвойства(Настройки, "vaEpfPath", "")));
	Если ПустаяСтрока(Путь1cv8c) Или Не ФайлСуществуетФ(Путь1cv8c) Тогда
		ВызватьИсключение НСтр("ru = 'Не найден 1cv8c (v8cPath настроек)'");
	КонецЕсли;
	Если ПустаяСтрока(ПутьVA) Или Не ФайлСуществуетФ(ПутьVA) Тогда
		ВызватьИсключение НСтр("ru = 'Не найден EPF Vanessa Automation (vaEpfPath настроек)'");
	КонецЕсли;
	База = БазаИзСтрокиПодключения(СокрЛП(ЗначениеСвойства(Настройки, "infoBase", "")));

	Админ = СокрЛП(ЗначениеСвойства(Настройки, "adminUser", ""));
	Если ПустаяСтрока(Админ) Тогда
		ТекущийИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
		Админ = ?(ТекущийИБ = Неопределено, "", ТекущийИБ.Имя);
	КонецЕсли;
	Если НайтиПользователяИБПоИмени(Админ) = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь TestManager не найден в ИБ: '") + Админ;
	КонецЕсли;
	ПарольАдмина = СокрЛП(ЗначениеСвойства(Настройки, "adminPassword", ""));

	ТаймаутМинут = Число(ЗначениеСвойства(Настройки, "timeoutMinutesPerBatch", 10));
	ТаймаутСек = ?(ТаймаутМинут > 0, Окр(ТаймаутМинут * 60), 600);
	ПортБазовый = Число(ЗначениеСвойства(Настройки, "portBase", 48000));

	// T7 (FR-007, TD-006): тип клиента тестирования ("Тонкий" | "Web")
	// и URL веб-публикации базы. Для VA значение литерала "Web"
	// (КлиентТестирования/ПолучитьСтрокуЗапускаWebКлиент): /N и /P из
	// ДопПараметров VA сам переносит в параметры URL, базовый URL - webUrl.
	ТипКлиента = СокрЛП(ЗначениеСвойства(Настройки, "clientType", "Тонкий"));
	ВебURL = СокрЛП(ЗначениеСвойства(Настройки, "webUrl", ""));
	Если ТипКлиента = "Web" И ПустаяСтрока(ВебURL) Тогда
		ВызватьИсключение НСтр("ru = 'clientType=Web требует webUrl в настройках (URL веб-публикации базы)'");
	КонецЕсли;

	КаталогПараметров = КаталогПрогона + "/" + "params";
	КаталогЛогов = КаталогПрогона + "/" + "logs";
	КаталогAllure = КаталогПрогона + "/" + "allure";
	СоздатьКаталогиБатчей(КаталогПараметров, КаталогЛогов, КаталогAllure);

	Группы = ГруппыФайловМанифеста(Манифест);
	// s004 (TD-001): подмена «всегда» в режиме реальных авторов -
	// настройка alwaysSubstitutePwd (доставка: patch_settings_for_real в
	// regress_run.py → preprocessor-settings.json → run.json → здесь).
	ВсегдаПодменять = ЗначениеСвойства(Настройки, "alwaysSubstitutePwd", Ложь) = Истина;
	Предупреждения = Новый Массив;
	Батчи = Новый Массив;
	НомерБатча = 0;
	Для Каждого Группа Из Группы Цикл
		Пользователь = Группа.Пользователь;
		ПользовательИБ = НайтиПользователяИБПоИмени(Пользователь);
		Если ПользовательИБ = Неопределено Тогда
			Предупреждения.Добавить(
				НСтр("ru = 'Пользователь ИБ не найден, батч пропущен: '") + Пользователь);
			Продолжить;
		КонецЕсли;

		НомерБатча = НомерБатча + 1;
		ИмяЛатиницей = ИмяФайлаЛатиницей(Пользователь);

		// Несколько фич у пользователя - во временный каталог батча
		// (VAParams.КаталогФич принимает каталог или один файл).
		КаталогФич = "";
		КаталогФичВременный = Ложь;
		Если Группа.Файлы.Количество() = 1 Тогда
			КаталогФич = Группа.Файлы[0];
		Иначе
			КаталогФич = КаталогПараметров + "/batch-" + Строка(НомерБатча) + "/features";
			СоздатьКаталог(КаталогФич);
			Для Каждого ФайлФичи Из Группа.Файлы Цикл
				КопироватьФайл(ФайлФичи, КаталогФич + "/" + ИмяФайлаПоПути(ФайлФичи));
			КонецЦикла;
			КаталогФичВременный = Истина;
		КонецЕсли;

		Батч = Новый Структура;
		Батч.Вставить("Номер",             НомерБатча);
		Батч.Вставить("Пользователь",       Пользователь);
		// s004: подмена и при ПарольУстановлен=Ложь (режим реальных авторов)
		Батч.Вставить("ПодменятьПароль",   ПользовательИБ.ПарольУстановлен Или ВсегдаПодменять);
		Батч.Вставить("Негативный",         Группа.Негативный);
		Батч.Вставить("Файлы",             Группа.Файлы);
		Батч.Вставить("КаталогФич",        КаталогФич);
		Батч.Вставить("КаталогФичВременный", КаталогФичВременный);
		Батч.Вставить("ИдПрогона",         ИдПрогона);
		Батч.Вставить("ПутьVAParams",
			КаталогПараметров + "/vaparams-" + Строка(НомерБатча) + ".json");
		Батч.Вставить("ПутьСтатуса",
			КаталогПараметров + "/status-" + Строка(НомерБатча) + ".txt");
		Батч.Вставить("ПутьЛога",
			КаталогЛогов + "/va-" + Строка(НомерБатча) + "-" + ИмяЛатиницей + ".log");
		Батч.Вставить("ПутьЛога1С",
			КаталогЛогов + "/1c-" + Строка(НомерБатча) + "-" + ИмяЛатиницей + ".log");
		Батч.Вставить("КаталогAllure",     КаталогAllure);
		Батч.Вставить("ИмяСборки",         ИмяЛатиницей);
		// NBSP в Строка(48401) = "48 401" ломает порт TestClient (VA висит):
		// Формат без группировки.
		Батч.Вставить("Порт", Формат(ПортБазовый + НомерБатча, "ЧГ="));
		Батч.Вставить("ТипКлиента", ТипКлиента);
		Батч.Вставить("ВебURL", ВебURL);
		Батч.Вставить("ТаймаутСек",        ТаймаутСек);
		Батч.Вставить("Путь1cv8c",         Путь1cv8c);
		Батч.Вставить("ПутьVA",            ПутьVA);
		Батч.Вставить("База",              База);
		Батч.Вставить("Админ",             Админ);
		Батч.Вставить("ПарольАдмина",      ПарольАдмина);
		Батчи.Добавить(Батч);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Батчи", Батчи);
	Результат.Вставить("Предупреждения", Предупреждения);
	Возврат Результат;
КонецФункции

// Подменяет пароль пользователя ИБ на тестовый (FR-006): сохраняет
// хэш и флаг ЗОД в снимок (возвращается клиенту, на диск не пишется),
// устанавливает тестовый пароль (если пароль был) и отключает
// ЗОД-предупреждения (FR-010: параметра VAParams нет - флаг «Защита
// от опасных действий» пользователя, TD-009).
//
// Параметры:
//   ИмяПользователяИБ - имя пользователя ИБ;
//   ТестовыйПароль    - пароль на время батча (только в памяти).
//
// Возвращаемое значение:
//   Структура - снимок: ПарольУстановлен, Хэш, ЗОД.
//
Функция ПодменитьПароль(ИмяПользователяИБ, ТестовыйПароль) Экспорт

	ПользовательИБ = НайтиПользователяИБПоИмени(СокрЛП(ИмяПользователяИБ));
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь ИБ не найден: '") + ИмяПользователяИБ;
	КонецЕсли;

	Снимок = Новый Структура;
	Снимок.Вставить("ПарольУстановлен", ПользовательИБ.ПарольУстановлен);
	Снимок.Вставить("Хэш", "");
	Снимок.Вставить("ЗОД", Неопределено);

	Если ПользовательИБ.ПарольУстановлен Тогда
		Снимок.Хэш = ПользовательИБ.СохраняемоеЗначениеПароля;
	КонецЕсли;
	Попытка
		Снимок.ЗОД = ПользовательИБ.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
	Исключение
		// свойство ЗОД недоступно (нет права/версия) - восстанавливать нечего
		Снимок.ЗОД = Неопределено;
	КонецПопытки;

	Если ПользовательИБ.ПарольУстановлен Тогда
		ПользовательИБ.Пароль = ТестовыйПароль;
	КонецЕсли;
	Если Снимок.ЗОД <> Неопределено Тогда
		ПользовательИБ.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
	КонецЕсли;
	ПользовательИБ.Записать();

	Возврат Снимок;
КонецФункции

// Подмена «всегда» (s004, TD-001, FR-002): режим реальных авторов.
// Замороженный ПодменитьПароль (спека 001 as-is) не трогаем: берём его
// снимок и его подмену для ветки «пароль был установлен»; если пароль НЕ
// был установлен - временно УСТАНАВЛИВАЕМ тестовый (решение пользователя:
// механизм должен отрабатываться и на демо-базе с безпарольными авторами).
// Восстановление исхода «без пароля» - ветка ВосстановитьПароль
// (Пароль="" + верификация ПарольУстановлен=Ложь, зонд-факт Q-D1 #6).
//
// Параметры:
//   ИмяПользователяИБ - имя пользователя ИБ;
//   ТестовыйПароль    - пароль на время батча (только в памяти).
//
// Возвращаемое значение:
//   Структура - снимок ПодменитьПароль + УстановленТестовый (булево).
//
Функция ПодменитьПарольБезусловно(ИмяПользователяИБ, ТестовыйПароль) Экспорт

	Снимок = ПодменитьПароль(ИмяПользователяИБ, ТестовыйПароль);
	УстановленТестовый = Ложь;
	Если Не Снимок.ПарольУстановлен Тогда
		ПользовательИБ = НайтиПользователяИБПоИмени(СокрЛП(ИмяПользователяИБ));
		Если ПользовательИБ = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Пользователь ИБ не найден: '") + ИмяПользователяИБ;
		КонецЕсли;
		ПользовательИБ.Пароль = ТестовыйПароль;
		ПользовательИБ.Записать();
		УстановленТестовый = ПользовательИБ.ПарольУстановлен;
	КонецЕсли;
	Снимок.Вставить("УстановленТестовый", УстановленТестовый);
	Возврат Снимок;
КонецФункции

// Восстанавливает пароль пользователя ИБ по снимку (finally-семантика,
// NFR-002): хэш и флаг ЗОД; верифицирует повторным чтением.
// ДатаУстановкиПароля не откатывается платформой (известно, FAQ).
//
// Возвращаемое значение:
//   Структура - ХэшВосстановлен, ЗОДВосстановлен (булево).
//
Функция ВосстановитьПароль(ИмяПользователяИБ, Снимок) Экспорт

	ИмяПользователяИБ = СокрЛП(ИмяПользователяИБ);
	ПользовательИБ = НайтиПользователяИБПоИмени(ИмяПользователяИБ);
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Пользователь ИБ не найден: '") + ИмяПользователяИБ;
	КонецЕсли;
	Если ТипЗнч(Снимок) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный снимок пароля'");
	КонецЕсли;

	ПарольУстановлен = ЗначениеСвойства(Снимок, "ПарольУстановлен", Ложь);
	Если ПарольУстановлен Тогда
		ПользовательИБ.СохраняемоеЗначениеПароля = ЗначениеСвойства(Снимок, "Хэш", "");
	Иначе
		// s004: исход «пароль не установлен» - очистить временный пароль
		// (зонд-факт Q-D1 #6: Пароль="" возвращает ПарольУстановлен=Ложь)
		ПользовательИБ.Пароль = "";
	КонецЕсли;
	Если ЗначениеСвойства(Снимок, "ЗОД", Неопределено) <> Неопределено Тогда
		ПользовательИБ.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях =
			ЗначениеСвойства(Снимок, "ЗОД", Истина);
	КонецЕсли;
	ПользовательИБ.Записать();

	ХэшВосстановлен = Истина;
	ЗОДВосстановлен = Истина;
	Проверка = НайтиПользователяИБПоИмени(ИмяПользователяИБ);
	Если ПарольУстановлен Тогда
		ХэшВосстановлен = Проверка.СохраняемоеЗначениеПароля = Снимок.Хэш;
	КонецЕсли;
	Если ЗначениеСвойства(Снимок, "ЗОД", Неопределено) <> Неопределено Тогда
		ЗОДВосстановлен =
			Проверка.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Снимок.ЗОД;
	КонецЕсли;

	// s004: агрегирующий вердикт восстановления обеих веток
	// (Ложь-ветка: пароль снят, верифицировано ПарольУстановлен=Ложь)
	ПарольВосстановлен = ХэшВосстановлен;
	Если Не ПарольУстановлен Тогда
		ПарольВосстановлен = Не Проверка.ПарольУстановлен;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ПарольВосстановлен", ПарольВосстановлен);
	Результат.Вставить("ХэшВосстановлен", ХэшВосстановлен); // legacy (спека 001)
	Результат.Вставить("ЗОДВосстановлен", ЗОДВосстановлен);
	Возврат Результат;
КонецФункции

// Записывает VAParams-файл батча (содержит тестовый пароль; удаляется
// после батча - NFR-001). Состав параметров сверен со спайками
// (scripts/run_va_smoke.py, scripts/spike_user_run.py).
//
Функция ЗаписатьVAParamsБатча(Батч, ТестовыйПароль) Экспорт

	ПарольКлиента = ?(Батч.ПодменятьПароль, ТестовыйПароль, "");

	// T7: тип клиента и веб-URL наследуются из настроек через батч;
	// защитное чтение через Свойство - для батчей, сформированных
	// старой версией обработки (без ключей ТипКлиента/ВебURL).
	ТипКлиента = "Тонкий";
	Батч.Свойство("ТипКлиента", ТипКлиента);
	ВебURL = "";
	Батч.Свойство("ВебURL", ВебURL);
	Если ТипКлиента = "Web" И ПустаяСтрока(ВебURL) Тогда
		ВызватьИсключение НСтр("ru = 'Web-клиент: у батча не задан ВебURL (webUrl)'");
	КонецЕсли;

	КлиентТестирования = Новый Структура;
	КлиентТестирования.Вставить("Имя", "Основной");
	// Для "Web" база подключения - URL публикации (VA добавит
	// TESTCLIENT/TESTCLIENTID/N/P); для тонкого - штатная строка /S.
	КлиентТестирования.Вставить("ПутьКИнфобазе",
		?(ТипКлиента = "Web", ВебURL,
		"/S " + Кавычки(Батч.База) + " /N " + Кавычки(Батч.Пользователь)
		+ " /P " + Кавычки(ПарольКлиента)));
	КлиентТестирования.Вставить("ДопПараметры",
		"/DisableStartupMessages /DisableStartupDialogs");
	КлиентТестирования.Вставить("ТипКлиента", ТипКлиента);
	КлиентТестирования.Вставить("ИмяКомпьютера", "localhost");
	КлиентТестирования.Вставить("ПортЗапускаТестКлиента", Батч.Порт);

	КлиентыТестирования = Новый Массив;
	КлиентыТестирования.Добавить(КлиентТестирования);

	Параметры = Новый Структура;
	Параметры.Вставить("ИмяСборки", Батч.ИмяСборки);
	Параметры.Вставить("ВерсияПлатформы", ВерсияПлатформыИзПути(Батч.Путь1cv8c));
	Параметры.Вставить("КаталогПоискаВерсииПлатформы", КаталогПоискаВерсий(Батч.Путь1cv8c));
	Параметры.Вставить("СтрокаПодключенияКБазе",
		"ENTERPRISE /S " + Кавычки(Батч.База) + " /N " + Кавычки(Батч.Админ)
		+ " /P " + Кавычки(Батч.ПарольАдмина));
	Параметры.Вставить("ПутьКVanessaAutomation", Батч.ПутьVA);
	Параметры.Вставить("КаталогФич", Батч.КаталогФич);
	Параметры.Вставить("КаталогиБиблиотек", Новый Массив);
	// UI Automation: шаг выбора АналитикаРасходов (двойной клик по строке
	// окна «Объекты затрат») требует встроенной VanessaExt + UI Automation.
	// ЭмулироватьДвиженияМышкиVanessaExt обязательно Ложь: Истина зависает
	// (probe6k/6k2/6m/6m1 висят против 6k3/6k4/6m2, T8).
	Параметры.Вставить("ИспользоватьКомпонентуVanessaExt", "Истина");
	Параметры.Вставить("ИспользоватьUIAutomation", "Истина");
	Параметры.Вставить("ЭмулироватьДвиженияМышкиVanessaExt", "Ложь");
	Параметры.Вставить("КлиентыТестирования", КлиентыТестирования);
	Параметры.Вставить("ВыполнитьСценарии", "Истина");
	Параметры.Вставить("ЗавершитьРаботуСистемы", "Истина");
	Параметры.Вставить("ЗакрытьTestClientПослеЗапускаСценариев", "Истина");
	Параметры.Вставить("ДелатьЛогВыполненияСценариевВТекстовыйФайл", "Истина");
	Параметры.Вставить("ИмяФайлаЛогВыполненияСценариев", Батч.ПутьЛога);
	Параметры.Вставить("ВыгружатьСтатусВыполненияСценариевВФайл", "Истина");
	Параметры.Вставить("ПутьКФайлуДляВыгрузкиСтатусаВыполненияСценариев",
		Батч.ПутьСтатуса);
	Параметры.Вставить("ДелатьОтчетВФорматеАллюр", "Истина");
	Параметры.Вставить("КаталогВыгрузкиAllureБазовый", Батч.КаталогAllure);
	Параметры.Вставить("ИмяТекущейСборки", Батч.ИмяСборки);
	Параметры.Вставить("ДобавлятьКИмениСценарияУсловияВыгрузки", "Истина");
	// Порт запуска TestClient: VA ищет свободный порт ТОЛЬКО в диапазоне
	// ДиапазонПортовTestclient (глобальный параметр; per-client
	// ПортЗапускаТестКлиента игнорируется при запуске нового клиента),
	// по умолчанию 48000-50000 общий для всех запусков машины. Диапазон
	// из одного порта батча изолирует батчи друг от друга и позволяет
	// точечно убирать осиротевшие TestClient (их родитель - не TestManager,
	// kill-tree их не достаёт).
	Параметры.Вставить("ДиапазонПортовTestclient", Батч.Порт + "-" + Батч.Порт);

	ЗаписатьJSONФайл(Батч.ПутьVAParams, Параметры);
	Возврат Батч.ПутьVAParams;
КонецФункции

// Читает вердикт батча по ReturnStatus-файлу (TD-006: код возврата
// процесса не используется). Возвращает структуру:
// Код ("0".."4" или "") и Вердикт (ok/failed/connect/no-scenarios/
// addin/unknown).
Функция ПрочитатьРезультатБатча(Батч) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Код", "");
	Результат.Вставить("Вердикт", "unknown");
	Если Не ФайлСуществуетФ(Батч.ПутьСтатуса) Тогда
		Возврат Результат;
	КонецЕсли;

	Код = СокрЛП(ПрочитатьТекстФайла(Батч.ПутьСтатуса));
	Результат.Код = Код;
	Если Код = "0" Тогда
		Результат.Вердикт = "ok";
	ИначеЕсли Код = "1" Тогда
		Результат.Вердикт = "failed";
	ИначеЕсли Код = "2" Тогда
		Результат.Вердикт = "connect";
	ИначеЕсли Код = "3" Тогда
		Результат.Вердикт = "no-scenarios";
	ИначеЕсли Код = "4" Тогда
		Результат.Вердикт = "addin";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Удаляет временные файлы батча после выполнения (NFR-001: тестовый
// пароль не остаётся в артефактах): VAParams, файл статуса, временный
// каталог фич (если создавался).
Процедура УдалитьФайлыБатча(Батч) Экспорт

	Если ФайлСуществуетФ(Батч.ПутьVAParams) Тогда
		УдалитьФайлы(Батч.ПутьVAParams);
	КонецЕсли;
	Если ФайлСуществуетФ(Батч.ПутьСтатуса) Тогда
		УдалитьФайлы(Батч.ПутьСтатуса);
	КонецЕсли;
	Если Батч.КаталогФичВременный И КаталогСуществуетФ(Батч.КаталогФич) Тогда
		УдалитьФайлы(Батч.КаталогФич);
	КонецЕсли;
КонецПроцедуры

// Пишет сводку батчей прогона в batches.json (вход репортёра T7):
// статусы, вердикты VA, восстановление паролей, длительности.
Функция ЗаписатьРезультатыБатчей(КаталогПрогона, РезультатыБатчей) Экспорт

	КаталогПрогона = НормализоватьПуть(СокрЛП(КаталогПрогона));
	Если ТипЗнч(РезультатыБатчей) <> Тип("Массив") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректные результаты батчей'");
	КонецЕсли;

	ДанныеПрогона = ПрочитатьJSONФайл(КаталогПрогона + "/" + "run.json");
	Сводка = Новый Структура;
	Сводка.Вставить("runId", ЗначениеСвойства(ДанныеПрогона, "runId", ""));
	Сводка.Вставить("finishedAt", СтрокаДатыISO(ТекущаяДатаСеанса()));
	Сводка.Вставить("batches", РезультатыБатчей);

	ПутьРезультата = КаталогПрогона + "/" + "batches.json";
	ЗаписатьJSONФайл(ПутьРезультата, Сводка);
	Возврат ПутьРезультата;
КонецФункции

// Случайный тестовый пароль на прогон (TD-005): живёт в памяти сеанса
// и во временном VAParams-файле, удаляемом после батча.
Функция СгенерироватьТестовыйПароль() Экспорт

	Алфавит = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789";
	Генератор = Новый ГенераторСлучайныхЧисел();
	Пароль = "";
	Для Ном = 1 По 20 Цикл
		Пароль = Пароль + Сред(Алфавит, Генератор.СлучайноеЧисло(1, СтрДлина(Алфавит)), 1);
	КонецЦикла;
	Возврат Пароль;
КонецФункции

// Собирает сводку прогона (design §4.8, FR-008/FR-009/FR-012):
// статусы батчей (batches.json) + результаты сценариев allure
// (allure/<ИмяСборки>/*-result.json) + покрытие (fixtures.json,
// при отсутствии - scan.json) -> summary.json (машиночитаемый) и
// summary.md (человекочитаемый) в каталоге прогона.
//
// Параметры:
//   КаталогПрогона - каталог прогона (batches.json обязателен).
//
// Возвращаемое значение:
//   Структура - ПутьJSON, ПутьMD, ИдПрогона, Итоги (структура),
//               Сценарии (массив), БатчиСводно (массив), ТекстMD.
//
Функция СобратьОтчет(КаталогПрогона) Экспорт

	КаталогПрогона = НормализоватьПуть(СокрЛП(КаталогПрогона));
	Если ПустаяСтрока(КаталогПрогона) Или Не КаталогСуществуетФ(КаталогПрогона) Тогда
		ВызватьИсключение НСтр("ru = 'Каталог прогона не найден: '") + КаталогПрогона;
	КонецЕсли;

	ПутьBatches = КаталогПрогона + "/" + "batches.json";
	Если Не ФайлСуществуетФ(ПутьBatches) Тогда
		ВызватьИсключение
			НСтр("ru = 'В каталоге прогона нет batches.json (прогон не выполнялся?)'");
	КонецЕсли;
	СводкаBatches = ПрочитатьJSONФайл(ПутьBatches);
	Если ТипЗнч(СводкаBatches) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный batches.json'");
	КонецЕсли;
	Батчи = ЗначениеСвойства(СводкаBatches, "batches", Неопределено);
	Если ТипЗнч(Батчи) <> Тип("Массив") Тогда
		Батчи = Новый Массив;
	КонецЕсли;

	ИдПрогона = СокрЛП(ЗначениеСвойства(СводкаBatches, "runId", ""));
	Если ПустаяСтрока(ИдПрогона) Тогда
		Если ФайлСуществуетФ(КаталогПрогона + "/" + "run.json") Тогда
			ИдПрогона = СокрЛП(ЗначениеСвойства(
				ПрочитатьJSONФайл(КаталогПрогона + "/" + "run.json"), "runId", ""));
		КонецЕсли;
	КонецЕсли;

	Покрытие = ПокрытиеОтчета(КаталогПрогона);

	// --- Сценарии: батч + allure ---
	КаталогAllure = КаталогПрогона + "/" + "allure";
	Сценарии = Новый Массив;
	Счетчики = Новый Структура("passed,failed,broken,timeout,unknown", 0, 0, 0, 0, 0);
	// s004 (FR-005): счётчики негативных сценариев - отдельно от позитивных
	НегативныеСчетчики = Новый Структура("passed,failed", 0, 0);
	БатчиСводно = Новый Массив;
	Для Каждого Батч Из Батчи Цикл
		Пользователь = СокрЛП(ЗначениеСвойства(Батч, "user", ""));
		СтатусБатча = СокрЛП(ЗначениеСвойства(Батч, "status", ""));
		КодСтатуса = СокрЛП(ЗначениеСвойства(Батч, "returnStatus", ""));
		НегативныйБатч = ЗначениеСвойства(Батч, "negative", Ложь) = Истина;
		РезультатыСценариев = РезультатыСценариевБатча(
			КаталогAllure, ИмяФайлаЛатиницей(Пользователь));

		Для Каждого Результат Из РезультатыСценариев Цикл
			СтатусСценария = СокрЛП(ЗначениеСвойства(Результат, "status", ""));
			Если ПустаяСтрока(СтатусСценария) Тогда
			СтатусСценария = "unknown";
			КонецЕсли;
			СтрокаСценария = Новый Структура;
			СтрокаСценария.Вставить("scenario",
				СокрЛП(ЗначениеСвойства(Результат, "name", "")));
			СтрокаСценария.Вставить("user",       Пользователь);
			СтрокаСценария.Вставить("build",      ИмяФайлаЛатиницей(Пользователь));
			СтрокаСценария.Вставить("status",      СтатусСценария);
			СтрокаСценария.Вставить("durationMs",
				Число(ЗначениеСвойства(Результат, "stop", 0))
				- Число(ЗначениеСвойства(Результат, "start", 0)));
			СтрокаСценария.Вставить("batchStatus", СтатусБатча);
			СтрокаСценария.Вставить("returnStatus", КодСтатуса);
			Если НегативныйБатч Тогда
				// s004 (FR-005): инверсия вердикта. PASS - только точное
				// воспроизведение ожидаемой ошибки доступа (ПАТТЕРНОТКАЗА,
				// зонд-факт facts-neg-composition.md); любое расхождение - FAIL.
				StatusDetails = ЗначениеСвойства(Результат, "statusDetails", Неопределено);
				Сообщение = "";
				Если ТипЗнч(StatusDetails) = Тип("Структура") Тогда
					Сообщение = СокрЛП(ЗначениеСвойства(StatusDetails, "message", ""));
				КонецЕсли;
				Если СтатусСценария = "failed"
					И СтрНайти(Сообщение, "Нарушение прав доступа") > 0 Тогда
					ЭффективныйСтатус = "neg-passed";
					ПричинаНегатива = "";
				ИначеЕсли СтатусСценария = "passed" Тогда
					ЭффективныйСтатус = "neg-failed";
					ПричинаНегатива = "неожиданно прошло";
				Иначе
					ЭффективныйСтатус = "neg-failed";
					ПричинаНегатива = ?(ПустаяСтрока(Сообщение),
						СтатусСценария, Сред(Сообщение, 1, 160));
				КонецЕсли;
				Если ЭффективныйСтатус = "neg-passed" Тогда
					НегативныеСчетчики.passed = НегативныеСчетчики.passed + 1;
					Иначе
					НегативныеСчетчики.failed = НегативныеСчетчики.failed + 1;
				КонецЕсли;
				// effective-status в status - для baseline-сравнения режима
				СтрокаСценария.status = ЭффективныйСтатус;
				СтрокаСценария.Вставить("rawStatus", СтатусСценария);
				СтрокаСценария.Вставить("negative", Истина);
				СтрокаСценария.Вставить("negReason", ПричинаНегатива);
			Иначе
				СтрокаСценария.Вставить("negative", Ложь);
				УвеличитьСчетчик(Счетчики, СтатусСценария);
			КонецЕсли;
			Сценарии.Добавить(СтрокаСценария);
		КонецЦикла;

		Если РезультатыСценариев.Количество() = 0 Тогда
			// allure пуст - батч умер таймаутом/ошибкой до результата VA:
			// статус сценария определяем по статусу батча.
			СтатусСценария = СтатусБатча;
			Если СтатусСценария = "done" Или ПустаяСтрока(СтатусСценария) Тогда
				СтатусСценария = "unknown";
			КонецЕсли;
			Если НегативныйБатч Тогда
				// s004: негативный батч умер до allure - ошибка среды, не neg-pass
				СтатусСценария = "neg-failed";
				НегативныеСчетчики.failed = НегативныеСчетчики.failed + 1;
			КонецЕсли;
			СтрокаСценария = Новый Структура;
			СтрокаСценария.Вставить("scenario", "(батч: " + Пользователь + ")");
			СтрокаСценария.Вставить("user",      Пользователь);
			СтрокаСценария.Вставить("build",      ИмяФайлаЛатиницей(Пользователь));
			СтрокаСценария.Вставить("status",      СтатусСценария);
			СтрокаСценария.Вставить("durationMs", 0);
			СтрокаСценария.Вставить("batchStatus", СтатусБатча);
			СтрокаСценария.Вставить("returnStatus", КодСтатуса);
			СтрокаСценария.Вставить("negative", НегативныйБатч);
			Если НегативныйБатч Тогда
				СтрокаСценария.Вставить("negReason", "среда: батч умер до allure");
			КонецЕсли;
			Сценарии.Добавить(СтрокаСценария);
			Если Не НегативныйБатч Тогда
				УвеличитьСчетчик(Счетчики, СтатусСценария);
			КонецЕсли;
		КонецЕсли;

		БатчиСводно.Добавить(СтрокаБатчаОтчета(Батч, Пользователь,
			СтатусБатча, КодСтатуса, РезультатыСценариев.Количество()));
	КонецЦикла;

	Итоги = Новый Структура;
	Итоги.Вставить("batches",   Батчи.Количество());
	Итоги.Вставить("scenarios", Сценарии.Количество());
	Итоги.Вставить("passed",    Счетчики.passed);
	Итоги.Вставить("failed",    Счетчики.failed);
	Итоги.Вставить("broken",    Счетчики.broken);
	Итоги.Вставить("timeout",   Счетчики.timeout);
	Итоги.Вставить("unknown",   Счетчики.unknown);
	// s004 (FR-005/FR-007): счётчики негативных сценариев
	Итоги.Вставить("negativePassed", НегативныеСчетчики.passed);
	Итоги.Вставить("negativeFailed", НегативныеСчетчики.failed);

	// --- Пароли (булевы флаги batches.json; хэши не пишем - NFR-001) ---
	Пароли = ПарольнаяСекцияОтчета(Батчи);

	// --- АРМы плана, связанные с фактом прогона ---
	АРМы = АРМыОтчета(Покрытие, Батчи);

	Артефакты = Новый Структура;
	Артефакты.Вставить("runDir",       КаталогПрогона);
	Артефакты.Вставить("batchesJson",  ПутьBatches);
	Артефакты.Вставить("allureDir",    КаталогAllure);
	Артефакты.Вставить("fixturesJson", ?(ПустаяСтрока(Покрытие.ПутьФикстур),
		"", Покрытие.ПутьФикстур));
	Артефакты.Вставить("summaryJson",  КаталогПрогона + "/" + "summary.json");
	Артефакты.Вставить("summaryMd",    КаталогПрогона + "/" + "summary.md");

	Итог = Новый Структура;
	Итог.Вставить("runId",       ИдПрогона);
	Итог.Вставить("generatedAt", СтрокаДатыISO(ТекущаяДатаСеанса()));
	Итог.Вставить("runDir",       КаталогПрогона);
	Итог.Вставить("totals",       Итоги);
	Итог.Вставить("batches",      БатчиСводно);
	Итог.Вставить("scenarios",    Сценарии);
	Итог.Вставить("arms",         АРМы);
	Итог.Вставить("passwords",    Пароли);
	Итог.Вставить("coverage",     Покрытие.Секция);
	Итог.Вставить("artifacts",    Артефакты);

	ПутьJSON = КаталогПрогона + "/" + "summary.json";
	ПутьMD = КаталогПрогона + "/" + "summary.md";
	ЗаписатьТекстФайла(ПутьJSON, ТекстJSONСтрокой(Итог));
	ТекстMD = ТекстMarkdownОтчета(Итог);
	ЗаписатьТекстФайла(ПутьMD, ТекстMD);

	Результат = Новый Структура;
	Результат.Вставить("ПутьJSON",    ПутьJSON);
	Результат.Вставить("ПутьMD",       ПутьMD);
	Результат.Вставить("ИдПрогона",    ИдПрогона);
	Результат.Вставить("Итоги",        Итоги);
	Результат.Вставить("Сценарии",    Сценарии);
	Результат.Вставить("БатчиСводно",  БатчиСводно);
	Результат.Вставить("ТекстMD",      ТекстMD);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает значение свойства структуры; Null и отсутствие свойства
// заменяются значением по умолчанию.
Функция ЗначениеСвойства(ОбъектДанные, ИмяСвойства, Умолчание)

	Если ОбъектДанные = Неопределено Или ОбъектДанные = Null Тогда
		Возврат Умолчание;
	КонецЕсли;
	Если ТипЗнч(ОбъектДанные) <> Тип("Структура") Тогда
		Возврат Умолчание;
	КонецЕсли;

	Значение = Умолчание;
	Если ОбъектДанные.Свойство(ИмяСвойства, Значение) Тогда
		Если Значение = Null Тогда
			Возврат Умолчание;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	Возврат Умолчание;
КонецФункции

// Нормализует путь: обратные слэши -> прямые, без концевого слэша.
Функция НормализоватьПуть(Значение)

	Результат = СокрЛП(Значение);
	Результат = СтрЗаменить(Результат, "\", "/");
	Если СтрДлина(Результат) > 1 И Прав(Результат, 1) = "/" Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Разрешает путь относительно каталога проекта.
Функция ПолныйПуть(Проект, Путь)

	Результат = НормализоватьПуть(Путь);
	Если ПустаяСтрока(Результат) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрДлина(Результат) >= 2 И Сред(Результат, 2, 1) = ":" Тогда
		Возврат Результат;
	КонецЕсли;
	Если СтрНачинаетсяС(Результат, "//") Тогда
		Возврат Результат;
	КонецЕсли;
	Возврат НормализоватьПуть(Проект) + "/" + Результат;
КонецФункции

Функция КаталогСуществуетФ(Путь)

	Если ПустаяСтрока(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;
	ФайлПуть = Новый Файл(Путь);
	Возврат ФайлПуть.Существует() И ФайлПуть.ЭтоКаталог();
КонецФункции

Функция ФайлСуществуетФ(Путь)

	Если ПустаяСтрока(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;
	ФайлПуть = Новый Файл(Путь);
	Возврат ФайлПуть.Существует() И ФайлПуть.ЭтоКаталог() = Ложь;
КонецФункции

Функция СтрокаДатыISO(ЗначениеДаты)

	Возврат Формат(ЗначениеДаты, "ДФ=yyyy-MM-dd") + "T" + Формат(ЗначениеДаты, "ДФ=HH:mm:ss");
КонецФункции

Функция ПрочитатьJSONФайл(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Попытка
		Результат = ПрочитатьJSON(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Процедура ЗаписатьJSONФайл(Путь, Данные)

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь);
	Попытка
		ЗаписатьJSON(Запись, Данные);
	Исключение
		Запись.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Запись.Закрыть();
КонецПроцедуры

Функция СписокСодержит(Список, Значение)

	Для Каждого Элемент Из Список Цикл
		Если Элемент = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Дата из JSON-строки: форматы yyyy-MM-dd, yyyy-MM-ddTHH:mm:ss, ГГГГММДД...
Функция ДатаИзСтрокиJSON(СтрокаДаты)

	Строка = СокрЛП(СтрокаДаты);
	Если ПустаяСтрока(Строка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Только = "";
	Для НомерСимвола = 1 По СтрДлина(Строка) Цикл
		СимволСтроки = Сред(Строка, НомерСимвола, 1);
		Если СимволСтроки >= "0" И СимволСтроки <= "9" Тогда
			Только = Только + СимволСтроки;
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Только) < 8 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Дата(Лев(Только, 14));
КонецФункции

Функция ЭтоУУИДСтрокой(Значение)

	Возврат СтрДлина(СокрЛП(Значение)) = 36
		И Сред(Значение, 9, 1) = "-" И Сред(Значение, 14, 1) = "-"
		И Сред(Значение, 19, 1) = "-" И Сред(Значение, 24, 1) = "-";
КонецФункции

// Читает файл фильтров и приводит его к внутренней структуре.
// Фильтры: organization, period{from,to}, docTypes[], users[], refs[].
Функция ПрочитатьФильтры(ПутьФильтров)

	Фильтры = Новый Структура;
	Фильтры.Вставить("Организация",    Неопределено);
	Фильтры.Вставить("ДатаС",         Неопределено);
	Фильтры.Вставить("ДатаПо",        Неопределено);
	Фильтры.Вставить("Типы",           Неопределено);
	Фильтры.Вставить("Пользователи",   Неопределено);
	Фильтры.Вставить("Ссылки",         Неопределено);
	Фильтры.Вставить("Эхо",            Новый Структура);

	ПутьФильтров = СокрЛП(ПутьФильтров);
	Если ПустаяСтрока(ПутьФильтров) Или Не ФайлСуществуетФ(ПутьФильтров) Тогда
		Возврат Фильтры;
	КонецЕсли;

	ФайлФильтров = ПрочитатьJSONФайл(ПутьФильтров);
	Если ТипЗнч(ФайлФильтров) <> Тип("Структура") Тогда
		Возврат Фильтры;
	КонецЕсли;

	ОрганизацияСтрока = СокрЛП(ЗначениеСвойства(ФайлФильтров, "organization", ""));
	Если ЗначениеЗаполнено(ОрганизацияСтрока) Тогда
		СсылкаОрганизации = Неопределено;
		Если ЭтоУУИДСтрокой(ОрганизацияСтрока) Тогда
			СсылкаОрганизации = Справочники.Организации.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ОрганизацияСтрока));
		Иначе
			СсылкаОрганизации = Справочники.Организации.НайтиПоНаименованию(
				ОрганизацияСтрока, Истина);
		КонецЕсли;
		Если ЗначениеЗаполнено(СсылкаОрганизации) Тогда
			Фильтры.Организация = СсылкаОрганизации;
		КонецЕсли;
	КонецЕсли;

	Период = ЗначениеСвойства(ФайлФильтров, "period", Неопределено);
	Если Период <> Неопределено Тогда
		ДатаС = ДатаИзСтрокиJSON(ЗначениеСвойства(Период, "from", ""));
		ДатаПо = ДатаИзСтрокиJSON(ЗначениеСвойства(Период, "to", ""));
		Фильтры.ДатаС = ?(ДатаС = Неопределено, Неопределено, НачалоДня(ДатаС));
		Фильтры.ДатаПо = ?(ДатаПо = Неопределено, Неопределено, КонецДня(ДатаПо));
	КонецЕсли;

	Фильтры.Типы         = ПрочитатьМассивСтрок(ФайлФильтров, "docTypes");
	Фильтры.Пользователи = ПрочитатьМассивСтрок(ФайлФильтров, "users");
	Фильтры.Ссылки       = ПрочитатьМассивСтрок(ФайлФильтров, "refs");

	Эхо = Новый Структура;
	Эхо.Вставить("organization", ОрганизацияСтрока);
	Если Период <> Неопределено Тогда
		Эхо.Вставить("period", Период);
	КонецЕсли;
	Если Фильтры.Типы <> Неопределено Тогда
		Эхо.Вставить("docTypes", Фильтры.Типы);
	КонецЕсли;
	Если Фильтры.Пользователи <> Неопределено Тогда
		Эхо.Вставить("users", Фильтры.Пользователи);
	КонецЕсли;
	Если Фильтры.Ссылки <> Неопределено Тогда
		Эхо.Вставить("refs", Фильтры.Ссылки);
	КонецЕсли;
	Фильтры.Эхо = Эхо;

	Возврат Фильтры;
КонецФункции

Функция ПрочитатьМассивСтрок(ОбъектДанные, ИмяСвойства)

	Значение = ЗначениеСвойства(ОбъектДанные, ИмяСвойства, Неопределено);
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Если Элемент <> Null И Элемент <> Неопределено Тогда
			Результат.Добавить(СокрЛП(Строка(Элемент)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Запрос объединением по типам документов из карты (только проведённые).
Функция ВыбратьДокументы(ДокументыКарта, Фильтры)

	Запрос = Новый Запрос;
	ТекстЗапроса = "";
	ЕстьЧасть = Ложь;

	Для Каждого КлючЗначение Из ДокументыКарта Цикл
		ТипДокумента = КлючЗначение.Ключ;
		Если Фильтры.Типы <> Неопределено И Не СписокСодержит(Фильтры.Типы, ТипДокумента) Тогда
			Продолжить;
		КонецЕсли;

		Часть = "ВЫБРАТЬ """ + ТипДокумента + """ КАК ТипДокумента,"
			+ " Т.Ссылка КАК Ссылка,"
			+ " Т.Номер КАК Номер,"
			+ " Т.Дата КАК ДатаДокумента,"
			+ " Т.Автор КАК Автор"
			+ " ИЗ Документ." + ТипДокумента + " КАК Т"
			+ " ГДЕ Т.Проведен";
		Если Фильтры.Организация <> Неопределено Тогда
			Часть = Часть + " И Т.Организация = &Организация";
		КонецЕсли;
		Если Фильтры.ДатаС <> Неопределено Тогда
			Часть = Часть + " И Т.Дата >= &ДатаС";
		КонецЕсли;
		Если Фильтры.ДатаПо <> Неопределено Тогда
			Часть = Часть + " И Т.Дата <= &ДатаПо";
		КонецЕсли;

		Если ЕстьЧасть Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + Часть;
		ЕстьЧасть = Истина;
	КонецЦикла;

	Если Не ЕстьЧасть Тогда
		ВызватьИсключение НСтр("ru = 'Не выбран ни один тип документа (фильтр docTypes)'");
	КонецЕсли;

	Если Фильтры.Организация <> Неопределено Тогда
		Запрос.Установить("Организация", Фильтры.Организация);
	КонецЕсли;
	Если Фильтры.ДатаС <> Неопределено Тогда
		Запрос.Установить("ДатаС", Фильтры.ДатаС);
	КонецЕсли;
	Если Фильтры.ДатаПо <> Неопределено Тогда
		Запрос.Установить("ДатаПо", Фильтры.ДатаПо);
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ПрошелПостФильтры(Выборка, Фильтры) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаДок = Новый Структура;
		СтрокаДок.Вставить("ТипДокумента",  Выборка.ТипДокумента);
		СтрокаДок.Вставить("Ссылка",         Выборка.Ссылка);
		СтрокаДок.Вставить("Номер",          Выборка.Номер);
		СтрокаДок.Вставить("ДатаДокумента", Выборка.ДатаДокумента);
		СтрокаДок.Вставить("Автор",          Выборка.Автор);
		СтрокаДок.Вставить("Момент",         Выборка.Ссылка.МоментВремени());
		Результат.Добавить(СтрокаДок);
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Пост-фильтры users[] (UUID или имя автора) и refs[] (UUID документа).
Функция ПрошелПостФильтры(Выборка, Фильтры)

	Если Фильтры.Пользователи <> Неопределено Тогда
		ИдентификаторАвтор = Строка(Выборка.Автор.УникальныйИдентификатор());
		Если Не СписокСодержит(Фильтры.Пользователи, ИдентификаторАвтор)
			И Не СписокСодержит(Фильтры.Пользователи, СокрЛП(Строка(Выборка.Автор))) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Фильтры.Ссылки <> Неопределено Тогда
		Если Не СписокСодержит(Фильтры.Ссылки,
			Строка(Выборка.Ссылка.УникальныйИдентификатор())) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Вычисляет значения всех осей одного документа.
// Возвращает Соответствие: имя оси (attribute) -> массив значений-строк.
Функция ВычислитьОсиДокумента(ОбъектДок, ОпределениеТипа, КэшПеречислений)

	Результат = Новый Соответствие;
	ОсиТипа = ЗначениеСвойства(ОпределениеТипа, "axes", Неопределено);
	Если ОсиТипа = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ЗависимыеОси = Новый Массив;
	Для Каждого Ось Из ОсиТипа Цикл
		Если ЗначениеСвойства(Ось, "appliesWhen", "") <> "" Тогда
			ЗависимыеОси.Добавить(Ось);
			Продолжить;
		КонецЕсли;
		ИмяОси = ЗначениеСвойства(Ось, "attribute", "");
		Результат.Вставить(ИмяОси, ЗначенияОсиДокумента(ОбъектДок, Ось, КэшПеречислений));
	КонецЦикла;

	Для Каждого Ось Из ЗависимыеОси Цикл
		Условие = СокрЛП(ЗначениеСвойства(Ось, "appliesWhen", ""));
		Части = СтрРазделить(Условие, "=");
		Если Части.Количество() = 2 Тогда
			ОсьУсловия = СокрЛП(Части[0]);
			ЗначениеУсловия = СокрЛП(Части[1]);
			ЗначенияОсиУсловия = Результат.Получить(ОсьУсловия);
			Если ЗначенияОсиУсловия = Неопределено
				Или Не СписокСодержит(ЗначенияОсиУсловия, ЗначениеУсловия) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ИмяОси = ЗначениеСвойства(Ось, "attribute", "");
		Результат.Вставить(ИмяОси, ЗначенияОсиДокумента(ОбъектДок, Ось, КэшПеречислений));
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Значения одной оси для одного документа по axis.where:
// "header" | "tabular.<ИмяТЧ>" | "catalog".
Функция ЗначенияОсиДокумента(ОбъектДок, Ось, КэшПеречислений)

	Значения = Новый Массив;

	ИмяАтрибута = ЗначениеСвойства(Ось, "attribute", "");
	Если ПустаяСтрока(ИмяАтрибута) Тогда
		Возврат Значения;
	КонецЕсли;
	Где    = ЗначениеСвойства(Ось, "where", "");
	ТипОси = ЗначениеСвойства(Ось, "type", "");

	Если Где = "header" Тогда
		СтрЗначение = СтрокаЗначенияОси(ОбъектДок[ИмяАтрибута], ТипОси, КэшПеречислений);
		Если ЗначениеЗаполнено(СтрЗначение) Тогда
			Значения.Добавить(СтрЗначение);
		КонецЕсли;
	ИначеЕсли СтрНачинаетсяС(Где, "tabular.") Тогда
		ИмяТЧ = Сред(Где, 9);
		ТабличнаяЧасть = ОбъектДок[ИмяТЧ];
		Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
			СтрЗначение = СтрокаЗначенияОси(СтрокаТЧ[ИмяАтрибута], ТипОси, КэшПеречислений);
			Если ЗначениеЗаполнено(СтрЗначение) И Не СписокСодержит(Значения, СтрЗначение) Тогда
				Значения.Добавить(СтрЗначение);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Где = "catalog" Тогда
		ПолеДок    = ЗначениеСвойства(Ось, "docField", "");
		ПутьЗначения = ЗначениеСвойства(Ось, "valuePath", "");
		СсылкиКаталога = Новый Массив;
		Если ЗначениеЗаполнено(ОбъектДок[ПолеДок]) Тогда
			СсылкиКаталога.Добавить(ОбъектДок[ПолеДок]);
		КонецЕсли;
		ИсточникиТЧ = ЗначениеСвойства(Ось, "tabularSources", Неопределено);
		Если ИсточникиТЧ <> Неопределено Тогда
			Для Каждого ИмяТЧ Из ИсточникиТЧ Цикл
				ТабличнаяЧасть = ОбъектДок[ИмяТЧ];
				Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
					Если ЗначениеЗаполнено(СтрокаТЧ[ПолеДок]) Тогда
						СсылкиКаталога.Добавить(СтрокаТЧ[ПолеДок]);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		Обработанные = Новый Соответствие;
		Для Каждого СсылкаКаталога Из СсылкиКаталога Цикл
			Ключ = Строка(СсылкаКаталога);
			Если Обработанные.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Обработанные.Вставить(Ключ, Истина);
			ЗначениеПути = ЗначениеПоПути(СсылкаКаталога, ПутьЗначения);
			СтрЗначение = СтрокаЗначенияОси(ЗначениеПути, ТипОси, КэшПеречислений);
			Если ЗначениеЗаполнено(СтрЗначение) И Не СписокСодержит(Значения, СтрЗначение) Тогда
				Значения.Добавить(СтрЗначение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Значения;
КонецФункции

// Значение оси в строковом виде: Boolean -> true/false,
// Enum.<Имя> -> имя значения перечисления.
Функция СтрокаЗначенияОси(Значение, ТипОси, КэшПеречислений)

	Если ТипОси = "Boolean" Тогда
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат ?(Значение <> 0, "true", "false");
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат ?(Значение, "true", "false");
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Если СтрНачинаетсяС(ТипОси, "Enum.") Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат "";
		КонецЕсли;
		Возврат ИмяЗначенияПеречисления(Значение, Сред(ТипОси, 6), КэшПеречислений);
	КонецЕсли;

	Возврат "";
КонецФункции

// Читает значение по пути "АпкМодель.ВидАвтотранспорта" чтением в коде:
// композитные типы через точку в запросе недопустимы (TD-007).
Функция ЗначениеПоПути(СсылкаНачальная, ПутьЗначения)

	Если ПустаяСтрока(ПутьЗначения) Или Не ЗначениеЗаполнено(СсылкаНачальная) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сегменты = СтрРазделить(ПутьЗначения, ".");
	ТекущийОбъект = СсылкаНачальная.ПолучитьОбъект();
	Если ТекущийОбъект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Индекс = 0 По Сегменты.ВГраница() Цикл
		ЗначениеСегмента = ТекущийОбъект[Сегменты[Индекс]];
		Если Индекс = Сегменты.ВГраница() Тогда
			Возврат ЗначениеСегмента;
		КонецЕсли;
		ТекущийОбъект = ЗначениеСегмента.ПолучитьОбъект();
		Если ТекущийОбъект = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

// Имя значения перечисления по ссылке (XMLСтрока, TD-007; s2-T5-фикс).
// В 8.5 коллекция значений в метаданных называется ЗначенияПеречисления,
// а обращения Метаданные.Перечисления[Имя].Значения / Перечисления[Имя][Имя]
// из кода не работают (исключение гасилось Попыткой - все Enum-оси скана
// были пустые). XMLСтрока сериализует значение перечисления его ИМЕНЕМ
// (доказано COM-зондом 8.5.4: ПрямыеЗатраты, ОбщепроизводственныеЗатраты).
Функция ИмяЗначенияПеречисления(ЗначениеПеречисления, ИмяПеречисления, КэшПеречислений)

	КлючКэша = ИмяПеречисления + "|" + Строка(ЗначениеПеречисления);
	КэшированноеЗначение = КэшПеречислений.Получить(КлючКэша);
	Если КэшированноеЗначение <> Неопределено Тогда
		Возврат КэшированноеЗначение;
	КонецЕсли;

	Результат = "";
	Попытка
		Результат = СокрЛП(XMLСтрока(ЗначениеПеречисления));
	Исключение
		Результат = "";
	КонецПопытки;

	КэшПеречислений.Вставить(КлючКэша, Результат);
	Возврат Результат;
КонецФункции

// Сопоставление «осень-значение» для одного типа документа:
// представитель = документ с минимальным МоментомВремени (TD-002).
Процедура ВыбратьПредставителейТипа(ТипДокумента, ОпределениеТипа, Найденные,
	ПредставителиПоКлючу, Пробелы)

	ОсиТипа = ЗначениеСвойства(ОпределениеТипа, "axes", Неопределено);
	Если ОсиТипа = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДокументыТипа = Новый Массив;
	Для Каждого Документ Из Найденные Цикл
		Если Документ.ТипДокумента = ТипДокумента Тогда
			ДокументыТипа.Добавить(Документ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Ось Из ОсиТипа Цикл
		ИмяОси = ЗначениеСвойства(Ось, "attribute", "");
		ОжидаемыеЗначения = ЗначениеСвойства(Ось, "values", Неопределено);
		Если ОжидаемыеЗначения = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Зависимая ось (appliesWhen): если условие не выполнено ни у одного
		// документа типа - пробел не фиксируется.
		Если ЗначениеСвойства(Ось, "appliesWhen", "") <> "" Тогда
			Если Не ОсьПрименима(Ось, ДокументыТипа) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Для Каждого Ожидаемое Из ОжидаемыеЗначения Цикл
			ЛучшийДокумент = Неопределено;
			ЛучшийМомент = Неопределено;
			Для Каждого Документ Из ДокументыТипа Цикл
				ЗначенияОси = Документ.Оси.Получить(ИмяОси);
				Если ЗначенияОси = Неопределено Или Не СписокСодержит(ЗначенияОси, Ожидаемое) Тогда
					Продолжить;
				КонецЕсли;
				Если ЛучшийДокумент = Неопределено Тогда
					ЛучшийДокумент = Документ;
					ЛучшийМомент = Документ.Момент;
				Иначе
					// МоментВремени - не примитив: только метод Сравнить (TD-002).
					СравнениеМоментов = Документ.Момент.Сравнить(ЛучшийМомент);
					Если СравнениеМоментов < 0
						Или (СравнениеМоментов = 0
							И Строка(Документ.Ссылка) < Строка(ЛучшийДокумент.Ссылка)) Тогда
						ЛучшийДокумент = Документ;
						ЛучшийМомент = Документ.Момент;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

			Если ЛучшийДокумент = Неопределено Тогда
				Пробелы.Добавить(Новый Структура("type, axis, value", ТипДокумента, ИмяОси, Ожидаемое));
			Иначе
				КлючПредставителя = Строка(ЛучшийДокумент.Ссылка);
				Представитель = ПредставителиПоКлючу.Получить(КлючПредставителя);
				Если Представитель = Неопределено Тогда
					Представитель = Новый Структура;
					Представитель.Вставить("type",   ЛучшийДокумент.ТипДокумента);
					Представитель.Вставить("ref",   Строка(ЛучшийДокумент.Ссылка.УникальныйИдентификатор()));
					Представитель.Вставить("number", ЛучшийДокумент.Номер);
					Представитель.Вставить("author", Строка(ЛучшийДокумент.Автор.УникальныйИдентификатор()));
					Представитель.Вставить("date",   СтрокаДатыISO(ЛучшийДокумент.ДатаДокумента));
					Представитель.Вставить("cells",  Новый Массив);
					ПредставителиПоКлючу.Вставить(КлючПредставителя, Представитель);
				КонецЕсли;
				Ячейки = Представитель.cells;
				Ячейки.Добавить(Новый Структура("axis, value", ИмяОси, Ожидаемое));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Проверяет appliesWhen "Ось = Значение" по документам типа.
Функция ОсьПрименима(Ось, ДокументыТипа)

	Условие = СокрЛП(ЗначениеСвойства(Ось, "appliesWhen", ""));
	Части = СтрРазделить(Условие, "=");
	Если Части.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	ОсьУсловия = СокрЛП(Части[0]);
	ЗначениеУсловия = СокрЛП(Части[1]);
	Для Каждого Документ Из ДокументыТипа Цикл
		ЗначенияОсиУсловия = Документ.Оси.Получить(ОсьУсловия);
		Если ЗначенияОсиУсловия <> Неопределено
			И СписокСодержит(ЗначенияОсиУсловия, ЗначениеУсловия) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Сопоставление: автор -> ПользователиИнформационнойБазы (TD-007).
// Возвращает структуру: Записи - массив пользователей по контракту scan.json.
Функция СопоставитьПользователей(ПредставителиПоКлючу)

	Авторы = Новый Соответствие;
	Для Каждого КлючЗначение Из ПредставителиПоКлючу Цикл
		Авторы.Вставить(КлючЗначение.Значение.author, Неопределено);
	КонецЦикла;

	Записи = Новый Массив;
	Для Каждого КлючЗначение Из Авторы Цикл
		Записи.Добавить(ЗаписьПользователя(КлючЗначение.Ключ));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Записи", Записи);
	Возврат Результат;
КонецФункции

Функция ЗаписьПользователя(ИдентификаторАвтор)

	Автор = Справочники.Пользователи.ПолучитьСсылку(
		Новый УникальныйИдентификатор(ИдентификаторАвтор));

	Запись = Новый Структура;
	Запись.Вставить("author",      ИдентификаторАвтор);
	Запись.Вставить("authorName",  "");
	Запись.Вставить("ibName",      "");
	Запись.Вставить("hasPassword", Ложь);
	Запись.Вставить("standardAuth", Истина);
	Запись.Вставить("excluded",    Истина);
	Запись.Вставить("reason",      "");

	Если Не ЗначениеЗаполнено(Автор) Тогда
		Запись.reason = НСтр("ru = 'Не найден элемент справочника Пользователи'");
		Возврат Запись;
	КонецЕсли;

	Запись.authorName = Строка(Автор);
	ОбъектАвтор = Автор.ПолучитьОбъект();
	Если ОбъектАвтор = Неопределено Тогда
		Запись.reason = НСтр("ru = 'Не найден автор: '") + Строка(Автор);
		Возврат Запись;
	КонецЕсли;

	ИдентификаторПользователяИБ = ОбъектАвтор["ИдентификаторПользователяИБ"];
	Если Не ЗначениеЗаполнено(ИдентификаторПользователяИБ) Тогда
		Запись.reason = НСтр("ru = 'У автора не заполнен ИдентификаторПользователяИБ'");
		Возврат Запись;
	КонецЕсли;

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(
		ИдентификаторПользователяИБ);
	Если ПользовательИБ = Неопределено Тогда
		Запись.reason = НСтр("ru = 'Пользователь ИБ не найден по идентификатору'");
		Возврат Запись;
	КонецЕсли;

	Запись.ibName = ПользовательИБ.Имя;
	Запись.hasPassword = ПользовательИБ.ПарольУстановлен;
	Запись.standardAuth = ПользовательИБ.АутентификацияСтандартная;
	Запись.excluded = Не ПользовательИБ.АутентификацияСтандартная;
	Если Запись.excluded Тогда
		Запись.reason = НСтр("ru = 'У пользователя ИБ выключена стандартная аутентификация'");
	КонецЕсли;

	Возврат Запись;
КонецФункции

// Читает общие данные прогона: run.json, scan.json и карту покрытия.
Функция ПрочитатьКонтекстПрогона(КаталогПрогона)

	КаталогПрогона = НормализоватьПуть(СокрЛП(КаталогПрогона));
	Если ПустаяСтрока(КаталогПрогона) Или Не КаталогСуществуетФ(КаталогПрогона) Тогда
		ВызватьИсключение НСтр("ru = 'Каталог прогона не найден: '") + КаталогПрогона;
	КонецЕсли;

	ДанныеПрогона = ПрочитатьJSONФайл(КаталогПрогона + "/" + "run.json");
	Если ТипЗнч(ДанныеПрогона) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'В каталоге прогона нет корректного run.json'");
	КонецЕсли;

	ПутьСкана = КаталогПрогона + "/" + "scan.json";
	Если Не ФайлСуществуетФ(ПутьСкана) Тогда
		ВызватьИсключение НСтр("ru = 'В каталоге прогона нет scan.json (сначала выполните сканирование)'");
	КонецЕсли;
	Скан = ПрочитатьJSONФайл(ПутьСкана);

	Пути = ЗначениеСвойства(ДанныеПрогона, "paths", Новый Структура);
	ПутьКарты = ЗначениеСвойства(Пути, "coverageMap", "");
	Если ПустаяСтрока(ПутьКарты) Или Не ФайлСуществуетФ(ПутьКарты) Тогда
		ВызватьИсключение НСтр("ru = 'Не найдена карта покрытия: '") + ПутьКарты;
	КонецЕсли;
	Карта = ПрочитатьJSONФайл(ПутьКарты);
	ДокументыКарта = ЗначениеСвойства(Карта, "documents", Новый Структура);
	Если ТипЗнч(ДокументыКарта) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'В карте покрытия нет секции documents'");
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("КаталогПрогона",  КаталогПрогона);
	Контекст.Вставить("ИдПрогона",      ЗначениеСвойства(ДанныеПрогона, "runId", ""));
	Контекст.Вставить("Настройки",      ЗначениеСвойства(ДанныеПрогона, "settings", Новый Структура));
	Контекст.Вставить("Скан",           Скан);
	Контекст.Вставить("Карта",          Карта);
	Контекст.Вставить("ДокументыКарта", ДокументыКарта);
	Возврат Контекст;
КонецФункции

// Проверяет условие arms.when ("always" | "Ось = Значение")
// по ячейкам покрытия документа-представителя.
Функция УсловиеАРМаВыполнено(Условие, Ячейки)

	Условие = СокрЛП(Условие);
	Если ПустаяСтрока(Условие) Или Условие = "always" Тогда
		Возврат Истина;
	КонецЕсли;
	// "never" - АРМ отклонен (девиация, см. tasks.md T8/arm-fuel-expense):
	// не включается в план, шаблон существует, но в прогон не попадает.
	Если Условие = "never" Тогда
		Возврат Ложь;
	КонецЕсли;
	Части = СтрРазделить(Условие, "=");
	Если Части.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	ОсьУсловия = СокрЛП(Части[0]);
	ЗначениеУсловия = СокрЛП(Части[1]);
	Для Каждого Ячейка Из Ячейки Цикл
		Если СокрЛП(ЗначениеСвойства(Ячейка, "axis", "")) = ОсьУсловия
			И СокрЛП(ЗначениеСвойства(Ячейка, "value", "")) = ЗначениеУсловия Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Возвращает (создавая) запись плана АРМа для пары пользователь x АРМ.
Функция ЗаписьПланаАРМа(ПланАРМовПоКлючу, Пользователь, АРМ)

	ИмяАРМа = СокрЛП(ЗначениеСвойства(АРМ, "arm", ""));
	ИмяПользователя = ЗначениеСвойства(Пользователь, "ibName", "");
	Ключ = ИмяПользователя + "|" + ИмяАРМа;

	ЗаписьАРМа = ПланАРМовПоКлючу.Получить(Ключ);
	Если ЗаписьАРМа = Неопределено Тогда
		ЗаписьАРМа = Новый Структура;
		ЗаписьАРМа.Вставить("user",      ИмяПользователя);
		ЗаписьАРМа.Вставить("arm",       ИмяАРМа);
		ЗаписьАРМа.Вставить("docTypes",  Новый Массив);
		ЗаписьАРМа.Вставить("reasons",   Новый Массив);
		ЗаписьАРМа.Вставить("templates", Новый Массив);
		ПланАРМовПоКлючу.Вставить(Ключ, ЗаписьАРМа);
	КонецЕсли;
	Возврат ЗаписьАРМа;
КонецФункции

// Уникальные типы документов из массива представителей.
Функция ТипыДокументовПользователя(ДокументыПользователя)

	Типы = Новый Массив;
	Для Каждого Представитель Из ДокументыПользователя Цикл
		ТипДокумента = СокрЛП(ЗначениеСвойства(Представитель, "type", ""));
		Если Не ПустаяСтрока(ТипДокумента) И Не СписокСодержит(Типы, ТипДокумента) Тогда
			Типы.Добавить(ТипДокумента);
		КонецЕсли;
	КонецЦикла;
	Возврат Типы;
КонецФункции

// Данные документа-представителя: шапка + до МаксимумСтрок строк каждой
// ТЧ по fieldList карты (D-004). Возвращает {header, tabular}.
Функция ДанныеДокументаФикстуры(ОбъектДок, ОпределениеТипа, МаксимумСтрок)

	СписокПолей = ЗначениеСвойства(ОпределениеТипа, "fieldList", Новый Структура);

	Шапка = Новый Структура;
	ПоляШапки = ЗначениеСвойства(СписокПолей, "header", Неопределено);
	Если ПоляШапки <> Неопределено И ТипЗнч(ПоляШапки) = Тип("Массив") Тогда
		Для Каждого Поле Из ПоляШапки Цикл
			ИмяПоля = СокрЛП(Строка(Поле));
			ДобавитьПолеФикстуры(Шапка, ИмяПоля, ОбъектДок[ИмяПоля]);
			ДобавитьОбъектЗатратТекущегоПериода(Шапка, ИмяПоля, ОбъектДок[ИмяПоля]);
		КонецЦикла;
	КонецЕсли;

	ТабличныеДанные = Новый Структура;
	ТЧКарта = ЗначениеСвойства(СписокПолей, "tabular", Неопределено);
	Если ТЧКарта <> Неопределено И ТипЗнч(ТЧКарта) = Тип("Структура") Тогда
		Для Каждого КлючЗначение Из ТЧКарта Цикл
			ИмяТЧ = СокрЛП(КлючЗначение.Ключ);
			ПоляТЧ = КлючЗначение.Значение;
			СтрокиТЧ = Новый Массив;
			Если ТипЗнч(ПоляТЧ) = Тип("Массив") Тогда
				ДобавленоСтрок = 0;
				Для Каждого СтрокаТЧ Из ОбъектДок[ИмяТЧ] Цикл
					Если ДобавленоСтрок >= МаксимумСтрок Тогда
						Прервать;
					КонецЕсли;
					ДанныеСтроки = Новый Структура;
					Для Каждого Поле Из ПоляТЧ Цикл
						ИмяПоля = СокрЛП(Строка(Поле));
						ДобавитьПолеФикстуры(ДанныеСтроки, ИмяПоля, СтрокаТЧ[ИмяПоля]);
						ДобавитьПроизводноеПолеФикстуры(ДанныеСтроки, ОпределениеТипа, ИмяПоля, СтрокаТЧ[ИмяПоля]);
						ДобавитьОбъектЗатратТекущегоПериода(ДанныеСтроки, ИмяПоля, СтрокаТЧ[ИмяПоля]);
					КонецЦикла;
					Если ДанныеСтроки.Количество() > 0 Тогда
						СтрокиТЧ.Добавить(ДанныеСтроки);
						ДобавленоСтрок = ДобавленоСтрок + 1;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			ТабличныеДанные.Вставить(ИмяТЧ, СтрокиТЧ);
		КонецЦикла;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("header",   Шапка);
	Данные.Вставить("tabular", ТабличныеДанные);
	Возврат Данные;
КонецФункции

// Добавляет поле фикстуры, пропуская даты и пустые значения (D-005).
Процедура ДобавитьПолеФикстуры(Приемник, ИмяПоля, Значение)

	ЗначениеФикстуры = ЗначениеФикстурыЗначения(Значение);
	Если ЗначениеФикстуры <> Неопределено Тогда
		Приемник.Вставить(ИмяПоля, ЗначениеФикстуры);
	КонецЕсли;
КонецПроцедуры


// Производное поле фикстуры по карте соответствий значений (valueMaps
// карты покрытия): для поля с картой добавляет ключ <Поле>Список с
// отображенным представлением значения (T8 NB: представление элемента
// СПИСКА ВЫБОРА может отличаться от представления перечисления -
// см. АпкРастениеводствоСервер.СформироватьСписокВыбораТипаЗатрат:
// "Прямые затраты" в списке выбора выглядит как "На прямые затраты").
Процедура ДобавитьПроизводноеПолеФикстуры(Приемник, ОпределениеТипа, ИмяПоля, Значение)

	КартыЗначений = ЗначениеСвойства(ОпределениеТипа, "valueMaps", Неопределено);
	Если ТипЗнч(КартыЗначений) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Карта = Неопределено;
	Если Не КартыЗначений.Свойство(ИмяПоля, Карта) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Карта) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ключ = СокрЛП(Строка(Значение));
	Для Каждого Пара Из Карта Цикл
		Если ТипЗнч(Пара) <> Тип("Массив") Или Пара.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Если СокрЛП(Строка(Пара[0])) = Ключ Тогда
			Приемник.Вставить(ИмяПоля + "Список", СокрЛП(Строка(Пара[1])));
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
// Производное поле фикстуры: объект затрат ТЕКУЩЕГО периода для
// АналитикаРасходов строки ТЧ и Откуда шапки (<Поле>Текущий).
// Сценарий вводится текущей датой
// текущей датой (ДатаСценария), а период действия аналитики
// представителя к текущей дате истек: по тому же полю (АпкПоле
// аналитики) ищется покрывающий дату сценария объект затрат в
// РегистреСведений.АпкИсторияПолей_ДанныеДляПодбора - шаг выбора
// аналитики (UI Automation двойной клик в окне «Объекты затрат»)
// берет это значение (T8).
Процедура ДобавитьОбъектЗатратТекущегоПериода(Приемник, ИмяПоля, Значение)

	Если ИмяПоля <> "АналитикаРасходов" И ИмяПоля <> "Откуда" Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("СправочникСсылка.СтруктураПредприятия") Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДанныеДляПодбора.ОбъектЗатрат КАК ОбъектЗатрат
		|ИЗ
		|	РегистрСведений.АпкИсторияПолей_ДанныеДляПодбора КАК ДанныеДляПодбора
		|ГДЕ
		|	ДанныеДляПодбора.Поле В (
		|		ВЫБРАТЬ
		|			Объекты.АпкПоле
		|		ИЗ
		|			Справочник.СтруктураПредприятия КАК Объекты
		|		ГДЕ
		|			Объекты.Ссылка = &Аналитика)
		|	И ДанныеДляПодбора.НачалоПериодаАктуальности <= &Дата
		|	И ДанныеДляПодбора.КонецПериодаАктуальности > &Дата
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДанныеДляПодбора.НачалоПериодаАктуальности УБЫВ";
	Запрос.УстановитьПараметр("Аналитика", Значение);
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Приемник.Вставить(ИмяПоля + "Текущий", СокрЛП(Строка(Выборка.ОбъектЗатрат)));
	КонецЕсли;
КонецПроцедуры

// Значение поля фикстуры: ссылки - {uuid, presentation},
// булево/число/строка - как есть, даты - Неопределено (без дат).
Функция ЗначениеФикстурыЗначения(Значение)

	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗначения = Тип("Строка") Тогда
		Если ПустаяСтрока(Значение) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат СокрЛП(Значение);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Идентификатор = Строка(Значение.УникальныйИдентификатор());
	Исключение
		Возврат СокрЛП(Строка(Значение));
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("uuid",         Идентификатор);
	Результат.Вставить("presentation", Строка(Значение));
	Возврат Результат;
КонецФункции

// Покрытие документа из ячеек представителей: ось -> значение,
// "true"/"false" -> булево, мульти-значения -> массив.
Функция ПокрытиеДокумента(Ячейки)

	Покрытие = Новый Структура;
	Для Каждого Ячейка Из Ячейки Цикл
		Ось = СокрЛП(ЗначениеСвойства(Ячейка, "axis", ""));
		Если ПустаяСтрока(Ось) Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеОсиТипизированное(СокрЛП(ЗначениеСвойства(Ячейка, "value", "")));
		Существующее = Неопределено;
		Если Покрытие.Свойство(Ось, Существующее) Тогда
			Если ТипЗнч(Существующее) = Тип("Массив") Тогда
				Если Не СписокСодержит(Существующее, Значение) Тогда
					Существующее.Добавить(Значение);
				КонецЕсли;
			Иначе
				МассивЗначений = Новый Массив;
				МассивЗначений.Добавить(Существующее);
				Если Существующее <> Значение Тогда
					МассивЗначений.Добавить(Значение);
				КонецЕсли;
				Покрытие.Вставить(Ось, МассивЗначений);
			КонецЕсли;
		Иначе
			Покрытие.Вставить(Ось, Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Покрытие;
КонецФункции

// Значение оси из JSON в типизированном виде (булево true/false).
Функция ЗначениеОсиТипизированное(Значение)

	Если Значение = "true" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Значение = "false" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Общие данные (organization, subdivision) из шапки документа.
Функция ОбщиеДанные(ОбъектДок)

	Общие = Новый Структура;
	Если ЗначениеЗаполнено(ОбъектДок["Организация"]) Тогда
		Общие.Вставить("organization", Строка(ОбъектДок["Организация"]));
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъектДок["Подразделение"]) Тогда
		Общие.Вставить("subdivision", Строка(ОбъектДок["Подразделение"]));
	КонецЕсли;
	Возврат Общие;
КонецФункции

// Возвращает каталог шаблонов прогона: из run.json (paths.templatesDir)
// либо из настроек (templatesDir относительно projectDir).
Функция КаталогШаблоновПрогона(КаталогПрогона, Настройки)

	ДанныеПрогона = ПрочитатьJSONФайл(КаталогПрогона + "/" + "run.json");
	Если ТипЗнч(ДанныеПрогона) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'В каталоге прогона нет корректного run.json'");
	КонецЕсли;
	Пути = ЗначениеСвойства(ДанныеПрогона, "paths", Новый Структура);
	КаталогШаблонов = СокрЛП(ЗначениеСвойства(Пути, "templatesDir", ""));
	Если ПустаяСтрока(КаталогШаблонов) Тогда
		КаталогШаблонов = СокрЛП(ЗначениеСвойства(Настройки, "templatesDir", ""));
		КаталогШаблонов = ПолныйПуть(СокрЛП(ЗначениеСвойства(Настройки, "projectDir", "")), КаталогШаблонов);
	КонецЕсли;
	КаталогШаблонов = НормализоватьПуть(КаталогШаблонов);
	Если ПустаяСтрока(КаталогШаблонов) Или Не КаталогСуществуетФ(КаталогШаблонов) Тогда
		ВызватьИсключение НСтр("ru = 'Каталог шаблонов не найден: '") + КаталогШаблонов;
	КонецЕсли;
	Возврат КаталогШаблонов;
КонецФункции

// Ищет автора (UUID справочника Пользователи) пользователя ИБ в scan.json.
Функция АвторПользователяИБ(Скан, ИмяПользователяИБ)

	Для Каждого Пользователь Из ЗначениеСвойства(Скан, "users", Новый Массив) Цикл
		Если СокрЛП(ЗначениеСвойства(Пользователь, "ibName", "")) = ИмяПользователяИБ Тогда
			Возврат СокрЛП(ЗначениеСвойства(Пользователь, "author", ""));
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Документы фикстур заданного типа; если задан автор - только его.
Функция ДокументыПользователяПоТипу(ДокументыФикстур, ИдАвтор, ТипДокумента)

	Результат = Новый Массив;
	Для Каждого Документ Из ДокументыФикстур Цикл
		Если СокрЛП(ЗначениеСвойства(Документ, "type", "")) <> ТипДокумента Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(ИдАвтор)
			И СокрЛП(ЗначениеСвойства(Документ, "author", "")) <> ИдАвтор Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Документ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Имя типа документа карты, чей шаблон сценария равен заданному.
Функция ТипДокументаШаблона(ДокументыКарта, ИмяШаблона)

	Для Каждого ТипИзКарты Из ДокументыКарта Цикл
		Определение = ТипИзКарты.Значение;
		Если ТипЗнч(Определение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если СокрЛП(ЗначениеСвойства(Определение, "template", "")) = ИмяШаблона Тогда
			Возврат ТипИзКарты.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Заголовок формы документа - синоним из метаданных (fallback: имя).
Функция ЗаголовокФормыДокумента(ТипДокумента)

	МетаДокумента = Метаданные.Документы.Найти(ТипДокумента);
	Если МетаДокумента = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не найден документ метаданных: '") + ТипДокумента;
	КонецЕсли;
	Заголовок = МетаДокумента.Синоним;
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = МетаДокумента.Имя;
	КонецЕсли;
	Возврат Заголовок;
КонецФункции

// Генерирует один .feature файл: смоук (пустой список документов -
// один блок сценария без документа) или файл сценария по всем
// представителям, покрываемым шаблоном.
Функция СгенерироватьФайлФичи(КаталогШаблонов, КаталогВыгрузки, ИмяШаблона,
	ИмяФайлаПользователя, ИмяПользователя, Документы, Предупреждения)

	ПутьШаблона = КаталогШаблонов + "/" + ИмяШаблона + ".feature";
	Если Не ФайлСуществуетФ(ПутьШаблона) Тогда
		Предупреждения.Добавить("Шаблон не найден: " + ПутьШаблона);
		Возврат Неопределено;
	КонецЕсли;

	ДокументыШаблона = Документы;
	Если ДокументыШаблона.Количество() = 0 Тогда
		ДокументыШаблона = Новый Массив;
		ДокументыШаблона.Добавить(Неопределено);
	КонецЕсли;

	ТекстФичи = ТекстФичиПоШаблону(ПрочитатьТекстФайла(ПутьШаблона),
		ДокументыШаблона, ИмяПользователя, Предупреждения);
	ПутьВыгрузки = КаталогВыгрузки + "/" + ИмяШаблона + "--" + ИмяФайлаПользователя + ".feature";
	ЗаписатьТекстФайла(ПутьВыгрузки, ТекстФичи);

	Запись = Новый Структура;
	Запись.Вставить("file",      ПутьВыгрузки);
	Запись.Вставить("template",  ИмяШаблона);
	Запись.Вставить("user",      ИмяПользователя);
	Запись.Вставить("scenarios", ДокументыШаблона.Количество());
	ДокументыЗаписи = Новый Массив;
	Для Каждого Документ Из Документы Цикл
		ДокументыЗаписи.Добавить(СокрЛП(ЗначениеСвойства(Документ, "type", ""))
			+ "/" + СокрЛП(ЗначениеСвойства(Документ, "number", "")));
	КонецЦикла;
	Запись.Вставить("documents", ДокументыЗаписи);
	Возврат Запись;
КонецФункции

// Отбрасывает пустые записи манифеста (отсутствующие шаблоны).
Функция БезПустыхЗаписей(Записи)

	Результат = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если Запись <> Неопределено Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Собирает текст фичи: заголовочная часть (до "Сценарий:") + блоки
// сценариев по каждому документу.
Функция ТекстФичиПоШаблону(ТекстШаблона, Документы, ИмяПользователя, Предупреждения)

	СтрокиШаблона = СтрРазделить(ТекстШаблона, Символы.ПС, Истина);
	ИндексСценария = 0;
	Для Индекс = 0 По СтрокиШаблона.Количество() - 1 Цикл
		Если СтрНачинаетсяС(СокрЛП(СтрокиШаблона[Индекс]), "Сценарий:") Тогда
			ИндексСценария = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ИндексСценария = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В шаблоне нет секции сценария'");
	КонецЕсли;

	Результат = "";
	Индекс = 0;
	Пока Индекс < ИндексСценария Цикл
		Строка = СокрЛП(СтрокиШаблона[Индекс]);
		Если Не (СтрНачинаетсяС(Строка, "#") И СтрНайти(Строка, "{{") > 0) Тогда
			Результат = Результат + СтрокиШаблона[Индекс] + Символы.ПС;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	ТелоШаблона = "";
	Пока Индекс < СтрокиШаблона.Количество() Цикл
		Если ТелоШаблона <> "" Тогда
			ТелоШаблона = ТелоШаблона + Символы.ПС;
		КонецЕсли;
		ТелоШаблона = ТелоШаблона + СтрокиШаблона[Индекс];
		Индекс = Индекс + 1;
	КонецЦикла;
	Для Каждого Документ Из Документы Цикл
		Результат = Результат + ТекстСценарияПоДокументу(ТелоШаблона, Документ, ИмяПользователя, Предупреждения);
	КонецЦикла;
	// Файл заканчивается ровно одним переводом строки (как эталоны VA).
	Пока Результат <> "" И Прав(Результат, 1) = Символы.ПС Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Результат = Результат + Символы.ПС;
	Возврат Результат;
КонецФункции

// Собирает текст одного блока сценария по данным одного документа.
Функция ТекстСценарияПоДокументу(ТелоШаблона, Документ, ИмяПользователя, Предупреждения)

	Подстановки = ПодстановкиСценария(Документ, ИмяПользователя);
	СтрокиТела = СтрРазделить(ТелоШаблона, Символы.ПС, Истина);

	Результат = "";
	Индекс = 0;
	Пока Индекс < СтрокиТела.Количество() Цикл
		Строка = СокрЛП(СтрокиТела[Индекс]);
		Если СтрНачинаетсяС(Строка, "#{{rows:") Тогда
			ПозицияКонца = СтрНайти(Строка, "}}");
			ИмяТаблицы = СокрЛП(Сред(Строка, 9, ПозицияКонца - 9));
			Индекс = Индекс + 1;
			СтрокиБлока = Новый Массив;
			Пока Индекс < СтрокиТела.Количество()
				И СокрЛП(СтрокиТела[Индекс]) <> "#{{end}}" Цикл
				СтрокиБлока.Добавить(СтрокиТела[Индекс]);
				Индекс = Индекс + 1;
			КонецЦикла;
			Если Индекс >= СтрокиТела.Количество() Тогда
				ВызватьИсключение НСтр("ru = 'В шаблоне нет конца блока строк: '") + ИмяТаблицы;
			КонецЕсли;
			Результат = Результат + ТекстСтрокТаблицы(СтрокиБлока, Документ, ИмяТаблицы, Подстановки, Предупреждения);
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Результат = Результат + ЗаменитьПлейсхолдеры(СтрокиТела[Индекс], Подстановки, Предупреждения) + Символы.ПС;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Подстановки для блока сценария: глобальные (user, date), документа
// (doc.*, header.*, флаг.*). Без документа (смоук) - только глобальные.
Функция ПодстановкиСценария(Документ, ИмяПользователя)

	Подстановки = Новый Соответствие;
	Подстановки.Вставить("user", ИмяПользователя);
	Подстановки.Вставить("date", ДатаСценария(Документ));
	Если Документ = Неопределено Тогда
		Возврат Подстановки;
	КонецЕсли;

	ТипДокумента = СокрЛП(ЗначениеСвойства(Документ, "type", ""));
	Подстановки.Вставить("doc.type",      ТипДокумента);
	Подстановки.Вставить("doc.number",    СокрЛП(ЗначениеСвойства(Документ, "number", "")));
	Подстановки.Вставить("doc.formTitle", ЗаголовокФормыДокумента(ТипДокумента));

	Данные = ЗначениеСвойства(Документ, "data", Новый Структура);
	Шапка = ЗначениеСвойства(Данные, "header", Новый Структура);
	Если ТипЗнч(Шапка) = Тип("Структура") Тогда
		Для Каждого Поле Из Шапка Цикл
			Подстановки.Вставить("header." + Поле.Ключ, СтрокаЗначенияФикстуры(Поле.Значение));
			Если ТипЗнч(Поле.Значение) = Тип("Булево") Тогда
				Подстановки.Вставить("флаг." + Поле.Ключ, ?(Поле.Значение, "устанавливаю", "снимаю"));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Подстановки;
КонецФункции

// Дата сценария: ВСЕГДА текущая дата сеанса (решение пользователя
// 2026-10-14: сценарий вводится текущей датой; вариант «дата
// представителя» отменен). Объекты затрат текущего периода
// обеспечивает подготовка данных (см. ДобавитьОбъектЗатратТекущегоПериода).
Функция ДатаСценария(Документ)

	Возврат Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
КонецФункции

// Период-валидация объектов затрат: собирает по строкам ТЧ документа
// ссылки СтруктураПредприятия (АналитикаРасходов и аналоги) и проверяет
// их период действия на дату документа. Не действует - пробел (gap)
// с периодом действия объекта (T8).
Функция ПробелыПериодовОбъектовЗатрат(ОбъектДок, ОпределениеТипа)

	Пробелы = Новый Массив;
	СписокПолей = ЗначениеСвойства(ОпределениеТипа, "fieldList", Новый Структура);
	ТЧКарта = ЗначениеСвойства(СписокПолей, "tabular", Неопределено);
	Если ТипЗнч(ТЧКарта) <> Тип("Структура") Тогда
		Возврат Пробелы;
	КонецЕсли;

	Объекты = Новый Массив;
	Для Каждого КлючЗначение Из ТЧКарта Цикл
		МетаТЧ = ОбъектДок.Метаданные().ТабличныеЧасти.Найти(КлючЗначение.Ключ);
		Если МетаТЧ = Неопределено Или МетаТЧ.Реквизиты.Найти("АналитикаРасходов") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаТЧ Из ОбъектДок[КлючЗначение.Ключ] Цикл
			Значение = СтрокаТЧ.АналитикаРасходов;
			Если ТипЗнч(Значение) = Тип("СправочникСсылка.СтруктураПредприятия")
				И ЗначениеЗаполнено(Значение)
				И Не СписокСодержит(Объекты, Значение) Тогда
				Объекты.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Объекты.Количество() = 0 Тогда
		Возврат Пробелы;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	АпкИстория.ОбъектЗатрат КАК ОбъектЗатрат,
	|	АпкИстория.НачалоПериодаАктуальности КАК Начало,
	|	АпкИстория.КонецПериодаАктуальности КАК Конец
	|ИЗ РегистрСведений.АпкИсторияПолей_ДанныеДляПодбора КАК АпкИстория
	|ГДЕ АпкИстория.ОбъектЗатрат В (&Объекты)";
	Запрос.УстановитьПараметр("Объекты", Объекты);
	Действует = Новый Соответствие;
	Периоды = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектЗатрат = Выборка.ОбъектЗатрат;
		ДействуетОбъекта = Действует.Получить(ОбъектЗатрат);
		Если ДействуетОбъекта <> Истина Тогда
			ДействуетОбъекта = (Выборка.Начало <= ОбъектДок.Дата И Выборка.Конец > ОбъектДок.Дата);
		КонецЕсли;
		Действует.Вставить(ОбъектЗатрат, ДействуетОбъекта);
		Периоды.Вставить(ОбъектЗатрат, Строка(Выборка.Начало) + " - " + Строка(Выборка.Конец));
	КонецЦикла;
	Для Каждого ОбъектЗатрат Из Объекты Цикл
		ДействуетОбъекта = Действует.Получить(ОбъектЗатрат);
		Если ДействуетОбъекта = Истина Тогда
			Продолжить;
		КонецЕсли;
		ПериодОбъекта = Периоды.Получить(ОбъектЗатрат);
		Если ПериодОбъекта = Неопределено Тогда
			ПериодОбъекта = "?";
		КонецЕсли;
		ЗаписьПробела = Новый Структура;
		ЗаписьПробела.Вставить("docType", ОбъектДок.Метаданные().Имя);
		ЗаписьПробела.Вставить("axis",    "ПериодДействияОбъектаЗатрат");
		ЗаписьПробела.Вставить("value",   Строка(ОбъектЗатрат)
			+ " (действует " + ПериодОбъекта + ")");
		Пробелы.Добавить(ЗаписьПробела);
	КонецЦикла;
	Возврат Пробелы;
КонецФункции

// Повторяет блок строк на каждую строку ТЧ документа с подстановкой row.*.
Функция ТекстСтрокТаблицы(СтрокиБлока, Документ, ИмяТаблицы, Подстановки, Предупреждения)

	СтрокиТаблицы = Новый Массив;
	Если Документ <> Неопределено Тогда
		Данные = ЗначениеСвойства(Документ, "data", Новый Структура);
		ТабулярныеДанные = ЗначениеСвойства(Данные, "tabular", Новый Структура);
		СтрокиТаблицы = ЗначениеСвойства(ТабулярныеДанные, ИмяТаблицы, Новый Массив);
		Если ТипЗнч(СтрокиТаблицы) <> Тип("Массив") Тогда
			СтрокиТаблицы = Новый Массив;
		КонецЕсли;
	КонецЕсли;

	Результат = "";
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		Если ТипЗнч(СтрокаТаблицы) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		ПодстановкиРяда = КопияПодстановок(Подстановки);
		Для Каждого Поле Из СтрокаТаблицы Цикл
			ПодстановкиРяда.Вставить("row." + Поле.Ключ, СтрокаЗначенияФикстуры(Поле.Значение));
		КонецЦикла;
		Для Каждого СтрокаБлока Из СтрокиБлока Цикл
			Результат = Результат + ЗаменитьПлейсхолдеры(СтрокаБлока, ПодстановкиРяда, Предупреждения) + Символы.ПС;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Копия структуры подстановок (для row.* поверх doc.* подстановок).
Функция КопияПодстановок(Подстановки)

	Копия = Новый Соответствие;
	Для Каждого КлючЗначение Из Подстановки Цикл
		Копия.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Заменяет плейсхолдеры "{{имя}}" по структуре подстановок; неизвестный
// плейсхолдер остается в тексте и фиксируется предупреждением.
Функция ЗаменитьПлейсхолдеры(Текст, Подстановки, Предупреждения)

	Результат = "";
	Осталось = Текст;
	Пока Истина Цикл
		Начало = СтрНайти(Осталось, "{{");
		Если Начало = 0 Тогда
			Возврат Результат + Осталось;
		КонецЕсли;
		Конец = СтрНайти(Осталось, "}}");
		Если Конец = 0 Или Конец < Начало Тогда
			Возврат Результат + Осталось;
		КонецЕсли;
		Результат = Результат + Лев(Осталось, Начало - 1);
		ИмяПлейсхолдера = СокрЛП(Сред(Осталось, Начало + 2, Конец - Начало - 2));
		Значение = Подстановки.Получить(ИмяПлейсхолдера);
		Если Значение <> Неопределено Тогда
			Результат = Результат + Значение;
		Иначе
			Результат = Результат + "{{" + ИмяПлейсхолдера + "}}";
			Предупреждения.Добавить("Неизвестный плейсхолдер {{" + ИмяПлейсхолдера + "}}");
		КонецЕсли;
		Осталось = Сред(Осталось, Конец + 2);
	КонецЦикла;
КонецФункции

// Текстовое представление значения фикстуры: ссылка - presentation,
// число - без разбиения разрядов с запятой, булево - истина/ложь.
Функция СтрокаЗначенияФикстуры(Значение)

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Возврат СокрЛП(ЗначениеСвойства(Значение, "presentation", ""));
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если Значение = 0 Тогда
			Возврат "0";
		КонецЕсли;
		Возврат Формат(Значение, "ЧГ=0; ЧРД=,");
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "истина", "ложь");
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Латинское имя файла из имени пользователя ИБ (D-002, латиница).
Функция ИмяФайлаЛатиницей(Значение)

	Транслит = ТаблицаТранслита();
	Результат = "";
	Для Номер = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Номер, 1);
		Латиница = Транслит[НРег(Символ)];
		Если Латиница = Неопределено Тогда
			Результат = Результат + ?(ЭтоЛатиницаИлиЦифра(Символ), Символ, "-");
		Иначе
			Результат = Результат + ?(Символ = ВРег(Символ) И Символ <> НРег(Символ), ВРег(Латиница), Латиница);
		КонецЕсли;
	КонецЦикла;
	Пока СтрНайти(Результат, "--") > 0 Цикл
		Результат = СтрЗаменить(Результат, "--", "-");
	КонецЦикла;
	Результат = СокрЛП(Результат);
	Если СтрНачинаетсяС(Результат, "-") Тогда
		Результат = Сред(Результат, 2);
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(Результат, "-") И СтрДлина(Результат) > 0 Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	Возврат ?(ПустаяСтрока(Результат), "user", Результат);
КонецФункции

// Проверяет, что символ - латинская буква или цифра.
Функция ЭтоЛатиницаИлиЦифра(Символ)

	Код = КодСимвола(Символ);
	Если Код >= 48 И Код <= 57 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Код >= 65 И Код <= 90 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Код >= 97 И Код <= 122 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Соответствие строчных букв кириллицы в латиницу (транслит).
Функция ТаблицаТранслита()

	Транслит = Новый Соответствие;
	Транслит.Вставить("а", "a");
	Транслит.Вставить("б", "b");
	Транслит.Вставить("в", "v");
	Транслит.Вставить("г", "g");
	Транслит.Вставить("д", "d");
	Транслит.Вставить("е", "e");
	Транслит.Вставить("ё", "e");
	Транслит.Вставить("ж", "zh");
	Транслит.Вставить("з", "z");
	Транслит.Вставить("и", "i");
	Транслит.Вставить("й", "j");
	Транслит.Вставить("к", "k");
	Транслит.Вставить("л", "l");
	Транслит.Вставить("м", "m");
	Транслит.Вставить("н", "n");
	Транслит.Вставить("о", "o");
	Транслит.Вставить("п", "p");
	Транслит.Вставить("р", "r");
	Транслит.Вставить("с", "s");
	Транслит.Вставить("т", "t");
	Транслит.Вставить("у", "u");
	Транслит.Вставить("ф", "f");
	Транслит.Вставить("х", "kh");
	Транслит.Вставить("ц", "c");
	Транслит.Вставить("ч", "ch");
	Транслит.Вставить("ш", "sh");
	Транслит.Вставить("щ", "sch");
	Транслит.Вставить("ъ", "");
	Транслит.Вставить("ы", "y");
	Транслит.Вставить("ь", "");
	Транслит.Вставить("э", "e");
	Транслит.Вставить("ю", "ju");
	Транслит.Вставить("я", "ja");
	Возврат Транслит;
КонецФункции

// Читает текстовый файл (UTF-8) с нормализацией переводов строк в ПС.
Функция ПрочитатьТекстФайла(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
КонецФункции

// Записывает текстовый файл UTF-8 без BOM с переводами строк ПС (как эталоны VA).
// ЗаписьТекста непригоден: всегда пишет BOM и ВК+ПС (проверено пробой на платформе 8.5.4).
// Поэтому строка кодируется в байты (без BOM) и пишется бинарной ЗаписьюДанных.
Процедура ЗаписатьТекстФайла(Путь, Текст)

	ФайлВыгружаемый = Новый Файл(Путь);
	Если ФайлВыгружаемый.Существует() Тогда
		УдалитьФайлы(Путь);
	КонецЕсли;
	Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, КодировкаТекста.UTF8);
	Запись = Новый ЗаписьДанных(Путь);
	Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
	Запись.Закрыть();
КонецПроцедуры

// --- Служебные функции менеджера паролей и раннера VA (T6) ---

// Пользователь ИБ по имени: основной API + страховочный обход списка
// (объект из списка может быть неизменяемым - берём записываемый по UUID).
Функция НайтиПользователяИБПоИмени(ИмяПользователя)

	Пользователь = Неопределено;
	Попытка
		Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Исключение
		// метод может отсутствовать в сборке платформы - обход ниже
		Пользователь = Неопределено;
	КонецПопытки;
	Если Пользователь <> Неопределено Тогда
		Возврат Пользователь;
	КонецЕсли;

	Для Каждого Элемент Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если Элемент.Имя = ИмяПользователя Тогда
			Возврат ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(
				Элемент.УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Группирует файлы манифеста по пользователям с сохранением порядка
// манифеста (детерминированные номера батчей/портов).
Функция ГруппыФайловМанифеста(Манифест)

	Группы = Новый Массив;
	ПоПользователям = Новый Соответствие;
	Файлы = ЗначениеСвойства(Манифест, "files", Новый Массив);
	Для Каждого Запись Из Файлы Цикл
		Пользователь = СокрЛП(ЗначениеСвойства(Запись, "user", ""));
		ФайлФичи = СокрЛП(ЗначениеСвойства(Запись, "file", ""));
		Если ПустаяСтрока(Пользователь) Или ПустаяСтрока(ФайлФичи) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ФайлСуществуетФ(ФайлФичи) Тогда
			Продолжить;
		КонецЕсли;
		Группа = ПоПользователям.Получить(Пользователь);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура;
			Группа.Вставить("Пользователь", Пользователь);
			Группа.Вставить("Файлы", Новый Массив);
			// s004 (FR-004): негативная запись манифеста помечает весь батч
			Группа.Вставить("Негативный", Ложь);
			ПоПользователям.Вставить(Пользователь, Группа);
			Группы.Добавить(Группа);
		КонецЕсли;
		Группа.Файлы.Добавить(ФайлФичи);
		Группа.Негативный = Группа.Негативный
			Или ЗначениеСвойства(Запись, "negative", Ложь) = Истина;
	КонецЦикла;
	Возврат Группы;

КонецФункции

// "/S"-строка базы из строки подключения настроек:
// Srvr="host";Ref="name" -> host\name.
Функция БазаИзСтрокиПодключения(СтрокаПодключения)

	Сервер = ЗначениеИзСтрокиПодключения(СтрокаПодключения, "Srvr");
	ИмяБазы = ЗначениеИзСтрокиПодключения(СтрокаПодключения, "Ref");
	Если ПустаяСтрока(Сервер) Или ПустаяСтрока(ИмяБазы) Тогда
		ВызватьИсключение
			НСтр("ru = 'Не удалось разобрать строку подключения ИБ (infoBase): '")
			+ СтрокаПодключения;
	КонецЕсли;
	Возврат Сервер + "\" + ИмяБазы;

КонецФункции

// Значение параметра строки подключения (Srvr=...;Ref=...).
Функция ЗначениеИзСтрокиПодключения(СтрокаПодключения, Ключ)

	Поз = СтрНайти(СтрокаПодключения, Ключ + "=");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Значение = Сред(СтрокаПодключения, Поз + СтрДлина(Ключ) + 1);
	ПозТочки = СтрНайти(Значение, ";");
	Если ПозТочки > 0 Тогда
		Значение = Лев(Значение, ПозТочки - 1);
	КонецЕсли;
	Значение = СтрЗаменить(СокрЛП(Значение), """", "");
	Возврат Значение;

КонецФункции

// Каталоги артефактов батчей (params/logs/allure).
Процедура СоздатьКаталогиБатчей(КаталогПараметров, КаталогЛогов, КаталогAllure)

	Если Не КаталогСуществуетФ(КаталогПараметров) Тогда
		СоздатьКаталог(КаталогПараметров);
	КонецЕсли;
	Если Не КаталогСуществуетФ(КаталогЛогов) Тогда
		СоздатьКаталог(КаталогЛогов);
	КонецЕсли;
	Если Не КаталогСуществуетФ(КаталогAllure) Тогда
		СоздатьКаталог(КаталогAllure);
	КонецЕсли;

КонецПроцедуры

// Значение в двойных кавычках (для командных строк/строк подключения).
Функция Кавычки(Значение)

	Возврат """" + Строка(Значение) + """";

КонецФункции

// Имя файла (последний сегмент) нормализованного пути.
Функция ИмяФайлаПоПути(Путь)

	Поз = 0;
	Для Ном = 1 По СтрДлина(Путь) Цикл
		Если Сред(Путь, Ном, 1) = "/" Тогда
			Поз = Ном;
		КонецЕсли;
	КонецЦикла;
	Если Поз = 0 Тогда
		Возврат Путь;
	КонецЕсли;
	Возврат Сред(Путь, Поз + 1);

КонецФункции

// Каталог файла (без имени) нормализованного пути.
Функция КаталогФайла(Путь)

	Поз = 0;
	Для Ном = 1 По СтрДлина(Путь) Цикл
		Если Сред(Путь, Ном, 1) = "/" Тогда
			Поз = Ном;
		КонецЕсли;
	КонецЦикла;
	Если Поз = 0 Тогда
		Возврат Путь;
	КонецЕсли;
	Возврат Лев(Путь, Поз - 1);

КонецФункции

// Каталог поиска версий платформы для VA (три уровня вверх от файла):
// C:/Program Files/1cv8/8.5.4.1683/bin/1cv8c.exe -> C:/Program Files/1cv8
Функция КаталогПоискаВерсий(Путь1cv8c)

	Каталог = КаталогФайла(Путь1cv8c);
	Каталог = КаталогФайла(Каталог);
	Возврат КаталогФайла(Каталог);

КонецФункции

// Версия платформы из каталога установки:
// .../8.5.4.1683/bin/1cv8c.exe -> 8.5.4
Функция ВерсияПлатформыИзПути(Путь1cv8c)

	ВерсияКаталог = ИмяФайлаПоПути(КаталогФайла(КаталогФайла(Путь1cv8c)));
	Части = СтрРазделить(ВерсияКаталог, ".");
	Если Части.Количество() >= 3 Тогда
		Возврат Части[0] + "." + Части[1] + "." + Части[2];
	КонецЕсли;
	Возврат "8.5.4";

КонецФункции

// --- Служебные функции репортёра (T7, design §4.8) ---

// Секция покрытия отчёта: fixtures.json (полный) -> scan.json ->
// пустая. Возвращает структуру: ПутьФикстур, Секция (representatives,
// gaps, users), ПланАРМов (armPlan из fixtures). Раннер T6 fixtures
// не пишет - толерантность обязательна.
Функция ПокрытиеОтчета(КаталогПрогона)

	Секция = Новый Структура;
	Секция.Вставить("representatives", Новый Массив);
	Секция.Вставить("gaps",             Новый Массив);
	Секция.Вставить("users",            Новый Массив);

	Результат = Новый Структура;
	Результат.Вставить("ПутьФикстур", "");
	Результат.Вставить("ПланАРМов",   Новый Массив);
	Результат.Вставить("Секция",      Секция);

	ПутьФикстур = КаталогПрогона + "/" + "fixtures.json";
	Если ФайлСуществуетФ(ПутьФикстур) Тогда
		Фикстуры = ПрочитатьJSONФайл(ПутьФикстур);
		Результат.ПутьФикстур = ПутьФикстур;
		Секция.users = МассивПоСвойству(Фикстуры, "users");
		Секция.representatives = ПредставителиДокументовФикстур(
			ЗначениеСвойства(Фикстуры, "documents", Неопределено));
		Секция.gaps = МассивПоСвойству(Фикстуры, "coverageGaps");
		Результат.ПланАРМов = МассивПоСвойству(Фикстуры, "armPlan");
		Возврат Результат;
	КонецЕсли;

	ПутьСкан = КаталогПрогона + "/" + "scan.json";
	Если ФайлСуществуетФ(ПутьСкан) Тогда
		Скан = ПрочитатьJSONФайл(ПутьСкан);
		Секция.representatives = МассивПоСвойству(Скан, "representatives");
		Секция.gaps = МассивПоСвойству(Скан, "gaps");
		Секция.users = МассивПоСвойству(Скан, "users");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Массив из свойства структуры; не-массив или отсутствие -> пустой массив.
Функция МассивПоСвойству(Данные, ИмяСвойства)

	Если Данные = Неопределено Или Данные = Null Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Значение = Неопределено;
	Если Данные.Свойство(ИмяСвойства, Значение) И ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Новый Массив;
КонецФункции

// Представители из fixtures.documents без тяжёлых данных документов:
// тип, номер, ссылка, автор и оси покрытия (axis -> булево).
Функция ПредставителиДокументовФикстур(Документы)

	Представители = Новый Массив;
	Если ТипЗнч(Документы) <> Тип("Массив") Тогда
		Возврат Представители;
	КонецЕсли;
	Для Каждого Документ Из Документы Цикл
		Если ТипЗнч(Документ) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Оси = ЗначениеСвойства(Документ, "coverage", Новый Структура);
		Если ТипЗнч(Оси) <> Тип("Структура") Тогда
			Оси = Новый Структура;
		КонецЕсли;
		Представитель = Новый Структура;
		Представитель.Вставить("docType", СокрЛП(ЗначениеСвойства(Документ, "type", "")));
		Представитель.Вставить("number",  СокрЛП(ЗначениеСвойства(Документ, "number", "")));
		Представитель.Вставить("ref",     СокрЛП(ЗначениеСвойства(Документ, "ref", "")));
		Представитель.Вставить("author",  СокрЛП(ЗначениеСвойства(Документ, "author", "")));
		Представитель.Вставить("axes",    Оси);
		Представители.Добавить(Представитель);
	КонецЦикла;
	Возврат Представители;
КонецФункции

// Результаты сценариев батча из allure/<ИмяСборки>/*-result.json.
// Возвращает массив структур result (name, status, start, stop, labels).
Функция РезультатыСценариевБатча(КаталогAllure, ИмяСборки)

	Результаты = Новый Массив;
	Если ПустаяСтрока(ИмяСборки) Тогда
		Возврат Результаты;
	КонецЕсли;
	КаталогБатча = КаталогAllure + "/" + ИмяСборки;
	Если Не КаталогСуществуетФ(КаталогБатча) Тогда
		Возврат Результаты;
	КонецЕсли;
	НайденныеФайлы = НайтиФайлы(КаталогБатча, "*-result.json", Ложь);
	Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
		Результат = Неопределено;
		Попытка
			Результат = ПрочитатьJSONФайл(НайденныйФайл.ПолноеИмя);
		Исключение
			// битый/недописанный allure-файл пропускаем
			Продолжить;
		КонецПопытки;
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			Результаты.Добавить(Результат);
		КонецЕсли;
	КонецЦикла;
	Возврат Результаты;
КонецФункции

// Увеличивает счётчик статуса; нестандартный статус уходит в unknown.
Процедура УвеличитьСчетчик(Счетчики, Статус)

	Значение = 0;
	Если Счетчики.Свойство(Статус, Значение) Тогда
		Счетчики.Вставить(Статус, Значение + 1);
	Иначе
		Счетчики.Вставить("unknown", Счетчики.unknown + 1);
	КонецЕсли;
КонецПроцедуры

// Строка батча в сводке: batches.json + scenarioCount (батчи как есть,
// флаги паролей булевы; хэши в отчёт не попадают - NFR-001).
Функция СтрокаБатчаОтчета(Батч, Пользователь, СтатусБатча, КодСтатуса, КоличествоСценариев)

	Строка = Новый Структура;
	Строка.Вставить("user",             Пользователь);
	Строка.Вставить("batch",            ЗначениеСвойства(Батч, "batch", 0));
	Строка.Вставить("status",           СтатусБатча);
	Строка.Вставить("returnStatus",     КодСтатуса);
	Строка.Вставить("verdict",          СокрЛП(ЗначениеСвойства(Батч, "verdict", "")));
	Строка.Вставить("durationSec",      ЗначениеСвойства(Батч, "durationSec", 0));
	// s004: факты подмены/восстановления и негатив-флаг (из манифеста)
	Строка.Вставить("pwdSubstituted",    ЗначениеСвойства(Батч, "pwdSubstituted", Ложь));
	Строка.Вставить("negative",          ЗначениеСвойства(Батч, "negative", Ложь));
	Строка.Вставить("passwordRestored", ЗначениеСвойства(Батч, "passwordRestored", Ложь));
	Строка.Вставить("zodRestored",      ЗначениеСвойства(Батч, "zodRestored", Ложь));
	Строка.Вставить("killConfirmed",    ЗначениеСвойства(Батч, "killConfirmed", Неопределено));
	Строка.Вставить("error",            СокрЛП(ЗначениеСвойства(Батч, "error", "")));
	Строка.Вставить("scenarioCount",    КоличествоСценариев);
	Возврат Строка;
КонецФункции

// Парольная секция отчёта: только булевы флаги batches.json, агрегат
// по пользователю (все батчи пользователя восстановлены -> restored).
Функция ПарольнаяСекцияОтчета(Батчи)

	ДеталиПоПользователям = Новый Соответствие;
	Для Каждого Батч Из Батчи Цикл
		Пользователь = СокрЛП(ЗначениеСвойства(Батч, "user", ""));
		Если ПустаяСтрока(Пользователь) Тогда
			Продолжить;
		КонецЕсли;
		Восстановлен = ЗначениеСвойства(Батч, "passwordRestored", Ложь) = Истина;
		ЗОДВосстановлен = ЗначениеСвойства(Батч, "zodRestored", Ложь) = Истина;
		Подменён = ЗначениеСвойства(Батч, "pwdSubstituted", Ложь) = Истина;
		Деталь = ДеталиПоПользователям.Получить(Пользователь);
		Если Деталь = Неопределено Тогда
			Деталь = Новый Структура("restored,zodRestored,substituted", Истина, Истина, Ложь);
			ДеталиПоПользователям.Вставить(Пользователь, Деталь);
		КонецЕсли;
		Деталь.restored = Деталь.restored И Восстановлен;
		Деталь.zodRestored = Деталь.zodRestored И ЗОДВосстановлен;
		Деталь.substituted = Деталь.substituted Или Подменён;
	КонецЦикла;

	Детали = Новый Массив;
	Несоответствия = Новый Массив;
	ПодменённыеКоличество = 0;
	Для Каждого КлючЗначение Из ДеталиПоПользователям Цикл
		ДетальОтчета = Новый Структура;
		ДетальОтчета.Вставить("user",        КлючЗначение.Ключ);
		ДетальОтчета.Вставить("substituted",  КлючЗначение.Значение.substituted);
		ДетальОтчета.Вставить("restored",    КлючЗначение.Значение.restored);
		ДетальОтчета.Вставить("zodRestored", КлючЗначение.Значение.zodRestored);
		Детали.Добавить(ДетальОтчета);
		Если КлючЗначение.Значение.substituted Тогда
			ПодменённыеКоличество = ПодменённыеКоличество + 1;
		КонецЕсли;
		Если Не КлючЗначение.Значение.restored Или Не КлючЗначение.Значение.zodRestored Тогда
			Несоответствия.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Секция = Новый Структура;
	Секция.Вставить("restoredCount", Детали.Количество() - Несоответствия.Количество());
	Секция.Вставить("substitutedCount", ПодменённыеКоличество);
	Секция.Вставить("mismatch",      Несоответствия);
	Секция.Вставить("details",       Детали);
	Возврат Секция;
КонецФункции

// АРМы плана (fixtures.armPlan) со статусами батчей этих пользователей.
Функция АРМыОтчета(Покрытие, Батчи)

	СтатусыПользователей = Новый Соответствие;
	Для Каждого Батч Из Батчи Цикл
		Пользователь = СокрЛП(ЗначениеСвойства(Батч, "user", ""));
		Если ПустаяСтрока(Пользователь) Тогда
			Продолжить;
		КонецЕсли;
		СтатусыПользователей.Вставить(Пользователь, Новый Структура(
			"batchStatus,returnStatus",
			СокрЛП(ЗначениеСвойства(Батч, "status", "")),
			СокрЛП(ЗначениеСвойства(Батч, "returnStatus", ""))));
	КонецЦикла;

	АРМы = Новый Массив;
	Для Каждого ПланАРМа Из Покрытие.ПланАРМов Цикл
		Если ТипЗнч(ПланАРМа) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Пользователь = СокрЛП(ЗначениеСвойства(ПланАРМа, "user", ""));
		СтатусБатча = "";
		КодВозврата = "";
		Статус = СтатусыПользователей.Получить(Пользователь);
		Если Статус <> Неопределено Тогда
			СтатусБатча = Статус.batchStatus;
			КодВозврата = Статус.returnStatus;
		КонецЕсли;
		Строка = Новый Структура;
		Строка.Вставить("user",         Пользователь);
		Строка.Вставить("arm",          СокрЛП(ЗначениеСвойства(ПланАРМа, "arm", "")));
		Строка.Вставить("docTypes",     МассивПоСвойству(ПланАРМа, "docTypes"));
		Строка.Вставить("templates",    МассивПоСвойству(ПланАРМа, "templates"));
		Строка.Вставить("reason",       СокрЛП(ЗначениеСвойства(ПланАРМа, "reason", "")));
		Строка.Вставить("batchStatus",  СтатусБатча);
		Строка.Вставить("returnStatus", КодВозврата);
		АРМы.Добавить(Строка);
	КонецЦикла;
	Возврат АРМы;
КонецФункции

// JSON-текст структуры (ЗаписьJSON в строку, CRLF -> ПС: 8.5.4 пишет
// ВК+ПС). Файл затем пишет ЗаписатьТекстФайла (noBOM/LF - грабля
// BOM/CRLF платформы 8.5.4).
Функция ТекстJSONСтрокой(Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(Запись, Данные);
	Исключение
		Запись.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Текст = Запись.Закрыть();
	Возврат СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
КонецФункции

// Человекочитаемый summary.md (design §4.8): итоги, батчи, сценарии,
// АРМы, покрытие, пароли, артефакты.
Функция ТекстMarkdownОтчета(Итог)

	Итоги = Итог.totals;
	Текст = "# Сводка прогона " + СтрокаТаблицыMD(Итог.runId) + Символы.ПС;
	Текст = Текст + Символы.ПС;
	Текст = Текст + "- Сгенерирован: " + СтрокаТаблицыMD(Итог.generatedAt) + Символы.ПС;
	Текст = Текст + "- Каталог: `" + СтрокаТаблицыMD(Итог.runDir) + "`" + Символы.ПС;
	Текст = Текст + Символы.ПС + "## Итоги" + Символы.ПС + Символы.ПС;
	Текст = Текст + "| Батчей | Сценариев | passed | failed | broken | timeout | unknown | neg-passed | neg-failed |"
		+ Символы.ПС + "|---|---|---|---|---|---|---|---|---|" + Символы.ПС;
	Текст = Текст + "| " + Итоги.batches + " | " + Итоги.scenarios + " | " + Итоги.passed
		+ " | " + Итоги.failed + " | " + Итоги.broken + " | " + Итоги.timeout
		+ " | " + Итоги.unknown
		+ " | " + Итоги.negativePassed + " | " + Итоги.negativeFailed + " |" + Символы.ПС;

	Текст = Текст + Символы.ПС + "## Батчи" + Символы.ПС + Символы.ПС;
	Текст = Текст + "| Пользователь | № | Статус | ReturnStatus | Вердикт | Длит., с | Подменён | Пароль | ЗОД | Neg |"
		+ Символы.ПС + "|---|---|---|---|---|---|---|---|---|---|" + Символы.ПС;
	Для Каждого Батч Из Итог.batches Цикл
		Текст = Текст + "| " + СтрокаТаблицыMD(Батч.user) + " | " + Батч.batch
			+ " | " + СтрокаТаблицыMD(Батч.status) + " | " + СтрокаТаблицыMD(Батч.returnStatus)
			+ " | " + СтрокаТаблицыMD(Батч.verdict) + " | " + Батч.durationSec
			+ " | " + СтрокаБулеваМД(ЗначениеСвойства(Батч, "pwdSubstituted", Ложь))
			+ " | " + СтрокаБулеваМД(Батч.passwordRestored) + " | "
			+ СтрокаБулеваМД(Батч.zodRestored) + " | "
			+ СтрокаБулеваМД(ЗначениеСвойства(Батч, "negative", Ложь)) + " |" + Символы.ПС;
	КонецЦикла;

	Текст = Текст + Символы.ПС + "## Сценарии (сценарий × пользователь × статус)"
		+ Символы.ПС + Символы.ПС;
	Текст = Текст + "| Сценарий | Пользователь | Тип | Статус | Длит., мс | Статус батча | Причина |"
		+ Символы.ПС + "|---|---|---|---|---|---|---|" + Символы.ПС;
	Для Каждого Сценарий Из Итог.scenarios Цикл
		Текст = Текст + "| " + СтрокаТаблицыMD(Сценарий.scenario) + " | "
			+ СтрокаТаблицыMD(Сценарий.user) + " | "
			+ ?(ЗначениеСвойства(Сценарий, "negative", Ложь), "neg", "pos") + " | "
			+ СтрокаТаблицыMD(Сценарий.status)
			+ " | " + Сценарий.durationMs + " | " + СтрокаТаблицыMD(Сценарий.batchStatus)
			+ " | " + СтрокаТаблицыMD(ЗначениеСвойства(Сценарий, "negReason", ""))
			+ " |" + Символы.ПС;
	КонецЦикла;

	Если Итог.arms.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "## АРМы плана" + Символы.ПС + Символы.ПС;
		Текст = Текст + "| Пользователь | АРМ | Типы документов | Шаблоны | Статус батча |"
			+ Символы.ПС + "|---|---|---|---|---|" + Символы.ПС;
		Для Каждого АРМ Из Итог.arms Цикл
			Текст = Текст + "| " + СтрокаТаблицыMD(АРМ.user) + " | " + СтрокаТаблицыMD(АРМ.arm)
				+ " | " + СтрокаМассиваMD(АРМ.docTypes) + " | " + СтрокаМассиваMD(АРМ.templates)
				+ " | " + СтрокаТаблицыMD(АРМ.batchStatus) + " |" + Символы.ПС;
		КонецЦикла;
	КонецЕсли;

	Покрытие = Итог.coverage;
	Текст = Текст + Символы.ПС + "## Покрытие" + Символы.ПС + Символы.ПС;
	Текст = Текст + "- Представители: " + Покрытие.representatives.Количество() + Символы.ПС;
	Текст = Текст + "- Пробелы покрытия (gaps): " + Покрытие.gaps.Количество() + Символы.ПС;
	Текст = Текст + "- Пользователи: " + Покрытие.users.Количество() + Символы.ПС;
	Если Покрытие.gaps.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "### Пробелы покрытия" + Символы.ПС + Символы.ПС;
		Текст = Текст + "| Тип документа | Ось | Значение |" + Символы.ПС + "|---|---|---|" + Символы.ПС;
		Для Каждого Пробел Из Покрытие.gaps Цикл
			Текст = Текст + "| " + СтрокаТаблицыMD(ЗначениеСвойства(Пробел, "docType", ""))
				+ " | " + СтрокаТаблицыMD(ЗначениеСвойства(Пробел, "axis", ""))
				+ " | " + СтрокаТаблицыMD(ЗначениеСвойства(Пробел, "value", "")) + " |" + Символы.ПС;
		КонецЦикла;
	КонецЕсли;

	Пароли = Итог.passwords;
	Текст = Текст + Символы.ПС + "## Пароли" + Символы.ПС + Символы.ПС;
	Текст = Текст + "- Пользователей с восстановленными паролями: "
		+ Пароли.restoredCount + Символы.ПС;
	Текст = Текст + "- Пользователей с подменёнными паролями: "
		+ Пароли.substitutedCount + Символы.ПС;
	Если Пароли.mismatch.Количество() > 0 Тогда
		Текст = Текст + "- НЕСООТВЕТСТВИЯ: " + СтрокаМассиваMD(Пароли.mismatch) + Символы.ПС;
	Иначе
		Текст = Текст + "- Несоответствий нет" + Символы.ПС;
	КонецЕсли;

	Артефакты = Итог.artifacts;
	Текст = Текст + Символы.ПС + "## Артефакты" + Символы.ПС + Символы.ПС;
	Текст = Текст + "- summary.json: `" + СтрокаТаблицыMD(Артефакты.summaryJson) + "`" + Символы.ПС;
	Текст = Текст + "- summary.md: `" + СтрокаТаблицыMD(Артефакты.summaryMd) + "`" + Символы.ПС;
	Текст = Текст + "- batches.json: `" + СтрокаТаблицыMD(Артефакты.batchesJson) + "`" + Символы.ПС;
	Текст = Текст + "- allure: `" + СтрокаТаблицыMD(Артефакты.allureDir) + "`" + Символы.ПС;
	Возврат Текст;
КонецФункции

// Ячейка markdown-таблицы: без пайпов и переводов строк.
Функция СтрокаТаблицыMD(Значение)

	Результат = СокрЛП(Строка(Значение));
	Результат = СтрЗаменить(Результат, "|", "/");
	Результат = СтрЗаменить(Результат, Символы.ПС, " ");
	Возврат Результат;
КонецФункции

// Булево для markdown-таблицы.
Функция СтрокаБулеваМД(Значение)

	Если Значение = Истина Тогда
		Возврат "да";
	КонецЕсли;
	Возврат "нет";
КонецФункции

// Массив строк через запятую для markdown.
Функция СтрокаМассиваMD(Массив)

	Результат = "";
	Для Каждого Элемент Из Массив Цикл
		Если ПустаяСтрока(Результат) Тогда
			Результат = СтрокаТаблицыMD(Элемент);
		Иначе
			Результат = Результат + ", " + СтрокаТаблицыMD(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
