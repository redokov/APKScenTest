Функционал: T1 диагностика выбора раннера

Контекст:
	Дано Я запускаю сценарий открытия TestClient или подключаю уже существующий

Сценарий: Чтение JSON выбора и флага формы
	Когда я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере
	"""bsl
		Дамп = Новый ТекстовыйДокумент;
		Путь = "C:/MyProjects/APKScenTest/tests/test-selection.json";
		ФайлВыбора = Новый Файл(Путь);
		Стр = "Файл=" + ?(ФайлВыбора.Существует(), "есть", "нет");
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.ОткрытьФайл(Путь);
			Данные = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
			Стр = Стр + " Тип=" + Строка(ТипЗнч(Данные));
			Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
				КонтурыВыбора = Данные.Получить("Контуры");
				Стр = Стр + " Контуры=" + Строка(ТипЗнч(КонтурыВыбора));
				Если ТипЗнч(КонтурыВыбора) = Тип("Соответствие") Тогда
					Стр = Стр + " КРС=" + Строка(КонтурыВыбора.Получить("КРС"));
					Стр = Стр + " Раст=" + Строка(КонтурыВыбора.Получить("Растениеводство"));
				КонецЕсли;
			КонецЕсли;
		Исключение
			Стр = Стр + " ОШИБКА=" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Дамп.УстановитьТекст(Стр);
		Дамп.Записать("C:/MyProjects/APKScenTest/tmp/s010/json_dump.txt", "UTF-8");
	"""
